CMD:myweapons(playerid, params[])
{
    new string[512];
    format(string, sizeof(string),
        "Your Weapons:\n\
        MP5: %d\n\
        SD Pistol: %d\n\
        Bat: %d\n\
        Crack: %d",
        pData[playerid][pMp5],
        pData[playerid][pSDpistol],
        pData[playerid][pBat],
        pData[playerid][pCrack]);

    ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "My Weapons", string, "OK", "");
    return 1;
}

CMD:SpinCar(playerid, params[])
{
    if(pData[playerid][pAdminDuty])
	{
	    return SAM(COLOR_RED, "%s HAD ZBI KIDIR GLITCH B /ADUTY!", GetRPName(playerid));
    }
    if(pData[playerid][pLevel] < 5)
    {
        new msg[128];
        format(msg, sizeof(msg), "You need to be Level 5 to use Spin Wheel. (Your Level: %d)", pData[playerid][pLevel]);
        return SCM(playerid, COLOR_GREY, msg);
    }

    if(pData[playerid][pCarSpinCard] < 1)
    {
        return SCM(playerid, COLOR_GREY, "Ma 3ndkch Spin Card.");
    }

    pData[playerid][pCarSpinCard] -= 1;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET carspincard = %d WHERE uid = %d", pData[playerid][pCarSpinCard], pData[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);
    ShowProgressbar(playerid, "Spinning", 10);
    SetTimerEx("SpinCarTimer", 10000, false, "i", playerid);
    GameTextForPlayer(playerid, "~w~Spinning..", 10000, 3);
    TogglePlayerControllable(playerid, 0);
    ClearAnimations(playerid, 1);
    return 1;
}

CMD:asellhouse(playerid, params[])
{
    new houseid;

    if(pData[playerid][pAdmin] < 35)
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    if(sscanf(params, "i", houseid))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /asellhouse [houseid]");
    }
    if(!(0 <= houseid < MAX_HOUSES) || !HouseInfo[houseid][hExists])
    {
        return SCM(playerid, COLOR_SYNTAX, "Invalid house.");
    }

    SetHouseOwner(houseid, INVALID_PLAYER_ID);
    SM(playerid, COLOR_AQUA, "** You have admin sold house %i.", houseid);
    return 1;
}

CMD:asellgarage(playerid, params[])
{
    new garageid;

    if(pData[playerid][pAdmin] < 34)
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
