CMD:setvipskin(playerid, params[])
{
    if(pData[playerid][pAdmin] < 46)
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");

    new targetid, skinid;
    if(sscanf(params, "ui", targetid, skinid))
        return SCM(playerid, COLOR_SYNTAX, "Usage: /setvipskin [playerid] [skinid]");

    if(!IsPlayerConnected(targetid))
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");

    if(skinid < 0 || skinid > 26)
        return SCM(playerid, COLOR_SYNTAX, "Invalid skin ID (0-26).");

    pData[targetid][pVipskin] = skinid;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "UPDATE users SET VipSkin = %i WHERE uid = %i",
        pData[targetid][pVipskin], pData[targetid][pID]);
    mysql_tquery(connectionID, queryBuffer);


        if(params[0] == 0)
        {
            for(new i = 0; i < 11; i++)
            {
                RemovePlayerAttachedObject(playerid, i);
            }
        }
        else if(params[0] == 1)
        {
            SetPlayerSkin(playerid, 203);
