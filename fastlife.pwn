        }

        pData[targetid][pSilver] = value;
        SM(playerid, COLOR_WHITE, "** You have set %s's silver to %i.", GetRPName(targetid), value);
        format(query, sizeof(query), "```%s has set %s silver to %s.```", GetRPName(playerid), value, GetRPName(targetid));
        DCC_SendChannelMessage(setstat, query);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET silver = %i WHERE uid = %i", pData[playerid][pSilver], pData[playerid][pID]);
