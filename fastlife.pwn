stock GetNearestVehicle(playerid, Float:range)
{
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);

    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(IsValidVehicle(i))
        {
            new Float:vx, Float:vy, Float:vz;
            GetVehiclePos(i, vx, vy, vz);

            if(floatabs(x - vx) <= range && floatabs(y - vy) <= range && floatabs(z - vz) <= range)
            {
                return i;
            }
        }
    }
    return INVALID_VEHICLE_ID;
}

forward KickAFKPlayer(playerid);
public KickAFKPlayer(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    if(pData[playerid][pAFK] && pData[playerid][pAFKTime] >= 600)
    {
        new msg[128];
        format(msg, sizeof(msg), "You were kicked for being AFK for more than 10 minutes!");
        SendClientMessage(playerid, COLOR_RED, msg);

        printf("[AFK] %s (ID: %d) was kicked for being AFK.", GetRPName(playerid), playerid);
        Kick(playerid);
    }
    return 1;
}

