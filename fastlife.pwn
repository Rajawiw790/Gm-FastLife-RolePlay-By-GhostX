                }
                if(pData[playerid][pSteel] < 400)
                {
                    return SCM(playerid, COLOR_SYNTAX, "Ma3andakx 400 Steel Bax Tcrafti.");
                }

                GivePlayerWeaponEx(playerid, 22);
                SetPlayerArmedWeapon(playerid, 22);
                PlayerHasWeapon(playerid, 22);
                pData[playerid][pCopper] -= 400;
                pData[playerid][pPlactic] -= 400;
                pData[playerid][pSteel] -= 400;
                pData[playerid][pMetalScrap] -= 400;

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET plactic = %i WHERE uid = %i", pData[playerid][pPlactic], pData[playerid][pID]);
