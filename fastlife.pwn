                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET nationalid = %i WHERE uid = %i", pData[playerid][pNationalID], pData[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);

                SendProximityMessage(playerid, 20.0, SERVER_COLOR1, "**{C2A2DA} %s paid $%i to the cityhall desk and received national id.", GetRPName(playerid), price);
                SCM(playerid, COLOR_WHITE, "** National ID purchased. you can now get a job.");
