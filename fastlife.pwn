			return SendClientMessage(playerid, COLOR_SYNTAX, "USAGE: /setstat [playerid] [Eth] [value]");
		}

		pData[targetid][pEth] = value;
	    SM(playerid, COLOR_WHITE, "You have set %s's ethereum to %i.", GetRPName(targetid), value);
        format(query, sizeof(query), "```%s has set %s ethereum to %s.```", GetRPName(playerid), value, GetRPName(targetid));
