CMD:permaban(playerid, params[])
{
    new targetid, reason[128];

    if(pData[playerid][pAdmin] < 45)
        return ShowError(playerid, "CMD 4ALAT A BRO");

    if(sscanf(params, "us[128]", targetid, reason))
        return SCM(playerid, COLOR_SYNTAX, "Usage: /permaban [playerid] [reason]");

    if(!IsPlayerConnected(targetid))
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");

    if(pData[targetid][pAdmin] > pData[playerid][pAdmin])
        return SCM(playerid, COLOR_SYNTAX, "The player specified has a higher admin level than you. They cannot be banned.");

    if(pData[targetid][pAdmin] == 7)
    {
        SAM(COLOR_YELLOW, "Warning: %s has been autokicked for trying to ban a Management(%s).",
            GetRPName(playerid), GetRPName(targetid));
        KickPlayer(playerid);
        return 1;
    }

    Log_Write("log_punishments", "%s (uid: %i) permabanned %s (uid: %i), reason: %s",
        GetPlayerNameEx(playerid), pData[playerid][pID],
        GetPlayerNameEx(targetid), pData[targetid][pID], reason);

    SMA(COLOR_LIGHTRED, ""RED"AdmCmd: %s"WHITE" was permanently banned by %s, reason: %s",
        GetRPName(targetid), GetRPName(playerid), reason);

    new target_name[MAX_PLAYER_NAME];
    GetPlayerName(targetid, target_name, sizeof(target_name));

    new discord_id[32];
    GetPlayerDiscordID(target_name, discord_id);

    new hour, minute, second, day, month, year;
    gettime(hour, minute, second);
    getdate(year, month, day);

    SendPermaBanDiscordMessage(GetRPName(playerid), target_name, reason, -1,
        day, month, year, hour, minute, second, 1, discord_id);

    BanPlayer(targetid, GetPlayerNameEx(playerid), reason, true);
	return 1;
}

stock GetPlayerDiscordID(const player_name[], discord_id[], size = sizeof(discord_id))
{
    new query[256];
    new Cache:result;

    mysql_format(connectionID, query, sizeof(query),
        "SELECT discord_id FROM users WHERE username = '%e' LIMIT 1",
        player_name);
    result = mysql_query(connectionID, query);

    if(cache_get_row_count(connectionID))
    {
        cache_get_field_content(0, "discord_id", discord_id, connectionID, size);
    }
    else
    {
        discord_id[0] = EOS;
    }

    cache_delete(result);
    return 1;
}

stock SendPermaBanDiscordMessage(admin_name[], player_name[], reason[], hours,
    day, month, year, hour, minute, second, isOnline, discord_id[])
{
    if(ban_channel == DCC_INVALID_CHANNEL)
    {
        print("[DCC] ERROR: ban_channel is invalid!");
        return;
    }

    new title[128];
    new field_value[256];
    new full_msg[256];
    new duration_text[32];

    if(hours == -1)
        format(duration_text, sizeof(duration_text), "PERMANENT");
    else
        format(duration_text, sizeof(duration_text), "%d Hours", hours);

    if(isOnline)
        format(title, sizeof(title), "PLAYER BANNED - ONLINE");
    else
        format(title, sizeof(title), "PLAYER BANNED - OFFLINE");

    new DCC_Embed:embed = DCC_CreateEmbed();
    if(embed == DCC_Embed:0) return;

    DCC_SetEmbedColor(embed, (hours == -1 ? 0x8B0000 : (isOnline ? 0xFF0000 : 0xFF6600)));
    DCC_SetEmbedTitle(embed, title);
    DCC_SetEmbedDescription(embed, "A player has been banned from the server.");
    DCC_SetEmbedImage(embed, "https://cdn.discordapp.com/attachments/1546461219462971423/1554658042769838170/c0f70d1c7279f237.jpg");
    DCC_SetEmbedFooter(embed, "Fastlife Anti-Cheat System", "");

    format(field_value, sizeof(field_value), "```%s```", admin_name);
    DCC_AddEmbedField(embed, "Admin Name", field_value, true);

    format(field_value, sizeof(field_value), "```%s```", player_name);
    DCC_AddEmbedField(embed, "Banned Player", field_value, true);

    format(field_value, sizeof(field_value), "```%s```", duration_text);
    DCC_AddEmbedField(embed, "Ban Duration", field_value, true);

    format(field_value, sizeof(field_value), "```%s```", reason);
    DCC_AddEmbedField(embed, "Ban Reason", field_value, false);

    format(field_value, sizeof(field_value), "```%02d:%02d:%02d```", hour, minute, second);
    DCC_AddEmbedField(embed, "Time", field_value, true);

    format(field_value, sizeof(field_value), "```%02d/%02d/%d```", day, month, year);
    DCC_AddEmbedField(embed, "Date", field_value, true);

    if(strlen(discord_id) >= 17)
        format(full_msg, sizeof(full_msg), "<@%s> - NEW BAN ALERT", discord_id);
    else
        format(full_msg, sizeof(full_msg), "NEW BAN ALERT");

    DCC_SendChannelEmbedMessage(ban_channel, embed, full_msg);
}


CMD:baninfo(playerid, params[])
{
    new string[MAX_PLAYER_NAME];

    if(pData[playerid][pAdmin] < 5 && !pData[playerid][pBanAppealer])
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    if(sscanf(params, "s[24]", string))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /baninfo [username/ip]");
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT * FROM bans WHERE username = '%e' OR ip = '%e'", string, string);
    mysql_tquery(connectionID, queryBuffer, "OnAdminCheckBan", "is", playerid, string);
    return 1;
}

CMD:banhistory(playerid, params[])
{
    new name[MAX_PLAYER_NAME];

    if(pData[playerid][pAdmin] < 5 && !pData[playerid][pBanAppealer])
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    if(sscanf(params, "s[24]", name))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /banhistory [username]");
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT a.date, a.description FROM log_bans a, users b WHERE a.uid = b.uid AND b.username = '%e' ORDER BY a.date DESC", name);
    mysql_tquery(connectionID, queryBuffer, "OnAdminCheckBanHistory", "is", playerid, name);

    return 1;
}

CMD:startlottoex(playerid, params[])
{
    if(pData[playerid][pAdmin] < 6)
    {
        return SCM(playerid, COLOR_ERROR, "Error:"WHITE" You are not authorized to use this command.");
    }

    if(LottoStarted)
    return SCM(playerid, COLOR_ERROR, "There is already one lottery drawing in process.");

    new minutes;
    if(sscanf(params, "dD(0)", gDrawNumber))
    return SCM(playerid, -1, "USAGE: /startlottoex [draw number (optional)]");

    if(minutes < 3 || minutes > 60)
    return SCM(playerid, COLOR_ERROR, "Draw minutes shouldn't be below 3 minutes and shouldn't be more than 60 minutes.");

    if(gDrawNumber < 1 || gDrawNumber > 99)
    return SCM(playerid, COLOR_ERROR, "Draw Number must be between 1 to 99.");

    KillTimer(gLottoTimer);
    StartLotto(minutes);

    foreach(new i : Player) SCMf(i, COLOR_YELLOW, "A drawing for the lottery has been announced! The numbers will be drawn in %d minutes.", minutes);
    SAM(COLOR_ERROR, "AdmWarning: Administrator %s has started the lottery in %d minutes.", GetPlayerNameEx(playerid), minutes);
    return 1;
}


CMD:startlotto(playerid, params[])
{
    if(pData[playerid][pAdmin] < 6)
    {
        return SCM(playerid, COLOR_ERROR, "Error:"WHITE" You are not authorized to use this command.");
    }

    if(LottoStarted)
    return SCM(playerid, COLOR_ERROR, "There is already one lottery drawing in process.");

    KillTimer(gLottoTimer);
    PrepareLotto();

    foreach(new i : Player) SCM(i, COLOR_YELLOW, "A drawing for the lottery has been announced! The numbers will be drawn in 60 minutes.");
    SAM(COLOR_ERROR, "AdmWarning: Administrator %s has started the lottery.", GetPlayerNameEx(playerid));
    return 1;
}



CMD:unban(playerid, params[])
{
	new username[MAX_PLAYER_NAME];
    new query[256];

    if(pData[playerid][pAdmin] < 7)
	{
	    return SCM(playerid, COLOR_SYNTAX, "[SYSTEM]: "RED" You are not authorized to use this command.");
	}
	if(sscanf(params, "s[24]", username))
	{
	    return SCM(playerid, COLOR_SYNTAX, "Usage: /unban [username]");
	}

    format(query, sizeof(query), "```%s was unbanned by %s```", username, GetRPName(playerid));
    DCC_SendChannelMessage(unban, query);
	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id, permanent FROM bans WHERE username = '%e'", username);
	mysql_tquery(connectionID, queryBuffer, "OnAdminUnbanUser", "is", playerid, username);
	return 1;
}


CMD:unbanip1(playerid, params[])
{
	new string[25];

    if(pData[playerid][pAdmin] < 7 && !pData[playerid][pBanAppealer])
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}
	if(!IsAnIP(params))
	{
	    return SCM(playerid, COLOR_SYNTAX, "Usage: /unbanip [ip address]");
	}

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "DELETE FROM bans WHERE ip = '%s'", params);
	mysql_tquery(connectionID, queryBuffer);

	format(string, sizeof(string), "unbanip %s", params);
	SendRconCommand(string);
	SendRconCommand("reloadbans");

	UnBlockIpAddress(params);
	SAM(COLOR_RED, "AdmCmd: %s has unbanned IP '%s'.", GetRPName(playerid), params);
	return 1;
}

CMD:banip1(playerid, params[])
{
	new ip[16], reason[128];

    if(pData[playerid][pAdmin] < 45 && !pData[playerid][pBanAppealer])
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}
	if(sscanf(params, "s[16]S(N/A)[128]", ip, reason))
	{
	    return SCM(playerid, COLOR_SYNTAX, "Usage: /banip [ip address] [reason (optional)]");
	}
	if(!IsAnIP(ip))
	{
	    return SCM(playerid, COLOR_SYNTAX, "Invalid IP address.");
	}

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT id FROM bans WHERE ip = '%s'", ip);
	mysql_tquery(connectionID, queryBuffer, "OnAdminBanIP", "iss", playerid, ip, reason);
	return 1;
}


