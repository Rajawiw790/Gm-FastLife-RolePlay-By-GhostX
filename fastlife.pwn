            if(!IsPlayerInRangeOfPoint(playerid, 5.0, 2205.9653,1582.1709,999.9766))
            {
                return SCM(playerid, COLOR_SYNTAX, "You are not in range of the smuggle point.");
            }
            if(pData[playerid][pCP] != CHECKPOINT_NONE)
