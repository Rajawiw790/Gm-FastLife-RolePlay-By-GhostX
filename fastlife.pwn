CMD:revivenear(playerid, params[])
{
	new Float:radius;

	if(pData[playerid][pAdmin] < 7)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "You are not authorized to use this command.");
	}
	if(sscanf(params, "f", radius))
	{
	    return SendClientMessage(playerid, COLOR_SYNTAX, "USAGE: /reviverange [radius]");
	}
	if(!(1.0 <= radius <= 50.0))
	{
	    return SendClientMessage(playerid, COLOR_GREY, "The radius can't be below 1.0 or above 50.0.");
	}

	foreach(new i : Player)
	{
		if(IsPlayerInRangeOfPlayer(i, playerid, radius) && pData[i][pInjured])
		{
			pData[i][pInjured] = 0;
			if(pData[i][pAcceptedEMS] != INVALID_PLAYER_ID)
			{
			    SM(pData[i][pAcceptedEMS], COLOR_YELLOW, "Your patient %s has somehow found the strength to get up.", GetRPName(i));
			    pData[i][pAcceptedEMS] = INVALID_PLAYER_ID;
			}

            TogglePlayerControllable(i, 1);
			SetPlayerHealth(i, 100.0);
			pData[i][pHunger] = 100;
			pData[i][pHungerTimer] = 0;
		    pData[i][pThirst] = 100;
			pData[i][pThirstTimer] = 0;
			ClearAnimations(i, 1);
			UpdateDynamic3DTextLabelText(InjuredLabel[i], COLOR_DOCTOR, "");

		    SendClientMessage(i, COLOR_WHITE, "An admin has revived everyone nearby.");
		}
	}

	return 1;
}

CMD:healnear(playerid, params[]) { return callcmd::healrange(playerid, params); }
CMD:healrange(playerid, params[])
{
    if(pData[playerid][pAdmin] < 7)
    {
        return ShowError(playerid, "CMD 4ALAT A BRO");
    }
    foreach(new i : Player)
    {
       SetPlayerHealth(i, 100.0);
       SetPlayerArmour(i, 100.0);

       SM(i, COLOR_GREEN, "Administrator %s has healed your health and armor.", GetRPName(playerid));
    }

    SCM(playerid, COLOR_GREEN, "You have healing the health and armor of all online players.");
    return 1;
}


