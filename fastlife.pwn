CMD:disablevpn(playerid)
{
    if(pData[playerid][pAdmin] < 46)
        return SendClientMessage(playerid, COLOR_GREY, "You are not authorized.");

    gDisabledVPN = 1;
    SendAdminMessage(COLOR_LIGHTRED, "AdmCmd: %s has disabled joining with VPN.", GetRPName(playerid));
    return 1;
}

CMD:enablevpn(playerid)
{
    if(pData[playerid][pAdmin] < 46)
        return SendClientMessage(playerid, COLOR_GREY, "You are not authorized.");

    gDisabledVPN = 0;
    SendAdminMessage(COLOR_LIGHTRED, "AdmCmd: %s has enabled joining with VPN.", GetRPName(playerid));
    return 1;
}

    CMD:Bot(playerid, params[])
    {
        if(pData[playerid][pAdmin] < 46 && !IsPlayerAdmin(playerid))
        {
            return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
        }

        pAntiCheatSettingsPage{playerid} = 1; // Set the variable that stores the page number the player is on to the value 1 (that is, now the player is on page 1)
        return ShowPlayer_AntiCheatSettings(playerid); // Show the player the main anti-cheat settings dialog
    }

    CMD:setweather(playerid, params[])
    {
        if(pData[playerid][pAdmin] < 46)
        {
            SCM(playerid, COLOR_SYNTAX, "You are not authorized to use that command!");
            return 1;
        }

        new weather;
        if(sscanf(params, "d", weather)) return SCM(playerid, COLOR_WHITE, "USAGE: /weatherall [weatherid]");

        if(weather < 0||weather > 45) { SCM(playerid, COLOR_GREY, "   Weather ID can't be below 0 or above 45!"); return 1; }
        SetWeather(weather);
        gWeather = weather;
        SCM(playerid, COLOR_GREY, "Weather set to everyone!");
        return 1;
    }

    CMD:Trush(playerid, params[])
    {
        if(!IsPlayerInGarbageArea(playerid))
        {
            return SendClientMessage(playerid, COLOR_GREY, "You are not in range of garbage.");
        }
        if(gettime() - pData[playerid][pLastDrug] < 120)
        {
            return SM(playerid, COLOR_SYNTAX, "You can only frisk trush every 120 seconds. Please wait %i more seconds.", 120 - (gettime() - pData[playerid][pLastDrug]));
        }

        ShowProgressbar(playerid, "LOADING...", 8);
        TogglePlayerControllable(playerid, 0);
        pData[playerid][pLastDrug] = gettime();
        SetTimerEx("FriskGarbage", 100, false, "i", playerid);
        ApplyAnimationEx(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0);
        return 1;
    }

CMD:buyvehicle(playerid, params[])
{
	static string[4096];
	pData[playerid][pGangCar] = 0;
    if(pData[playerid][pAdminDuty])
	{
	    return SAM(COLOR_RED, "%s HAD ZBI KIDIR GLITCH B /ADUTY!", GetRPName(playerid));
	}
	if(IsPlayerInRangeOfPoint(playerid, 3.0, 1322.775268, -883.598754, 39.664062))
	{
  		string = "Category\tVehicle\tPrice";

		for(new i = 0; i < sizeof(vehicleArray); i ++)
	  	{
	  		if(strcmp(vehicleArray[i][carCategory], "Boats") != 0 && strcmp(vehicleArray[i][carCategory], "Aircraft") != 0)
	  		{
		    	format(string, sizeof(string), "%s\n%s\t%s\t"SVRCLR"%s"WHITE"", string, vehicleArray[i][carCategory], vehicleNames[vehicleArray[i][carModel] - 400], FormatNumber(vehicleArray[i][cARPrice]));
			}
		}
		pData[playerid][pGangCar] = 0;
		ShowPlayerDialog(playerid, DIALOG_BUYVEHICLE, DIALOG_STYLE_TABLIST_HEADERS, "Grotti Dealership", string, "Buy", "Cancel");
	}
	else if(IsPlayerInRangeOfPoint(playerid, 3.0, 154.2223, -1946.3030, 5.1920))
	{
    	string = "Vehicle\tPrice";

		for(new i = 0; i < sizeof(vehicleArray); i ++)
	  	{
	  		if(!strcmp(vehicleArray[i][carCategory], "Boats"))
	  		{
		    	format(string, sizeof(string), "%s\n%s\t"SVRCLR"%s"WHITE"", string, vehicleNames[vehicleArray[i][carModel] - 400], FormatNumber(vehicleArray[i][cARPrice]));
			}
		}
		ShowPlayerDialog(playerid, DIALOG_BUYBOAT, DIALOG_STYLE_TABLIST_HEADERS, "Boat Dealership", string, "Buy", "Cancel");
	}
	else if(IsPlayerInRangeOfPoint(playerid, 3.0, 1892.6315, -2328.6721, 13.5469))
	{
     	string = "Vehicle\tPrice";

		for(new i = 0; i < sizeof(vehicleArray); i ++)
	  	{
	  		if(!strcmp(vehicleArray[i][carCategory], "Aircraft"))
	  		{
		    	format(string, sizeof(string), "%s\n%s\t"SVRCLR"%s"WHITE"", string, vehicleNames[vehicleArray[i][carModel] - 400], FormatNumber(vehicleArray[i][cARPrice]));
			}
		}
		ShowPlayerDialog(playerid, DIALOG_BUYAIRCRAFT, DIALOG_STYLE_TABLIST_HEADERS, "Aircraft Dealership", string, "Buy", "Cancel");
	}
	else
	{
	    SCM(playerid, COLOR_SYNTAX, "You are not in range of any dealership.");
	}
	return 1;
}
    /*CMD:getmycar(playerid, params[])
