            "**Warning:** `%s` is already whitelisted!\n\
            Updating Discord ID...", playername);
        DCC_SetEmbedDescription(embed, string);
        DCC_SetEmbedColor(embed, 0xFF7B01);
        DCC_SendChannelEmbedMessage(channel, embed);
    }
    else
    {
        dini_Create(filepath);
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "SELECT discord_id FROM users WHERE username = '%e' LIMIT 1",
        playername);
    mysql_tquery(connectionID, queryBuffer, "OnWhitelistCheck", "");

    return 1;
}

forward OnWhitelistCheck();
public OnWhitelistCheck()
{
    new channel = DCC_FindChannelById(WHITELIST_CHANNEL_ID);

    if(!cache_get_row_count(connectionID))
    {
        new hashed_pass[129];
        WP_Hash(hashed_pass, sizeof(hashed_pass), "changeme123");

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
            "INSERT INTO users (username, password, discord_id, regdate, lastlogin) \
            VALUES ('%e', '%e', '%e', NOW(), NOW())",
            g_wl_name, hashed_pass, g_wl_discord);
        mysql_tquery(connectionID, queryBuffer, "OnWhitelistDone", "");

        return 1;
    }

    new existing_discord[32];
    cache_get_field_content(0, "discord_id", existing_discord, connectionID, sizeof(existing_discord));

    if(strlen(existing_discord) >= 17)
    {
        new DCC_Embed:embed = DCC_CreateEmbed("Fastlife-Bot");
        new string[350];
        format(string, sizeof(string),
            "**Warning:** `%s` already has Discord linked!\n\
            **Existing Discord ID:** `%s`",
            g_wl_name, existing_discord);
        DCC_SetEmbedDescription(embed, string);
        DCC_SetEmbedColor(embed, 0xFF7B01);
        return DCC_SendChannelEmbedMessage(channel, embed);
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "UPDATE users SET discord_id = '%e' WHERE username = '%e'",
        g_wl_discord, g_wl_name);
    mysql_tquery(connectionID, queryBuffer, "OnWhitelistDone", "");

    return 1;
}

forward OnWhitelistDone();
public OnWhitelistDone()
{
    new channel = DCC_FindChannelById(WHITELIST_CHANNEL_ID);

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i)) continue;

        new pname[MAX_PLAYER_NAME];
        GetPlayerName(i, pname, sizeof(pname));

        if(strcmp(pname, g_wl_name, true) == 0)
        {
            SCM(i, COLOR_GREEN, "You got whitelist! Discord linked.");
            break;
        }
    }

    new DCC_Embed:embed = DCC_CreateEmbed("Fastlife-Bot");
    new string[350];
    format(string, sizeof(string),
        "Safi rah 3titi Whitelist!\n\
        **Name:** `%s`\n\
        **Discord ID:** `%s`\n\
        **Mention:** <@%s>",
        g_wl_name, g_wl_discord, g_wl_discord);

    DCC_SetEmbedDescription(embed, string);
    DCC_SetEmbedColor(embed, 0x00FF00);
    DCC_SendChannelEmbedMessage(channel, embed);

    return 1;
}

