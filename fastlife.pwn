public OnAntiCheatTurnUpsideDown(playerid, Float:angle) {
    if(pData[playerid][pDraggedBy] == INVALID_PLAYER_ID)
    {
	    SetTimerEx("ResetFlyWarning", 10000, false, "i", playerid);
        FlyHackWarning[playerid]++;
        SendAdminMessage(COLOR_YELLOW,
            ""RED"AdmWarning: %s[%d]"WHITE" Fly Hack Warning #%d (angle: %f)",
            GetRPName(playerid),
            playerid,
            FlyHackWarning[playerid],
            angle
        );
        SendClientMessage(playerid, COLOR_RED, "Mrg a khona");
        if(FlyHackWarning[playerid] >= 3) {
            SendAdminMessage(COLOR_RED,
                ""RED"AdmAction: %s[%d] has been auto-kicked for fly hacking",
                GetRPName(playerid),
                playerid
            );
            FlyHackWarning[playerid] = 0;

            KickPlayere(playerid, "You Have Been Kicked for fly hacking");
            return 1;
        }
    }
    else
    {
        return 1;
    }

    return 1;
}
forward Slide(playerid);
public Slide(playerid)
{
    if(Sliding[playerid] == 1)
    {
        new Float:X;
        new Float:Y;
        new Float:Z;
        GetPlayerPos(playerid, X, Y, Z);
        SetPlayerPos(playerid, X, Y, Z - 5.00);
        SetTimerEx("Slide", 1000, 0, "i", playerid);
    }
    return 1;
}

forward IsAChopper(vehicleid);
public IsAChopper(vehicleid)
{
    if(vehicleid >= 0 && vehicleid <= 1) // < Define your Chopper ID's Here
    {
        return 1;
    }
    return 0;
}

//temoporary
CMD:slide(playerid, params[])
{
    new vehicleid;
    if(IsPlayerInAnyVehicle(playerid) && IsAChopper(vehicleid) && Sliding[playerid] == 0)
    {
        Sliding[playerid] = 1;
        RemovePlayerFromVehicle(playerid);
        TogglePlayerControllable(playerid, 0);
        SetTimerEx("Slide", 1000, 0, "i", playerid);
        SendClientMessage(playerid, COLOR_WHITE, "You are sliding down the rope.");
    }
    return 1;
}

CMD:stopp(playerid, params[])
{
    if(Sliding[playerid] == 1)
    {
        Sliding[playerid] = 0;
        TogglePlayerControllable(playerid, 1);
        SendClientMessage(playerid, COLOR_WHITE, "You have stopped sliding.");
    }
    return 1;
}

