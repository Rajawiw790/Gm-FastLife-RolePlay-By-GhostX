IsACruiser(vehicleid)
{
    switch (GetVehicleModel(vehicleid))
    {
        case 523, 427, 490, 528, 596..599, 601: return 1;
    }
    return 0;
}

IsAPlane(vehicleid)
{
    switch(GetVehicleModel(vehicleid))
    {
        case 460, 464, 476, 511..513, 519, 520, 553, 577, 592, 593: return 1;
    }
    return 0;
}
