        //ProgressInteractionPTD[playerid][3] = CreatePlayerTextDraw(playerid, 320.000000, 323.000000, info);
        PlayerTextDrawFont(playerid, ProgressInteractionPTD[playerid][3], 1);
        PlayerTextDrawLetterSize(playerid, ProgressInteractionPTD[playerid][3], 0.129166, 1.000000);
        PlayerTextDrawTextSize(playerid, ProgressInteractionPTD[playerid][3], 400.000000, 82.500000);
        PlayerTextDrawSetOutline(playerid, ProgressInteractionPTD[playerid][3], 0);
        PlayerTextDrawSetShadow(playerid, ProgressInteractionPTD[playerid][3], 0);
