                pData[playerid][pACWarns]++;

                if(pData[playerid][pACWarns] < MAX_ANTICHEAT_WARNINGS)
                {
                    SAM(COLOR_RED, ""RED"AdmWarning: %s"WHITE"[%i] is possibly teleport matrunning (time: %i).", GetRPName(playerid), playerid, gettime() - pData[playerid][pSmuggleTime]);
                }
                else
                {
                    SMA(COLOR_LIGHTRED, ""RED"AdmCmd: %s"WHITE" was auto-kicked by %s, reason: Teleport matrun", GetRPName(playerid), SERVER_BOT);
                    //BanPlayer(playerid, SERVER_BOT, "Teleport matrun");
                    Kick(playerid);
                }
            }

            GivePlayerCash(playerid, 30);
            GameTextForPlayer(playerid, "~g~Stocking...", 6000, 3);
            SCM(playerid, COLOR_AQUA, "You have dropped off your load and collected $30 cash from the Truck.");
            pData[playerid][pCP] = CHECKPOINT_NONE;

            RemovePlayerAttachedObject(playerid, 9);
            DisablePlayerCheckpoint(playerid);
        }
    }
    case CHECKPOINT_SHOPEE:
    {
        new string[32], amount = ((80 - pData[playerid][pPizzaTime])), tip = 10 + random(10);

        if(gettime() - pData[playerid][pLastPizza] < 15 && pData[playerid][pAdmin] < 2 && !pData[playerid][pKicked])
        {
            pData[playerid][pACWarns]++;

            if(pData[playerid][pACWarns] < MAX_ANTICHEAT_WARNINGS)
            {
                SAM(COLOR_YELLOW, "AdmWarning: %s[%i] is possibly teleport shopee delivering (time: %i).", GetRPName(playerid), playerid, gettime() - pData[playerid][pLastShopee]);
            }
        }
        new giveplayerid;
        format(string, sizeof(string), "~g~+$%i", amount);
        GameTextForPlayer(playerid, string, 5000, 1);

        GivePlayerCash(playerid, amount);
        GivePlayerCash(playerid, tip);

        pData[playerid][pShopee] = 0;
        pData[playerid][pShopeeTime] = 0;
        pData[playerid][pCP] = CHECKPOINT_NONE;

        SM(playerid, COLOR_WHITE, "You received $%i and Gifts for this delivery. You also received a $%i tip.", amount, tip);
        DisablePlayerCheckpoint(playerid);
    }
