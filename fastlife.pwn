                        return ShowDialogToPlayer(playerid, DIALOG_GANGDEPOSIT);
                    }
                    if(GangInfo[pData[playerid][pGang]][gPot] + amount > GetGangStashCapacity(pData[playerid][pGang], STASH_CAPACITY_WEED))
                    {
