    new string[64];
	format(string, sizeof(string), "* %s picked up %d guns from van.", GetRPName(playerid), amount);
    ShowActionBubble(playerid, string);
    SendClientMessage(playerid, COLOR_WHITE, "Rak Hzit Sla7 Mn Lvan");

    }

