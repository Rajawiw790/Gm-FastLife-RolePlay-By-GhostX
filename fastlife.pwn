			{
	            cost = 5 + random(7);
	            read = 3 + random(7);
			}
			else if(pData[playerid][pElectricMeat] == 2)
			{
			    cost = 5 + random(10);
			    read = 3 + random(10);
			}
			else if(pData[playerid][pElectricMeat] == 3) // Musgravite
			{
			    cost = 5 + random(13);
			    read = 3 + random(13);
			}
			else if(pData[playerid][pElectricMeat] == 4) // Gold
			{
			    cost = 5 + random(14);
			    read = 3 + random(14);
			}
			else if(pData[playerid][pElectricMeat] == 5) // Diamond
			{
			    cost = 5 + random(15);
                read = 3 + random(15);
   		 	pData[playerid][pRareTime] = 60;
			}

			GivePlayerCash(playerid, cost);
			pData[playerid][pBitcoin] = pData[playerid][pBitcoin] + read;
			SM(playerid, COLOR_WHITE, "{FF0000}Money {00FF00} $%i --- {FF0000}BitCoins {000000}+%i.", cost, read);
			ApplyAnimation(playerid, "CARRY", "putdwn", 4.1, 0, 0, 0, 0, 0, 1);

			format(string, sizeof(string), "~g~+$%i ~w~| ~r~+BTC %i", cost, read);
			Dyuze(playerid, "Notice", string);

			pData[playerid][pElectricMeat] = 0;
			pData[playerid][pCP] = CHECKPOINT_NONE;

			SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
			RemovePlayerAttachedObject(playerid, 9);

			mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET ecoin = %i WHERE uid = %i", pData[playerid][pBitcoin], pData[playerid][pID]);
			mysql_tquery(connectionID, queryBuffer);

			DisablePlayerCheckpoint(playerid);
	    }

    case CHECKPOINT_SEEDS:
    {
        if(IsPlayerInRangeOfPoint(playerid, 10.0, 731.362356, -102.712524, 22.585937))
        {
            if(gettime() - pData[playerid][pSmuggleTime] < 20 && pData[playerid][pAdmin] < 2 && !pData[playerid][pKicked])
            {
                pData[playerid][pACWarns]++;

                if(pData[playerid][pACWarns] < MAX_ANTICHEAT_WARNINGS)
                {
                    SAM(COLOR_RED, ""RED"AdmWarning: %s"WHITE"[%i] is possibly teleport matrunning (time: %i).", GetRPName(playerid), playerid, gettime() - pData[playerid][pSmuggleTime]);
                }
                else
                {
                    SMA(COLOR_LIGHTRED, ""RED"AdmCmd: %s"WHITE" was auto-kicked by %s, reason: Teleport matrun", GetRPName(playerid), SERVER_BOT);
                    //BanPlayer(playerid, SERVER_BOT, "Teleport matrun");
                    Kick(playerid);
                }
            }

            new rand = Random(1, 2);
            pData[playerid][pSeeds] += rand;
            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET seeds = %i WHERE uid = %i", pData[playerid][pSeeds], pData[playerid][pID]);
            mysql_tquery(connectionID, queryBuffer);
            pData[playerid][pCP] = CHECKPOINT_NONE;
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0, 1, 0, 0, 0, 0, 1);
            SendProximityMessage(playerid, 20.0, COLOR_PURPLE, "** %s Dropped the Plant and earn %i Seed.", GetRPName(playerid), rand);
            DisablePlayerCheckpoint(playerid);
            ApplyAnimation(playerid, "CARRY", "putdwn", 4.1, 0, 0, 0, 0, 0, 1);
            GameTextForPlayer(playerid, "~w~Boxing the Plant...", 3000, 3);
            SCM(playerid, COLOR_AQUA, "You have dropped some Seed frisk yourself.");
            pData[playerid][pCP] = CHECKPOINT_NONE;

            DisablePlayerCheckpoint(playerid);
        }
    }
