forward SpinFinish(playerid);
public SpinFinish(playerid)
{
    new index = SpinResult[playerid];
    new prize = SpinPrizes[index][0];
    new ptype = SpinPrizes[index][1];
    new msg[128];
    new slot;

    switch(ptype)
    {
        case 0: // Toy
        {
            for(slot = 0; slot < 10; slot++)
            {
                if(ClothingInfo[playerid][slot][cExists] == 0)
                    break;
            }
            if(slot < 10)
            {
                GivePlayerToy(playerid, prize, slot);
                format(msg, sizeof(msg), "You won: %s", PrizeName[index]);
            }
            else
            {
                format(msg, sizeof(msg), "You won: %s (Inventory full! Slot 0 overwritten)", PrizeName[index]);
                GivePlayerToy(playerid, prize, 0);
            }
        }
        case 1: // Money
        {
            GivePlayerCash(playerid, prize);
            format(msg, sizeof(msg), " You won: $%d", prize);
        }
        case 2: // VIP
        {
            GivePlayerVIP(playerid, prize);
            format(msg, sizeof(msg), " You won: %s", PrizeName[index]);
        }
        case 3: // Spin Card
        {
            pData[playerid][pCarSpinCard] += prize;
            format(msg, sizeof(msg), " You won: %s", PrizeName[index]);
        }
        case 4, 5, 6: // Drugs
        {
            GivePlayerDrugs(playerid, ptype, prize);
            format(msg, sizeof(msg), " You won: %s", PrizeName[index]);
        }
    }

    SendClientMessage(playerid, PrizeColor[index], msg);
    TogglePlayerControllable(playerid, 1);
    return 1;
}

