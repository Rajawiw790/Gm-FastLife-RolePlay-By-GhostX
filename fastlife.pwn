        if(!IsPlayerInRangeOfPoint(playerid, 3.0, -1608.156127, 1284.336914, 7.185514) && !IsPlayerInRangeOfPoint(playerid, 3.0, 1654.646118, -1074.268920, 23.898437))
        {
            return SendClientMessage(playerid, 0xAFAFAFAA, "{CCFFFF} which is lYou are not in the GetMyCar Position.");
        }
        if(pData[playerid][pCash] < 3500)
        {
