        SM(playerid, COLOR_WHITE, "** You have set %s's gold to %i.", GetRPName(targetid), value);
        format(query, sizeof(query), "```%s has set %s gold to %s.```", GetRPName(playerid), value, GetRPName(targetid));
        DCC_SendChannelMessage(setstat, query);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET gold = %i WHERE uid = %i", pData[playerid][pGold], pData[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
    }
	else if(!strcmp(option, "carspincard", true))
	{
