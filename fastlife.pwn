public OnPlayerPickUpPickup(playerid, pickupid) {
    if(pickupid == pickup777)
    {
        if(pData[playerid][pFaction] >= 1)
        {
            return SCM(playerid, COLOR_SYNTAX, "Faction members can't have a sidejob.");
        }
        if(pData[playerid][pCarLicense] == 0)
        {
            return SCM(playerid, COLOR_SYNTAX, "You are dont have drivng license. just go to LTO to take test and have one drivng license.");
        }
        if(pData[playerid][pNationalID] == 0)
        {
            return SCM(playerid, COLOR_SYNTAX, "You are dont have National ID. just go to Cityhall to apply.");
        }
        ShowDialogToPlayer(playerid, DIALOG_JOBCENTER);
    }
    return 1;
}
