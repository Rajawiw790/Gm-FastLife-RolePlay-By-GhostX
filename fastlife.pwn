ShowProgressbar(playerid, text[] = "", Times)
{
    if(pData[playerid][pProgressBar] == 1) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda Sedang ProgressBAR Harap Tunggu");

    pData[playerid][pProgressBar] = 1;
    LoadingPlayerBar[playerid] = 0;
    new Float:Value = LoadingPlayerBar[playerid]*121/100;
    new Timeron = Times*1000/100;
    TextDrawTextSize(PROGRESSBAR[1], Value, 3.5);
    TextDrawSetString(PROGRESSBAR[2], text);
    TextDrawShowForPlayer(playerid, PROGRESSBAR[0]);
    TextDrawShowForPlayer(playerid, PROGRESSBAR[1]);
    TextDrawShowForPlayer(playerid, PROGRESSBAR[2]);
    TogglePlayerControllable(playerid, 0);
    TimerLoading[playerid] = SetTimerEx("UpdtLoading", Timeron, true, "d", playerid);
    return 1;
}
forward UpdtLoading(playerid);
public UpdtLoading(playerid)
{
    LoadingPlayerBar[playerid] += 1;
    UpdateLoading(playerid);
    if(LoadingPlayerBar[playerid] >= 100)
    {
        pData[playerid][pProgressBar] = 0;
        KillTimer(TimerLoading[playerid]);
        LoadingPlayerBar[playerid] = 0;
        HideProgressBar(playerid);
        TogglePlayerControllable(playerid, 1);
    }
    return 1;
}

stock FormatCash(amount)
{
    new string[32];

    if(amount >= 1000000000)
    {
        new billions = amount / 1000000000;
        new remainder = (amount % 1000000000) / 100000000;

        if(remainder > 0)
            format(string, sizeof(string), "%d.%dB", billions, remainder);
        else
            format(string, sizeof(string), "%dB", billions);
    }
    else if(amount >= 1000000)
    {
        new millions = amount / 1000000;
        new remainder = (amount % 1000000) / 100000;

        if(remainder > 0)
            format(string, sizeof(string), "%d.%dM", millions, remainder);
        else
            format(string, sizeof(string), "%dM", millions);
    }
    else if(amount >= 1000)
    {
        new thousands = amount / 1000;
        new remainder = (amount % 1000) / 100;

        if(remainder > 0)
            format(string, sizeof(string), "%d.%dK", thousands, remainder);
        else
            format(string, sizeof(string), "%dK", thousands);
    }
    else
    {
        format(string, sizeof(string), "%d", amount);
    }

    return string;
}


stock UpdateLoading(playerid)
{
    new Float:Value = LoadingPlayerBar[playerid]*121.0/100;
    TextDrawTextSize(PROGRESSBAR[1], Value, 3.5);
    TextDrawShowForPlayer(playerid, PROGRESSBAR[1]);
    return 1;
}
HideProgressBar(playerid)
{
    TextDrawHideForPlayer(playerid, PROGRESSBAR[0]);
    TextDrawHideForPlayer(playerid, PROGRESSBAR[1]);
    TextDrawHideForPlayer(playerid, PROGRESSBAR[2]);
    return 1;
}

stock IsPlayerNearDynamicObject(playerid, objectid, Float:range = 5.0) {

    static
    Float:fX,
    Float:fY,
    Float:fZ;

    GetDynamicObjectPos(objectid, fX, fY, fZ);

    return (IsPlayerInRangeOfPoint(playerid, range, fX, fY, fZ));
}

