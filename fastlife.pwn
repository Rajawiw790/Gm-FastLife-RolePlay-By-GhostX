forward showfleeca4(playerid);
public showfleeca4(playerid)
{
	for(new i = 0; i < 25; i++)
	{
		TextDrawHideForPlayer(playerid, RobFleecaZB[i]);
	}
	for(new i = 0; i < 11; i++)
	{
		TextDrawShowForPlayer(playerid, RobFleecaZB2[i]);
	}
	SelectTextDraw(playerid, COLOR_LIGHTBLUE);
}

forward LoadServerSettings();
public LoadServerSettings()
{
    mysql_tquery(connectionID, "SELECT * FROM server_settings", "LoadServerSettingsCallback");
}

forward LoadServerSettingsCallback();
public LoadServerSettingsCallback()
{
    for(new i = 0; i < cache_num_rows(); i++)
    {
        new setting_name[50];
        cache_get_field_content(i, "setting_name", setting_name, sizeof(setting_name));

        if(strcmp(setting_name, "robfleeca") == 0)
        {
            grobfleecaon = cache_get_field_content_int(i, "setting_value");
        }
    }
    printf("[Server] Settings loaded: robfleeca = %d", grobfleecaon);
}

CMD:activeroballs(playerid, params[])
{
    if(pData[playerid][pAdmin] < 43 && !pData[playerid][pGangMod])
    {
        return SCM(playerid, COLOR_GREY2, "You are not authorized to use this command.");
    }

    if(grobfleecaon == 1)
    {
        grobfleecaon = 0;
        SCM(playerid, COLOR_RED, "roball off.");

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE server_settings SET setting_value = 0 WHERE setting_name = 'robfleeca'");
        mysql_tquery(connectionID, queryBuffer);
    }
    else
    {
        grobfleecaon = 1;
        SCM(playerid, COLOR_GREEN, "roball on.");

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE server_settings SET setting_value = 1 WHERE setting_name = 'robfleeca'");
        mysql_tquery(connectionID, queryBuffer);
    }
    return 1;
}

CMD:robstore(playerid, params[])
{
if(!IsPlayerInRangeOfPoint(playerid, 5, 1915.296386, -1767.595703, 12.646875))
    {
        SCM(playerid, COLOR_WHITE, "Your aren't near in the store vault!");
        return 1;
    }
    if(pData[playerid][pRobCooldown] > gettime())
    {
        new remaining = pData[playerid][pRobCooldown] - gettime();
        return SM(playerid, COLOR_RED, "You must wait %d seconds before robbing again!", remaining);
    }
    if(pData[playerid][pGang] == -1)
     {
                return SCM(playerid, COLOR_SYNTAX, "You are not apart of any gang at the moment.");
     }
    if(pData[playerid][pLockpick] <= 0)
        {
            return SCM(playerid, COLOR_SYNTAX, "You don't have any lockpicks left.");
        }
new	iSuccess;

  foreach(new i : Player)
    {
        if(IsLawEnforcement(i))
        {
            SM(i, COLOR_ROYALBLUE, "** HQ: A robbery is occurring at the Fleeca Bank. All units respond immediately.");
            SetPlayerCheckpoint(i, 598.477478, -1522.154541, 15.586158, 3.0);
        }
    }
TogglePlayerControllable(playerid, 0);
ApplyAnimation(playerid,"BOMBER","BOM_Plant", 4.1, 1, 1, 1, 0, 0);
pData[playerid][pLockpick]--;
StartRob(playerid);
return 1;
}

CMD:radiochat(playerid, params[]) return callcmd::setfreq(playerid, params);
CMD:setfreq(playerid, params[])
{
    if(pData[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_WHITE, "Cannot use this command while in-jail.");

    if(!pData[playerid][pWalkieTalkie])
	{
	    return SCM(playerid, COLOR_SYNTAX, "You don't have a Portable Radio.");
	}
	for(new i = 0; i < 19; i++) {
			TextDrawShowForPlayer(playerid, FreqTD[i]);
		}
		PlayerTextDrawShow(playerid, pFreqTD[playerid][0]);
		TextDrawShowForPlayer(playerid, selectfreqtd);
		TextDrawShowForPlayer(playerid, closeradio);
		TextDrawShowForPlayer(playerid, connectfreq);
		TextDrawShowForPlayer(playerid, disconnectfreq);
		SelectTextDraw(playerid, COLOR_LIGHTBLUE);
	ShowActionBubble(playerid, "* %s take our frequency radio.", GetRPName(playerid));
	return 1;
}


CMD:MYVISA(playerid, params[])
{
    new msg[128];
    format(msg, sizeof(msg), "Your PIN from database is: %d", pData[playerid][pPinCode]);
    SCM(playerid, COLOR_YELLOW, msg);
    return 1;
}

