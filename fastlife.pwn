CMD:post(playerid, params[])
{
    new reportid;

    if(pData[playerid][pAdmin] < 2)
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    if(sscanf(params, "i", reportid))
    {
        SCM(playerid, COLOR_SYNTAX, "Usage: /nor [reportid]");
        SCM(playerid, COLOR_WHITE, "This command will clear a report and notify the player to post an admin request.");
        return 1;
    }
    if(!(0 <= reportid < MAX_REPORTS) || !ReportInfo[reportid][rExists])
    {
        return SCM(playerid, COLOR_SYNTAX, "There's not a report that currently exists with this ID.");
    }
    if(ReportInfo[reportid][rAccepted])
    {
        return SCM(playerid, COLOR_SYNTAX, "This report is already being handled by another administrator.");
    }

    SAM(COLOR_RED, "AdmCmd:"WHITE" %s has trashed report %i from %s as it needs to be handled on the forums.", GetRPName(playerid), reportid, GetRPName(ReportInfo[reportid][rReporter]));
    SM(ReportInfo[reportid][rReporter], COLOR_LIGHTRED, "%s has trashed your report as your issue at hand must be handled on our forums.", GetRPName(playerid));
    SM(ReportInfo[reportid][rReporter], COLOR_LIGHTRED, "Please visit our website at ("SERVER_URL") in order to to resolve this issue.");
    ReportInfo[reportid][rExists] = 0;
    return 1;
}

CMD:rr(playerid, params[])
{
    new reportid = pData[playerid][pActiveReport];
    new query[256];

    if(reportid == -1)
    {
        return SCM(playerid, COLOR_SYNTAX, "You have no active report to reply to.");
    }
    if(isnull(params))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /rr [reply text]");
    }

    if(ReportInfo[reportid][rReporter] == playerid)
    {
        SM(ReportInfo[reportid][rHandledBy], COLOR_RED, "** Player "WHITE"%s"TEAL" (ID "WHITE"%i"TEAL"): "WHITE"%s **", GetRPName(playerid), playerid, params);
        SM(playerid, COLOR_RED, "** Reply to "WHITE"%s"TEAL" (ID "WHITE"%i"TEAL"): "WHITE"%s **", GetRPName(ReportInfo[reportid][rHandledBy]), ReportInfo[reportid][rHandledBy], params);
        format(query, sizeof(query), "```** Reply to %s (ID %i): %s **```", GetRPName(ReportInfo[reportid][rHandledBy]), ReportInfo[reportid][rHandledBy], params);
        format(query, sizeof(query), "```** Player %s (ID %i): %s **```", GetRPName(playerid), playerid, params);
        DCC_SendChannelMessage(rr, query);
    }
    else
    {
        SM(ReportInfo[reportid][rReporter], COLOR_RED, "** Admin "WHITE"%s"TEAL" (ID "WHITE"%i"TEAL"): "WHITE"%s **", GetRPName(playerid), playerid, params);
        SM(playerid, COLOR_RED, "** Reply to "WHITE"%s"TEAL" (ID "WHITE"%i"TEAL"): "WHITE"%s **", GetRPName(ReportInfo[reportid][rReporter]), ReportInfo[reportid][rReporter], params);
        format(query, sizeof(query), "```** Admin %s (ID %i): %s **```", GetRPName(playerid), playerid, params);
        format(query, sizeof(query), "```** Reply to %s (ID %i): %s **```", GetRPName(ReportInfo[reportid][rReporter]), ReportInfo[reportid][rReporter], params);
        DCC_SendChannelMessage(rr, query);
    }

    return 1;
}

CMD:cr(playerid, params[])
{
    new reportid = pData[playerid][pActiveReport];
    new query[256];

    if(reportid == -1)
    {
        return SCM(playerid, COLOR_SYNTAX, "You have no active report which you can close.");
    }

    if(ReportInfo[reportid][rReporter] == playerid)
    {
        SM(ReportInfo[reportid][rHandledBy], COLOR_RED, "** Player "WHITE"%s"TEAL" has closed the report. **", GetRPName(playerid));
        SM(playerid, COLOR_YELLOW, "You have closed the report and ended your conversation with the admin.");
        format(query, sizeof(query), "```** Player %s has closed the report. **```", GetRPName(playerid));
        DCC_SendChannelMessage(cr, query);
    }
    else
    {
        SM(ReportInfo[reportid][rReporter], COLOR_RED, "** Administrator "WHITE"%s"TEAL" has closed the report. **", GetRPName(playerid));
        SM(playerid, COLOR_RED, "You have closed the report and ended your conversation with the reporter.");
        format(query, sizeof(query), "```** Administrator %s has closed the report. **```", GetRPName(playerid));
        DCC_SendChannelMessage(cr, query);
    }

    if(ReportInfo[reportid][rReporter] != INVALID_PLAYER_ID)
    {
        pData[ReportInfo[reportid][rReporter]][pActiveReport] = -1;
    }
    if(ReportInfo[reportid][rHandledBy] != INVALID_PLAYER_ID)
    {
        pData[ReportInfo[reportid][rHandledBy]][pActiveReport] = -1;
    }

    ReportInfo[reportid][rExists] = 0;
    ReportInfo[reportid][rAccepted] = 0;
    ReportInfo[reportid][rReporter] = INVALID_PLAYER_ID;
    ReportInfo[reportid][rHandledBy] = INVALID_PLAYER_ID;
    pData[playerid][pActiveReport] = -1;

    return 1;
}

CMD:ban(playerid, params[])
{
    new targetid, reason[128];

    if(pData[playerid][pAdmin] < 40)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(sscanf(params, "us[128]", targetid, reason))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /ban [playerid] [reason]");
    }
    if(!IsPlayerConnected(targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");
    }
    if(pData[targetid][pAdmin] > pData[playerid][pAdmin])
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified has a higher admin level than you. They cannot be banned.");
    }
    if(pData[targetid][pAdmin] == 41)
    {
        SAM(COLOR_YELLOW, "Warning: %s has been autokicked for trying to ban a Community Owner(%s).", GetRPName(playerid), GetRPName(targetid));
        KickPlayer(playerid);
        return 1;
    }

    new TargetName[MAX_PLAYER_NAME];
    GetPlayerName(targetid, TargetName, sizeof(TargetName));

    Log_Write("log_punishments", "%s (uid: %i) banned %s (uid: %i), reason: %s", GetPlayerNameEx(playerid), pData[playerid][pID], TargetName, pData[targetid][pID], reason);
    SMA(COLOR_LIGHTRED, ""RED"AdmCmd: %s"WHITE" was permanently banned by %s, reason: %s", TargetName, GetRPName(playerid), reason);

    BanPlayer(targetid, GetPlayerNameEx(playerid), reason, 0);
    return 1;
}

CMD:banhours(playerid, params[])
{
    new playername[MAX_PLAYER_NAME], hours, reason[128];

    if(pData[playerid][pAdmin] < 40)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(sscanf(params, "s[24]is[128]", playername, hours, reason))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /banhours [PlayerName] [hours] [reason]");
    }
    if(hours <= 0)
    {
        return SCM(playerid, COLOR_SYNTAX, "Error: Hours must be greater than 0.");
    }

    new targetid = INVALID_PLAYER_ID;
    if(!sscanf(playername, "r", targetid) && targetid != INVALID_PLAYER_ID)
    {
        if(pData[targetid][pAdmin] > pData[playerid][pAdmin])
        {
            return SCM(playerid, COLOR_SYNTAX, "The player specified has a higher admin level than you.");
        }
        if(pData[targetid][pAdmin] == 41)
        {
            SAM(COLOR_YELLOW, "Warning: %s has been autokicked for trying to ban a Community Owner(%s).", GetRPName(playerid), GetRPName(targetid));
            KickPlayer(playerid);
            return 1;
        }

        Log_Write("log_punishments", "%s temp-banned %s (Online) for %i hours, reason: %s", GetPlayerNameEx(playerid), playername, hours, reason);
        SMA(COLOR_LIGHTRED, ""RED"AdmCmd: %s"WHITE" was banned by %s for %i hours, reason: %s", playername, GetRPName(playerid), hours, reason);

        BanPlayer(targetid, GetPlayerNameEx(playerid), reason, hours);
    }
    else
    {
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT username, ip FROM users WHERE username = '%e'", playername);
        mysql_tquery(connectionID, queryBuffer, "OnOfflineBanHours", "isisi", playerid, playername, hours, reason, 0);
    }
    return 1;
}

forward OnOfflineBanHours(playerid, username[], hours, reason[], step);
public OnOfflineBanHours(playerid, username[], hours, reason[], step)
{
    if(cache_get_row_count(connectionID))
    {
        new target_ip[16];
        cache_get_field_content(0, "ip", target_ip);

        Log_Write("log_punishments", "%s offline temp-banned %s for %i hours, reason: %s", GetPlayerNameEx(playerid), username, hours, reason);
        SMA(COLOR_LIGHTRED, ""RED"AdmCmd: %s (Offline)"WHITE" was banned by %s for %i hours, reason: %s", username, GetRPName(playerid), hours, reason);
        AddBan(username, target_ip, GetPlayerNameEx(playerid), reason, hours);

        SCMf(playerid, COLOR_YELLOW, "You have successfully offline temp-banned %s for %i hours.", username, hours);
    }
    else
    {
        SCM(playerid, COLOR_SYNTAX, "Error: That player name does not exist in the database.");
    }
    return 1;
}

CMD:unbanhours(playerid, params[])
{
    new playername[MAX_PLAYER_NAME];

    if(pData[playerid][pAdmin] < 40)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }
    if(sscanf(params, "s[24]", playername))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /unbanhours [Exact_RP_Name]");
    }

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "DELETE FROM bans WHERE username = '%e' AND permanent = 0", playername);
    mysql_tquery(connectionID, queryBuffer);

    Log_Write("log_punishments", "%s lifted temp-ban for player %s", GetPlayerNameEx(playerid), playername);
    SM(playerid, COLOR_YELLOW, "You have successfully unbanned %s (Temp-ban only).", playername);
    return 1;
}

