        return SAM(COLOR_RED, "%s HAD ZBI KIDIR GLITCH B /ADUTY!", GetRPName(playerid));
    }
    if(IsPlayerInAnyVehicle(playerid))
    {
        return SendClientMessage(playerid, COLOR_GREY, "You can't use this command from within the vehicle.");
