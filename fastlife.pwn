}


public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
    new cmdtext[128];
    format(cmdtext, sizeof(cmdtext), "/%s", cmd);
    // Cheat command
    if(cmdtext[0] == '.' || (cmdtext[0] == '/' && cmdtext[1] == '.') || strfind(cmdtext, "/.", false) == 0)
    {
        new string[256];
        format(string, sizeof(string), "[CHEAT] %s (ID: %d) attempted to use cheat command: %s", GetRPName(playerid), playerid, cmdtext);
        SendAdminMessage(COLOR_RED, string);
        print(string);

        KickPlayer(playerid);
        return 1;
    }

    // Discord CMD Log - ALL COMMANDS
    new dChat[512];

    format(dChat, sizeof(dChat), "```%s(%d) : %s```", GetName(playerid), playerid, cmdtext);
    DCC_SendChannelMessage(cmdlog, dChat);

    // Unknown command
    if(result == -1)
    {
        ShowError(playerid, "CMD 4ALAT A BRO");
        PlayerPlaySound(playerid, 1150, 0.0, 0.0, 0.0);
    }

    return 1;
}



public OnPlayerSendPacket(playerid, packetid)
{
    if(packetid == 215)
    {
        PacketFloodCount[playerid]++;
        if(PacketFloodCount[playerid] > 50)
        {
            Ban(playerid);
            printf("[Anti-Crash] Player %d banned for packet flood", playerid);
        }
    }
    return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{

new msg[256];
new name[MAX_PLAYER_NAME];
if(newkeys & KEY_YES)
    {
        new id = GetNearestDroppedItem(playerid, 3.0);
        if(id != -1)
        {
            new itemname[32];
            format(itemname, sizeof(itemname), "%s", DroppedItems[id][droppedItem]);

            new qty = DroppedItems[id][droppedQuantity];

            TakePlayerItem(playerid, id, itemname);

            new str[128];
            format(str, sizeof(str), "You picked up: %s [%dx]", itemname, qty);
            SCM(playerid, COLOR_GREEN, str);

            ApplyAnimation(playerid, "CARRY", "liftup", 4.1, false, false, false, false, 0, true);
        }
    }
    if((newkeys & KEY_YES))
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            foreach(new idx : Buttons)
            {
                if(ButtonData[idx][bDoorModel] && IsPlayerInRangeOfPoint(playerid, 1.5, ButtonData[idx][bPosX], ButtonData[idx][bPosY], ButtonData[idx][bPosZ]) && GetPlayerVirtualWorld(playerid) == ButtonData[idx][bWorld] && GetPlayerInterior(playerid) == ButtonData[idx][bInterior])
                {
                    if(ButtonData[idx][bFaction] != 0)
                    {
                        if(ButtonData[idx][bFaction] == FACTION_FEDERAL)
                        {
                            if(pData[playerid][pFaction] != FACTION_POLICE && pData[playerid][pFaction] != FACTION_GOVERNMENT)
                                return ShowError(playerid, "Ma 3ndkch L7a9 Dkhol!");
                        }
                        else
                        {
                            if(ButtonData[idx][bFaction] != pData[playerid][pFaction])
                                 return SendClientMessage(playerid, COLOR_GREY, "Ma 3ndkch L7a9 Dkhol!");
                        }
                    }

                    if(ButtonData[idx][bFamily] != -1)
                    {
                        if(ButtonData[idx][bFamily] != pData[playerid][pFamily])
                             return SendClientMessage(playerid, COLOR_GREY, "Ma 3ndkch L7a9 Dkhol!");
                    }

                    if(!ButtonData[idx][bDoorStatus])
                    {
                        ApplyAnimation(playerid, "HEIST9", "Use_SwipeCard", 10.0, false, false, false, false, 0, false);
                        ButtonData[idx][bDoorStatus] = 1;
                        MoveDynamicObject(ButtonData[idx][bDoorObject], ButtonData[idx][bDoorOpenX], ButtonData[idx][bDoorOpenY], ButtonData[idx][bDoorOpenZ], ButtonData[idx][bSpeed]);
                        SetDynamicObjectRot(ButtonData[idx][bDoorObject], ButtonData[idx][bDoorOpenRX], ButtonData[idx][bDoorOpenRY], ButtonData[idx][bDoorOpenRZ]);
                    }
                    else
                    {
                        ApplyAnimation(playerid, "HEIST9", "Use_SwipeCard", 10.0, false, false, false, false, 0, false);
                        ButtonData[idx][bDoorStatus] = 0;
                        MoveDynamicObject(ButtonData[idx][bDoorObject], ButtonData[idx][bDoorPosX], ButtonData[idx][bDoorPosY], ButtonData[idx][bDoorPosZ], ButtonData[idx][bSpeed]);
                        SetDynamicObjectRot(ButtonData[idx][bDoorObject], ButtonData[idx][bDoorPosRX], ButtonData[idx][bDoorPosRY], ButtonData[idx][bDoorPosRZ]);
                    }
                }
            }
        }
    }
    if(pData[playerid][pProgressType] != PROGRESS_NONE)
    {
        if(newkeys & KEY_YES)
        {
            CheckPlayerProgress(playerid, pData[playerid][pProgressType]);
            return 1;
        }
    }
   if(newkeys & KEY_CTRL_BACK && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		for(new i = 0; i < 51; i ++)
		{
			PlayerTextDrawShow(playerid, PANELHTD[playerid][i]);
		}
		SelectTextDraw(playerid,0x33AA33AA);
  	}
    if(newkeys & KEY_NO && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
    {
        for(new i = 0; i < 31; i++)
        {
            PlayerTextDrawShow(playerid, PANELVEHTD[playerid][i]);
        }

        SelectTextDraw(playerid, COLOR_BLUE);
        TogglePlayerControllable(playerid, 1);
        ShowActionBubble(playerid, "* %s Opening vehicle interaction panel.", GetRPName(playerid));
        pData[playerid][pLastPress] = gettime();
    }
    if(newkeys == KEY_NO)
    {
        if(IsPlayerInMeatArea(playerid))
        {
            if(pData[playerid][pGarbage] > 0)
            {
                return SendClientMessage(playerid, COLOR_GREY, "You're already doing a meat chop run!");
            }
            GameTextForPlayer(playerid,"~w~Chopping..",10000,6);
            pData[playerid][pGarbage] = 1;
            ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 1, 1, 0, 0);
            SetTimerEx("TimerGiveMeat", 10000, false, "i", playerid);
            return 1;
        }
    }
    if(newkeys & KEY_FIRE)
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            new victimid = GetClosestPlayer(playerid);

            if(IsAtChopPlace(playerid))
            {
                if(lumberman[playerid] != false)
                {
                    if(LumberJacking[playerid] == 1) return 1;
                    if(Lumber1[playerid] == 7) return 1;
                    if (PRESSED(KEY_FIRE))
                    {
                        ApplyAnimation(playerid,"CHAINSAW","CSAW_1",4.0, 1, 0, 0, 0, 0, 1);
                        LumberJacking[playerid] = 1;
                        SetTimerEx("StopAnim1", 800, 0, "i", playerid);
                    }
                }
            }
        }
    }
    if(newkeys & KEY_YES)
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            if(IsPlayerInRangeOfLocker(playerid, pData[playerid][pFaction]))
            {
                switch(FactionInfo[pData[playerid][pFaction]][fType])
                {
                    case FACTION_POLICE, FACTION_ARMY, FACTION_MEDIC, FACTION_FEDERAL, FACTION_FIREDEPT:
                    {
                        ShowPlayerDialog(playerid, DIALOG_FACTIONLOCKER, DIALOG_STYLE_LIST, "Locker", "Toggle duty\nEquipment\nUniforms", "Select", "Cancel");
                    }
                    case FACTION_GOVERNMENT, FACTION_NEWS:
                    {
                        ShowPlayerDialog(playerid, DIALOG_FACTIONLOCKER, DIALOG_STYLE_LIST, "Locker", "Equipment\nUniforms\nClothing", "Select", "Cancel");
                    }
                    case FACTION_MECHANIC:
                    {
