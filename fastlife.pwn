    case DIALOG_ANIM:
    {
        if(response)
        {
            switch(listitem)
            {
                case 0:
                {
                ApplyAnimationEx(playerid, "SHOP", "SHP_HandsUp_Scr", 4.1, 0, 0, 0, 1, 0);
                pData[playerid][pHandsUp] = 1;
                SCM(playerid, COLOR_GREEN, "You have put your hands up!");

                SetTimerEx("ResetHandsUp", 100000, false, "i", playerid);
                }
                case 1:
                {
                    ApplyAnimationEx(playerid, "SWAT", "gnstwall_injurd", 4.1, 1, 0, 0, 0, 0);
                }
                case 2:
                {
                    ApplyAnimationEx(playerid, "PED", "WALK_gang1", 4.1, 1, 1, 1, 1, 1);
                }
                case 3:
                {
                    ApplyAnimationEx(playerid, "BEACH", "ParkSit_M_loop", 4.1, 1, 0, 0, 0, 0);
                }
                case 4:
                {
                    ApplyAnimationEx(playerid, "COP_AMBIENT", "Coplook_loop", 4.1, 1, 0, 0, 0, 0);
                }
                case 5:
                {
                    ApplyAnimationEx(playerid, "PED", "endchat_03", 4.1, 0, 0, 0, 0, 0);
                }
                case 6:
                {
                    ApplyAnimationEx(playerid, "CRACK", "crckdeth4", 4.0, 0, 1, 1, 1, 0);
                }
                case 7:
                {
                    ApplyAnimationEx(playerid, "DANCING", "DAN_Down_A", 4.1, 1, 0, 0, 0, 0);
                }
                case 8:
                {
                    ClearAnimations(playerid, 1);
                    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 1);
                }
            }
        }
        return 1;
    }
case DIALOG_GUN:
{
    if(response)
    {
        // ========== 0. Blindfold (5000 Cash) ==========
        if(listitem == 0)
        {
            if(pData[playerid][pCash] < 5000)
                return SCM(playerid, COLOR_SYNTAX, "You Don't Have 5000 Cash!");
            if(pData[playerid][pBlindfold] > 0)
                return SCM(playerid, COLOR_SYNTAX, "You have a Blindfold already.");

            ApplyActorAnimation(CRFTTA, "DEALER", "shop_pay", 4.1, 0, 0, 0, 0, 0);
            SetTimer("StopActorAnim", 3000, 0);

            pData[playerid][pCash] -= 5000;
            pData[playerid][pBlindfold] = 1;
            SCM(playerid, COLOR_DARKAQUA, "HA HIYA BLINDFOLD ATKAYS 3LA BNADM /BLINDFOLD");
            ShowItemBox(playerid, "Blindfold", "+1", 18900, 4); // ID 18900 ?????? ??????

            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
                "UPDATE users SET cash = %i, blindfold = %i WHERE uid = %i",
                pData[playerid][pCash], pData[playerid][pBlindfold], pData[playerid][pID]);
            mysql_tquery(connectionID, queryBuffer);
        }

        // ========== 1. Shovel (10000 Cash) ==========
        if(listitem == 1)
        {
            if(pData[playerid][pCash] < 10000)
                return SCM(playerid, COLOR_SYNTAX, "You Don't Have 10000 Cash!");
            if(PlayerHasWeapon(playerid, 6))
                return SCM(playerid, COLOR_SYNTAX, "Bro 3andak Had Slah!");

            ApplyActorAnimation(CRFTTA, "DEALER", "shop_pay", 4.1, 0, 0, 0, 0, 0);
            SetTimer("StopActorAnim", 3000, 0);

            GivePlayerWeapon(playerid, 6, 1);
            pData[playerid][pCash] -= 10000;
            SCM(playerid, COLOR_DARKAQUA, "RDITI LBALA 3NDAK TKRT LKABINA");
            ShowItemBox(playerid, "Shovel", "+1", 18901, 4); // ID 18901 ?????

            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
                "UPDATE users SET cash = %i WHERE uid = %i",
                pData[playerid][pCash], pData[playerid][pID]);
            mysql_tquery(connectionID, queryBuffer);
        }

        // ========== 2. Bat (15000 Cash) ==========
        if(listitem == 2)
        {
            if(pData[playerid][pCash] < 15000)
                return SCM(playerid, COLOR_SYNTAX, "You Don't Have 15000 Cash!");
            if(PlayerHasWeapon(playerid, 5))
                return SCM(playerid, COLOR_SYNTAX, "Bro 3andak Had Slah!");

            ApplyActorAnimation(CRFTTA, "DEALER", "shop_pay", 4.1, 0, 0, 0, 0, 0);
            SetTimer("StopActorAnim", 3000, 0);

            GivePlayerWeapon(playerid, 5, 1);
            pData[playerid][pCash] -= 15000;
            SCM(playerid, COLOR_DARKAQUA, "HA HIYA LBAT ATKAYS 3LA 3BD L9ADR");
            ShowItemBox(playerid, "Baseball Bat", "+1", 18902, 4); // ID 18902 ?????

            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
                "UPDATE users SET cash = %i WHERE uid = %i",
                pData[playerid][pCash], pData[playerid][pID]);
            mysql_tquery(connectionID, queryBuffer);
        }

        // ========== 3. Katana (20000 Cash) ==========
        if(listitem == 3)
        {
            if(pData[playerid][pCash] < 20000)
                return SCM(playerid, COLOR_SYNTAX, "You Don't Have 20000 Cash!");
            if(PlayerHasWeapon(playerid, 8))
                return SCM(playerid, COLOR_SYNTAX, "Bro 3andak Had Slah!");

            ApplyActorAnimation(CRFTTA, "DEALER", "shop_pay", 4.1, 0, 0, 0, 0, 0);
            SetTimer("StopActorAnim", 3000, 0);

            GivePlayerWeapon(playerid, 8, 1);
            pData[playerid][pCash] -= 20000;
            SCM(playerid, COLOR_DARKAQUA, "NARIII KATANA 9WDOHA");
            ShowItemBox(playerid, "Katana", "+1", 18903, 4); // ID 18903 ????????

            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
                "UPDATE users SET cash = %i WHERE uid = %i",
                pData[playerid][pCash], pData[playerid][pID]);
            mysql_tquery(connectionID, queryBuffer);
        }

        // ========== 4. Lockpick (25000 Cash) ==========
        if(listitem == 4)
        {
            if(pData[playerid][pCash] < 25000)
                return SCM(playerid, COLOR_SYNTAX, "You Don't Have 25000 Cash!");
            if(pData[playerid][pLockpick] > 0)
                return SCM(playerid, COLOR_SYNTAX, "You have a Lockpick already.");

            ApplyActorAnimation(CRFTTA, "DEALER", "shop_pay", 4.1, 0, 0, 0, 0, 0);
            SetTimer("StopActorAnim", 3000, 0);

