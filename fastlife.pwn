stock IsPlayerNearAtmMachine(playerid)
{
    for(new i = 0; i < sizeof(AtmInfo); i++)
    {
        if(IsPlayerInRangeOfPoint(playerid, 3.0, AtmInfo[i][aPosX], AtmInfo[i][aPosY], AtmInfo[i][aPosZ]))
        {
            return 1;
        }
    }
    return 0;
}
stock CheckCode(playerid)
{
    if(InputCount[playerid] < MAX_DIGITS) return;

    new correctPlace = 0;
    pData[playerid][pRobCooldown] = gettime() + (30 * 60);

    for(new i=0;i<MAX_DIGITS;i++)
    {
        new found = 0;

        if(PlayerInput[playerid][i] == RobCode[playerid][i])
        {
            TextDrawColor(ROBSTPRO[2+i], COLOR_GREEN);
            correctPlace++;
        }
        else
        {
            for(new j=0;j<MAX_DIGITS;j++)
            {
                if(PlayerInput[playerid][i] == RobCode[playerid][j])
                {
                    found = 1;
                    break;
                }
            }

            if(found)
                TextDrawColor(ROBSTPRO[2+i], COLOR_YELLOW);
            else
                TextDrawColor(ROBSTPRO[2+i], COLOR_RED);
        }

        TextDrawShowForPlayer(playerid, ROBSTPRO[2+i]);
    }

    if(correctPlace == MAX_DIGITS)
    {
        ShowSucces(playerid, "The safe has been hacked");

        new random_prize = random(4);

        switch(random_prize)
        {
            case 0:
            {
                pData[playerid][pWatch] += 1;
                ShowItemBox(playerid, "Watch", "+1", 18867, 4);
                SCM(playerid, COLOR_GREEN, "You found a luxury watch worth selling!");

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET watch = %d WHERE uid = %d", pData[playerid][pWatch], pData[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);
            }
            case 1:
            {
                pData[playerid][pusb] += 1;
                ShowItemBox(playerid, "USB", "+1", 11737, 4);
                SCM(playerid, COLOR_GREEN, "You found a USB drive! Use it for another robbery.");

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET usb = %d WHERE uid = %d", pData[playerid][pusb], pData[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);
            }
            case 2:
            {
                pData[playerid][pDirtyCash] += 500;
                ShowItemBox(playerid, "Dirty Cash", "+$500", 1212, 4);
                SCM(playerid, COLOR_GREEN, "You found $500 in dirty cash!");

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET dirtycash = %d WHERE uid = %d", pData[playerid][pDirtyCash], pData[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);
            }
        }

        ClearAnimations(playerid);
        TogglePlayerControllable(playerid, 1);
        SetPlayerAttachedObject(playerid, 9, 1550, 1, 0.116999, -0.170999, -0.016000, -3.099997, 87.800018, -179.400009, 0.602000, 0.640000, 0.625000, 0, 0);
        SetTimerEx("CloseRobUI", 5000, false, "d", playerid);
        return;
    }

    SetTimerEx("ResetInput", 2000, false, "d", playerid);
}
stock ContainsIPAddress(const text[])
{
    new dots = 0;
    new numbers = 0;
    new len = strlen(text);

    for(new i = 0; i < len; i++)
    {
        if(text[i] == '.')
        {
            dots++;
            numbers = 0;
        }
        else if('0' <= text[i] <= '9')
        {
            numbers++;
            if(numbers > 3) numbers = 0;
        }
        else
        {
            dots = 0;
            numbers = 0;
        }

        if(dots >= 3)
        {
            return 1;
        }
    }
    return 0;
}

forward DelayedKick(playerid);
public DelayedKick(playerid)
{
    if(IsPlayerConnected(playerid))
    {
        Kick(playerid);
    }
    return 1;
}

forward ResetInput(playerid);
public ResetInput(playerid)
{
    if(!IsRobbing[playerid]) return 1;

    InputCount[playerid] = 0;

    for(new i=0;i<MAX_DIGITS;i++)
    {
        PlayerInput[playerid][i] = -1;
        TextDrawSetString(ROBSTPRO[2+i], "_");
        TextDrawColor(ROBSTPRO[2+i], COLOR_WHITE);
        TextDrawShowForPlayer(playerid, ROBSTPRO[2+i]);
    }

    return 1;
}

forward CloseRobUI(playerid);
public CloseRobUI(playerid)
{
    if(!IsRobbing[playerid]) return 1;

    for(new i=0;i<32;i++)
        TextDrawHideForPlayer(playerid, ROBSTPRO[i]);

    CancelSelectTextDraw(playerid);
    IsRobbing[playerid] = false;
    InputCount[playerid] = 0;

    return 1;
}

forward CheckLobbyTime(playerid);
public CheckLobbyTime(playerid)
{
    if(!IsPlayerConnected(playerid)) return 0;

    if(pData[playerid][pLogged] == 1)
    {
        KillTimer(pData[playerid][pLobbyTimer]);
        pData[playerid][pLobbyTimer] = 0;
        return 1;
    }

    new elapsed = gettime() - pData[playerid][pLobbyTime];
    new remaining = g_LobbyTimeLimit - elapsed;

    if(remaining <= 0)
    {
        new msg[128];
        format(msg, sizeof(msg), "You were kicked for staying in lobby for more than %d seconds without logging in.", g_LobbyTimeLimit);
        SendClientMessage(playerid, COLOR_RED, msg);

        printf("[SECURITY] %s (ID: %d) was kicked for lobby timeout (%d seconds)",
            GetPlayerNameEx(playerid), playerid, elapsed);

        Kick(playerid);
        return 1;
    }
    else if(remaining <= 10)
    {
        new msg[128];
        format(msg, sizeof(msg), "You have %d seconds to login before being kicked!", remaining);
        SendClientMessage(playerid, COLOR_RED, msg);
    }

    return 1;
}

