                PlayerHasWeapon(playerid, 8);
                pData[playerid][pCopper] -= 250;
                pData[playerid][pPlactic] -= 250;
                pData[playerid][pSteel] -= 250;
                pData[playerid][pMetalScrap] -= 250;

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET plactic = %i WHERE uid = %i", pData[playerid][pPlactic], pData[playerid][pID]);
