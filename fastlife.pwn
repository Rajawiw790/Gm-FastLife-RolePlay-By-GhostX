        mysql_tquery(connectionID, queryBuffer);

        SM(targetid, COLOR_AQUA, "%s has given you %i handcuff.", GetRPName(playerid), amount);
        SM(playerid, COLOR_AQUA, "You have given %i handcuff to %s.", amount, GetRPName(targetid));

