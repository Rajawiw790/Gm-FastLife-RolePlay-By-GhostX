            if (pData[playerid][pAdminDuty])
            {
                    format( msg, sizeof(msg), "[Anti-cheat]: [%s] (%d) KIDIR GLITCH", name, playerid);
                    SendAdminMessage(COLOR_BLUE, msg);
                    return 1;
            }
            if (pData[playerid][pFaction] >= 0)
            {
                return SCM(playerid, COLOR_GREY, "You cannot use this command while in a faction.");
            }
            ShowDialogToPlayer(playerid, DIALOG_GANGSTASH);
            }
        }
    }
	return 1;
}



public OnPlayerStateChange(playerid, newstate, oldstate)
{
    if(pData[playerid][pKicked]) return 0;
    if(newstate == PLAYER_STATE_DRIVER) {
        pvehicleid[playerid] = GetPlayerVehicleID(playerid);
        pmodelid[playerid] = GetVehicleModel(pvehicleid[playerid]);
    } else {
        pvehicleid[playerid] = 0;
        pmodelid[playerid] = 0;
    }
    if (IsLawEnforcement(playerid) && newstate == PLAYER_STATE_DRIVER)
    {
        PlayerTextDrawShow(playerid, Zonetd[playerid][0]);
    }
    else
    {
        PlayerTextDrawHide(playerid, Zonetd[playerid][0]);
    }

     if(pData[playerid][pInsideRental] == 1 &&
       oldstate == PLAYER_STATE_DRIVER &&
       newstate == PLAYER_STATE_ONFOOT)
    {
        new vehicleid = pData[playerid][pRentedVehicle];

        if(IsValidVehicle(vehicleid))
        {
            DestroyVehicle(vehicleid);
        }


        pData[playerid][pInsideRental] = 0;
        pData[playerid][pRentedVehicle] = 0;


        if(pData[playerid][pRentTimer] != -1)
        {
            KillTimer(pData[playerid][pRentTimer]);
            pData[playerid][pRentTimer] = -1;
        }

        SendClientMessage(playerid, COLOR_RED, "You left your rented motor! It has been removed.");
    }

    if(newstate == PLAYER_STATE_DRIVER)
    {
        new vehicleid = GetPlayerVehicleID(playerid);
        if((LSPDVehicles[0] <= vehicleid <= LSPDVehicles[1]) && !IsLawEnforcement(playerid))
        {
            SCM(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as you are not a Police Officer.");
            ClearAnimations(playerid);
        }
        if((VIPVehicles[0] <= vehicleid <= VIPVehicles[49]) && !pData[playerid][pVIPPackage])
        {
            SCM(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as you are not a Donator.");
            RemovePlayerFromVehicle(playerid);
        }
        if((OilExpoVehicle[0] <= vehicleid <= OilExpoVehicle[6]) && !PlayerHasJob(playerid, JOB_OILEXPO))
	    {
	        SCM(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as you are not a oil expo.");
	        RemovePlayerFromVehicle(playerid);
	    }
        if((EMSVehicles[0] <= vehicleid <= EMSVehicles[3]) && GetFactionType(playerid) != FACTION_MEDIC && GetFactionType(playerid) != FACTION_FIREDEPT)
        {
            SCM(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as you are not a Police Officer.");
            ClearAnimations(playerid);
        }
        if((towtruck[0] <= vehicleid <= towtruck[2]) && (FactionInfo[pData[playerid][pFaction]][fType] != FACTION_MECHANIC))
        {
            SCM(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as you are not a Mechanic.");
            RemovePlayerFromVehicle(playerid);
        }
        if((testVehicles[0] <= vehicleid <= testVehicles[1]) && !pData[playerid][pDrivingTest])
        {
            SCM(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as you are not taking your drivers test.");
            RemovePlayerFromVehicle(playerid);
            return 1;
        }
        if(VehicleInfo[vehicleid][vFactionType] != FACTION_NONE && GetFactionType(playerid) != VehicleInfo[vehicleid][vFactionType])
        {
            SendClientMessage(playerid, COLOR_GREY, "You cannot operate this vehicle as it doesn't belong to your faction.");
            RemovePlayerFromVehicle(playerid);
            return 1;
        }

         if(VehicleInfo[vehicleid][vGang] >= 0 && pData[playerid][pGang] != VehicleInfo[vehicleid][vGang])
        {
            SCM(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as it doesn't belong to your gang.");
            RemovePlayerFromVehicle(playerid);
            return 1;
        }
        if(VehicleInfo[vehicleid][vFactionType] != 0 && GetFactionType(playerid) != VehicleInfo[vehicleid][vFactionType])
        {
            SendClientMessage(playerid, COLOR_GREY, "This vehicle belongs to another faction.");
            RemovePlayerFromVehicle(playerid);
            return 1;
        }

        if(VehicleInfo[vehicleid][vGang] >= 0 && pData[playerid][pGang] != VehicleInfo[vehicleid][vGang])
        {
            SCM(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as it doesn't belong to your gang.");
            RemovePlayerFromVehicle(playerid);
            return 1;
        }

        if(VehicleInfo[vehicleid][vJob] >= 0 && pData[playerid][pJob] != VehicleInfo[vehicleid][vJob])
        {
            SM(playerid, COLOR_SYNTAX, "You cannot operate this vehicle as you are not a %s.", GetJobName(VehicleInfo[vehicleid][vJob]));
            RemovePlayerFromVehicle(playerid);
            return 1;
        }
        if(!VehicleHasEngine(vehicleid))
        {
            SetVehicleParams(vehicleid, VEHICLE_ENGINE, true);
        }
        else if(!GetVehicleParams(vehicleid, VEHICLE_ENGINE))
        {
            if(testVehicles[0] <= vehicleid <= testVehicles[1])
            {
                pData[playerid][pCP] = CHECKPOINT_TEST;
                pData[playerid][pTestVehicle] = vehicleid;
                pData[playerid][pTestCP] = 0;

                SetVehicleParams(vehicleid, VEHICLE_ENGINE, true);
                SetPlayerCheckpoint(playerid, drivingTestCPs[pData[playerid][pTestCP]][0], drivingTestCPs[pData[playerid][pTestCP]][1], drivingTestCPs[pData[playerid][pTestCP]][2], 3.0);
                SCM(playerid, COLOR_AQUA, "Drive through the checkpoints to proceed with the test. Try not to damage your vehicle.");
            }
            else
            {
                //SCM(playerid, COLOR_YELLOW, "You can toggle the vehicle engine by pressing [N] or typing /engine.");
            }
        }
        if(!pData[playerid][pCarLicense] && !pData[playerid][pDrivingTest])
        {
            SendClientMessage(playerid, COLOR_RED, "[!]Warning:"WHITE" You didn't take an exam for Driving License beware of cops");
        }
        if(IsVehicleOwner(playerid, vehicleid) && VehicleInfo[vehicleid][vTickets] > 0)
        {
            SM(playerid, COLOR_AQUA, "This vehicle has $%i in unpaid tickets. You can pay your tickets using /paytickets in LTO.", VehicleInfo[vehicleid][vTickets]);
        }
        if(pData[playerid][pHBEMode] == 1)
        {
            new Float:fFuel;
            new Float:bensinbar;
            fFuel = float(vehicleFuel[vehicleid]);

            for(new i = 0; i < 65; i++)
            {
                PlayerTextDrawShow(playerid, speedoBaru[playerid][i]);
            }

            if(fFuel < 0) fFuel = 0;
            else if(fFuel > 100) fFuel = 100;

            bensinbar = fFuel * -38.000 / 100;
            PlayerTextDrawTextSize(playerid, speedoBaru[playerid][64], 3.000, bensinbar);
            PlayerTextDrawShow(playerid, speedoBaru[playerid][64]);
        }

        if(VehicleHasEngine(vehicleid) && vehicleFuel[vehicleid] <= 0)
        {
            Dyuze(playerid, "Notice", "~b~Out of fuel");
        }

        SetPlayerArmedWeapon(playerid, 0);
    }
    else if(oldstate == PLAYER_STATE_DRIVER)
    {
        if(pData[playerid][pDrivingTest])
        {
            pData[playerid][pDrivingTest] = 0;
            SetVehicleToRespawn(pData[playerid][pTestVehicle]);
            SCM(playerid, COLOR_LIGHTRED, "** You have exited the vehicle and therefore failed the test.");
        }

        if(pData[playerid][pHBEMode] == 1)
        {
            for(new i = 0; i < 65; i++)
            {
                PlayerTextDrawHide(playerid, speedoBaru[playerid][i]);
            }
        }
    }

    else if(newstate == PLAYER_STATE_PASSENGER)
    {
        new driverid = GetVehicleDriver(GetPlayerVehicleID(playerid));
        if((driverid != INVALID_VEHICLE_ID && pData[driverid][pTaxiFare] > 0 && pData[driverid][pTaxiPassenger] == INVALID_PLAYER_ID) && (GetVehicleModel(GetPlayerVehicleID(playerid)) == 420 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 438))
        {
            if(pData[playerid][pCash] < pData[driverid][pTaxiFare])
            {
                SCM(playerid, COLOR_SYNTAX, "You can't afford to pay the fare. Therefore you can't ride this taxi.");
                RemovePlayerFromVehicle(playerid);
                return 1;
            }

            pData[driverid][pTaxiPassenger] = playerid;
            pData[driverid][pTaxiBill] = pData[driverid][pTaxiFare];
            pData[driverid][pTaxiTime] = 0;

            SendProximityMessage(playerid, 20.0, SERVER_COLOR1, "**{C2A2DA} %s enters %s's taxi cab.", GetRPName(playerid), GetRPName(driverid));
            SM(playerid, COLOR_YELLOW, "You will be charged the fare price of "SVRCLR"$%i{CCFFFF} every 15 seconds during your ride.", pData[driverid][pTaxiFare]);
            SM(driverid, COLOR_AQUA, "*%s has entered your taxi. You will earn $%i every 15 seconds during the ride.", GetRPName(playerid), pData[driverid][pTaxiFare]);
        }

        switch(GetPlayerWeapon(playerid))
        {
            case 22, 28, 29, 32:
            SetPlayerArmedWeapon(playerid, GetScriptWeapon(playerid));
            default:
            SetPlayerArmedWeapon(playerid, 0);
        }
    }

    if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
    {
        new vehicleid = GetPlayerVehicleID(playerid);

        foreach(new i : Player)
        {
            if(GetPlayerState(i) == PLAYER_STATE_SPECTATING && pData[i][pSpectating] == playerid)
            {
                PlayerSpectateVehicle(i, vehicleid);
            }
        }

        if(!isnull(vehicleStream[vehicleid]) && pData[playerid][pStreamType] == MUSIC_NONE && !pData[playerid][pToggleMusic])
        {
            pData[playerid][pStreamType] = MUSIC_VEHICLE;
            PlayAudioStreamForPlayer(playerid, vehicleStream[vehicleid]);
            SCM(playerid, COLOR_WHITE, "** You are now tuned in to this vehicle's radio. /stopmusic to stop listening.");
        }
    }

    else if(oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER)
    {
        foreach(new i : Player)
        {
            if(GetPlayerState(i) == PLAYER_STATE_SPECTATING && pData[i][pSpectating] == playerid)
            {
                PlayerSpectatePlayer(i, playerid);
            }
        }

        if(pData[playerid][pStreamType] == MUSIC_VEHICLE)
        {
            StopAudioStreamForPlayer(playerid);
            pData[playerid][pStreamType] = MUSIC_NONE;
        }
    }

    return 1;
}

public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
	if(!(-3.0 <= fScaleX <= 3.0)) fScaleX = fScaleX < -3.0 ? 0.0 : 3.0;
	if(!(-3.0 <= fScaleY <= 3.0)) fScaleY = fScaleY < -3.0 ? 0.0 : 3.0;
	if(!(-3.0 <= fScaleZ <= 3.0)) fScaleZ = fScaleZ < -3.0 ? 0.0 : 3.0;

	switch(pData[playerid][pEditType])
	{
	    case EDIT_CLOTHING_PREVIEW:
	    {
	        RemovePlayerAttachedObject(playerid, 9);

	        if(response)
	        {
	            new businessid = GetInsideBusiness(playerid);

	            if(businessid >= 0 && BusinessInfo[businessid][bType] == BUSINESS_CLOTHES)
	            {
	                if(BusinessInfo[businessid][bProducts] <= 0)
	                {
	                    return SCM(playerid, COLOR_SYNTAX, "This business is out of stock now.");
					}
	                if(pData[playerid][pCash] < BusinessInfo[businessid][bPrices][1])
	                {
	                    return SCM(playerid, COLOR_SYNTAX, "You couldn't afford to purchase this item.");
	                }

	                for(new i = 0; i < MAX_PLAYER_CLOTHING; i ++)
	                {
	                    if(!ClothingInfo[playerid][i][cExists])
	                    {
	                        ClothingInfo[playerid][i][cModel] = modelid;
	                        ClothingInfo[playerid][i][cBone] = boneid;
	                        ClothingInfo[playerid][i][cPosX] = fOffsetX;
	                        ClothingInfo[playerid][i][cPosY] = fOffsetY;
	                        ClothingInfo[playerid][i][cPosZ] = fOffsetZ;
	                        ClothingInfo[playerid][i][cRotX] = fRotX;
	                        ClothingInfo[playerid][i][cRotY] = fRotY;
	                        ClothingInfo[playerid][i][cRotZ] = fRotZ;
	                        ClothingInfo[playerid][i][cScaleX] = fScaleX;
	                        ClothingInfo[playerid][i][cScaleY] = fScaleY;
	                        ClothingInfo[playerid][i][cScaleZ] = fScaleZ;

	                        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO clothing VALUES(null, %i, '%e', %i, %i, 0, '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f', '%f')", pData[playerid][pID], clothingArray[pData[playerid][pSelected]][clothingName], modelid, boneid, fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ);
							mysql_tquery(connectionID, queryBuffer, "OnPlayerBuyClothingItem", "isiii", playerid, clothingArray[pData[playerid][pSelected]][clothingName], BusinessInfo[businessid][bPrices][1], businessid, i);
							return 1;
						}
					}

					SCM(playerid, COLOR_SYNTAX, "You have no more clothing slots available. Therefore you can't buy this.");
	            }
	        }
	        else
	        {
	            ShowDialogToPlayer(playerid, DIALOG_BUYCLOTHING);
			}
		}
		case EDIT_CLOTHING:
		{
		    new clothingid = pData[playerid][pSelected];

		    if(response)
		    {
		        ClothingInfo[playerid][clothingid][cPosX] = fOffsetX;
		        ClothingInfo[playerid][clothingid][cPosY] = fOffsetY;
		        ClothingInfo[playerid][clothingid][cPosZ] = fOffsetZ;
		        ClothingInfo[playerid][clothingid][cRotX] = fRotX;
		        ClothingInfo[playerid][clothingid][cRotY] = fRotY;
		        ClothingInfo[playerid][clothingid][cRotZ] = fRotZ;
		        ClothingInfo[playerid][clothingid][cScaleX] = fScaleX;
		        ClothingInfo[playerid][clothingid][cScaleY] = fScaleY;
		        ClothingInfo[playerid][clothingid][cScaleZ] = fScaleZ;

		        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE clothing SET pos_x = '%f', pos_y = '%f', pos_z = '%f', rot_x = '%f', rot_y = '%f', rot_z = '%f', scale_x = '%f', scale_y = '%f', scale_z = '%f' WHERE id = %i", fOffsetX, fOffsetY, fOffsetZ, fRotX, fRotY, fRotZ, fScaleX, fScaleY, fScaleZ, ClothingInfo[playerid][clothingid][cID]);
		        mysql_tquery(connectionID, queryBuffer);

		        SM(playerid, COLOR_SYNTAX, "Changes saved.");
		    }

			if(!ClothingInfo[playerid][clothingid][cAttached])
	        {
	            RemovePlayerAttachedObject(playerid, 9);
			}
			else
			{
			    RemovePlayerAttachedObject(playerid, ClothingInfo[playerid][clothingid][cAttachedIndex]);
			    SetPlayerAttachedObject(playerid, ClothingInfo[playerid][clothingid][cAttachedIndex], ClothingInfo[playerid][clothingid][cModel], ClothingInfo[playerid][clothingid][cBone], ClothingInfo[playerid][clothingid][cPosX], ClothingInfo[playerid][clothingid][cPosY], ClothingInfo[playerid][clothingid][cPosZ],
					ClothingInfo[playerid][clothingid][cRotX], ClothingInfo[playerid][clothingid][cRotY], ClothingInfo[playerid][clothingid][cRotZ], ClothingInfo[playerid][clothingid][cScaleX], ClothingInfo[playerid][clothingid][cScaleY], ClothingInfo[playerid][clothingid][cScaleZ]);
			}
		}
	}

    return 1;
}

public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
    if(response == EDIT_RESPONSE_FINAL)
    {
        if (pData[playerid][pEditGraffiti] != -1 && GraffitiData[pData[playerid][pEditGraffiti]][graffitiExists])
        {
            GraffitiData[pData[playerid][pEditGraffiti]][graffitiPos][0] = x;
            GraffitiData[pData[playerid][pEditGraffiti]][graffitiPos][1] = y;
            GraffitiData[pData[playerid][pEditGraffiti]][graffitiPos][2] = z;
            GraffitiData[pData[playerid][pEditGraffiti]][graffitiPos][3] = rz;

            Graffiti_Refresh(pData[playerid][pEditGraffiti]);
            Graffiti_Save(pData[playerid][pEditGraffiti]);
        }
        else if (pData[playerid][pEditGate] != -1 && GateData[pData[playerid][pEditGate]][gateExists])
        {
            switch (pData[playerid][pEditType])
            {
                case 1:
                {
                    new id = pData[playerid][pEditGate];

                    GateData[pData[playerid][pEditGate]][gatePos][0] = x;
                    GateData[pData[playerid][pEditGate]][gatePos][1] = y;
                    GateData[pData[playerid][pEditGate]][gatePos][2] = z;
                    GateData[pData[playerid][pEditGate]][gatePos][3] = rx;
                    GateData[pData[playerid][pEditGate]][gatePos][4] = ry;
                    GateData[pData[playerid][pEditGate]][gatePos][5] = rz;

                    DestroyDynamicObject(GateData[id][gateObject]);
                    GateData[id][gateObject] = CreateDynamicObject(GateData[id][gateModel], GateData[id][gatePos][0], GateData[id][gatePos][1], GateData[id][gatePos][2], GateData[id][gatePos][3], GateData[id][gatePos][4], GateData[id][gatePos][5], GateData[id][gateWorld], GateData[id][gateInterior]);

                    Gate_Save(id);
                    SM(playerid, COLOR_WHITE, "You have edited the position of gate ID: %d.", id);
                }
                case 2:
                {
                    new id = pData[playerid][pEditGate];

                    GateData[pData[playerid][pEditGate]][gateMove][0] = x;
                    GateData[pData[playerid][pEditGate]][gateMove][1] = y;
                    GateData[pData[playerid][pEditGate]][gateMove][2] = z;
                    GateData[pData[playerid][pEditGate]][gateMove][3] = rx;
                    GateData[pData[playerid][pEditGate]][gateMove][4] = ry;
                    GateData[pData[playerid][pEditGate]][gateMove][5] = rz;

                    DestroyDynamicObject(GateData[id][gateObject]);
                    GateData[id][gateObject] = CreateDynamicObject(GateData[id][gateModel], GateData[id][gatePos][0], GateData[id][gatePos][1], GateData[id][gatePos][2], GateData[id][gatePos][3], GateData[id][gatePos][4], GateData[id][gatePos][5], GateData[id][gateWorld], GateData[id][gateInterior]);

                    Gate_Save(id);
                    SM(playerid, COLOR_WHITE, "You have edited the moving position of gate ID: %d.", id);
                }
            }
        }
    }
    switch(pData[playerid][pEditType])
    {
        case EDIT_FURNITURE_PREVIEW:
        {
            if(response != EDIT_RESPONSE_UPDATE)
            {
                DestroyDynamicObject(pData[playerid][pEditObject]);
                pData[playerid][pEditObject] = INVALID_OBJECT_ID;

                if(response == EDIT_RESPONSE_FINAL)
                {
                    new houseid = GetInsideHouse(playerid);

                    if(houseid >= 0 && HasFurniturePerms(playerid, houseid))
                    {
                        if(pData[playerid][pCash] < furnitureArray[pData[playerid][pSelected]][fPrice])
                        {
                            return SCM(playerid, COLOR_SYNTAX, "You couldn't afford to purchase this item.");
                        }

                        new
                        string[16];

                        GivePlayerCash(playerid, -furnitureArray[pData[playerid][pSelected]][fPrice]);

                        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "INSERT INTO furniture VALUES(null, %i, %i, '%e', %i, '%f', '%f', '%f', '%f', '%f', '%f', %i, %i, 0, 0)", HouseInfo[houseid][hID], furnitureArray[pData[playerid][pSelected]][fModel], furnitureArray[pData[playerid][pSelected]][fName], furnitureArray[pData[playerid][pSelected]][fPrice], x, y, z, rx, ry, rz, HouseInfo[houseid][hInterior], HouseInfo[houseid][hWorld]);
                        mysql_tquery(connectionID, queryBuffer);
                        mysql_tquery(connectionID, "SELECT * FROM furniture WHERE id = LAST_INSERT_ID()", "OnQueryFinished", "ii", THREAD_LOAD_FURNITURE, HouseInfo[houseid][hLabels]);

                        format(string, sizeof(string), "~r~-$%i", furnitureArray[pData[playerid][pSelected]][fPrice]);
                        GameTextForPlayer(playerid, string, 5000, 1);

                        if(!strcmp(furnitureArray[pData[playerid][pSelected]][fCategory], "Doors & Gates"))
                        {
                            SCM(playerid, COLOR_WHITE, "** You can use /lopen to control your door and /lock to unlock or lock it.");
                        }
                    }
                }
                else if(response == EDIT_RESPONSE_CANCEL)
                {
                    ShowDialogToPlayer(playerid, DIALOG_BUYFURNITURE2);
                }
            }
        }
        case EDIT_FURNITURE:
        {
            if(response != EDIT_RESPONSE_UPDATE)
            {
                if(response == EDIT_RESPONSE_FINAL)
                {
                    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE furniture SET pos_x = '%f', pos_y = '%f', pos_z = '%f', rot_x = '%f', rot_y = '%f', rot_z = '%f' WHERE id = %i", x, y, z, rx, ry, rz, Streamer_GetExtraInt(objectid, E_OBJECT_INDEX_ID));
                    mysql_tquery(connectionID, queryBuffer);
                    SCM(playerid, COLOR_SYNTAX, "Changes saved.");
                }

                ReloadFurniture(objectid, HouseInfo[pData[playerid][pFurnitureHouse]][hLabels]);
            }
        }
        case EDIT_OBJECT_PREVIEW:
        {
            if(response == EDIT_RESPONSE_FINAL)
            {
                if (pData[playerid][pEditmObject] != -1 && ObjectData[pData[playerid][pEditmObject]][mobjExists])
                {
                    new string[48];
                    new id = pData[playerid][pEditmObject];
                    ObjectData[pData[playerid][pEditmObject]][mobjPos][0] = x;
                    ObjectData[pData[playerid][pEditmObject]][mobjPos][1] = y;
                    ObjectData[pData[playerid][pEditmObject]][mobjPos][2] = z;
                    ObjectData[pData[playerid][pEditmObject]][mobjPos][3] = rx;
                    ObjectData[pData[playerid][pEditmObject]][mobjPos][4] = ry;
                    ObjectData[pData[playerid][pEditmObject]][mobjPos][5] = rz;

                    DestroyDynamicObject(ObjectData[id][mobjObject]);
                    ObjectData[id][mobjObject] = CreateDynamicObject(ObjectData[id][mobjModel], ObjectData[id][mobjPos][0], ObjectData[id][mobjPos][1], ObjectData[id][mobjPos][2], ObjectData[id][mobjPos][3], ObjectData[id][mobjPos][4], ObjectData[id][mobjPos][5], ObjectData[id][mobjWorld], ObjectData[id][mobjInterior]);

                    DestroyDynamic3DTextLabel(ObjectData[id][mobjname2]);
                    format(string, sizeof(string), "[%i]\nID: %i", ObjectData[id][mobjModel], id);
                    ObjectData[id][mobjname2] = CreateDynamic3DTextLabel(string, COLOR_GREY, ObjectData[id][mobjPos][0], ObjectData[id][mobjPos][1], ObjectData[id][mobjPos][2], 5.0);

                    Object_Save(id);
                    SM(playerid, COLOR_WHITE, "You have edited the position of object ID: %d.", id);
                }
            }
        }
    }
    if(pData[playerid][EditingButtonID] != -1 && Iter_Contains(Buttons, pData[playerid][EditingButtonID]))
    {
        new id = pData[playerid][EditingButtonID];

        if(response == EDIT_RESPONSE_FINAL)
        {
            SetDynamicObjectPos(objectid, x, y, z);
            SetDynamicObjectRot(objectid, rx, ry, rz);

            if(pData[playerid][EditingButton] == 1)
            {
                ButtonData[id][bDoorPosX] = x;
                ButtonData[id][bDoorPosY] = y;
                ButtonData[id][bDoorPosZ] = z;
                ButtonData[id][bDoorPosRX] = rx;
                ButtonData[id][bDoorPosRY] = ry;
                ButtonData[id][bDoorPosRZ] = rz;

                pData[playerid][EditingButtonID] = -1;
                pData[playerid][EditingButton] = 0;
                ShowError(playerid, "Anda berhasil mengubah posisi tutup button.");
                ButtonData[id][bDoorStatus] = 0;
                Button_Save(id);
            }
            else if(pData[playerid][EditingButton] == 2)
            {
                ButtonData[id][bDoorOpenX] = x;
                ButtonData[id][bDoorOpenY] = y;
                ButtonData[id][bDoorOpenZ] = z;
                ButtonData[id][bDoorOpenRX] = rx;
                ButtonData[id][bDoorOpenRY] = ry;
                ButtonData[id][bDoorOpenRZ] = rz;

                pData[playerid][EditingButtonID] = -1;
                pData[playerid][EditingButton] = 0;
                ShowError(playerid, "Anda berhasil mengubah posisi buka button.");

                ButtonData[id][bDoorStatus] = 1;
                Button_Save(id);
            }
            else if(pData[playerid][EditingButton] == 3)
            {
                ButtonData[id][bPosX] = x;
                ButtonData[id][bPosY] = y;
                ButtonData[id][bPosZ] = z;
                ButtonData[id][bPosRX] = rx;
                ButtonData[id][bPosRY] = ry;
                ButtonData[id][bPosRZ] = rz;

                pData[playerid][EditingButtonID] = -1;
                pData[playerid][EditingButton] = 0;
                ShowError(playerid, "Anda berhasil mengubah posisi button.");

                ButtonData[id][bDoorStatus] = 1;
                Button_Save(id);
            }
        }
        else if(response == EDIT_RESPONSE_CANCEL)
        {
            SetDynamicObjectPos(objectid, bDoorEditX[playerid], bDoorEditY[playerid], bDoorEditZ[playerid]);
            SetDynamicObjectRot(objectid, bDoorEditRX[playerid], bDoorEditRY[playerid], bDoorEditRZ[playerid]);
            bDoorEditX[playerid] = 0; bDoorEditY[playerid] = 0; bDoorEditZ[playerid] = 0;
            bDoorEditRX[playerid] = 0; bDoorEditRY[playerid] = 0; bDoorEditRZ[playerid] = 0;
            Button_Save(id);
        }
    }
    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
if(dialogid == DIALOG_ATM_PIN)
{
    if(!response)
    {
        AtmPinAttempt[playerid] = 0;
        pData[playerid][pToggleAtm] = 0;
        AtmDialogOpen[playerid] = 0;
        SendClientMessage(playerid, COLOR_GREY, "ATM access cancelled.");
        return 1;
    }

    if(strlen(inputtext) == 0)
    {
        SendClientMessage(playerid, COLOR_RED, "Please enter your PIN code!");
        ShowAtmPinDialog(playerid);
        return 1;
    }

    if(strlen(inputtext) != 4)
    {
        SendClientMessage(playerid, COLOR_RED, "PIN must be 4 digits!");
        ShowAtmPinDialog(playerid);
        return 1;
    }

    new pin = strval(inputtext);

    if(pin < 1000 || pin > 9999)
    {
        SendClientMessage(playerid, COLOR_RED, "Invalid PIN! Must be between 1000 and 9999!");
        ShowAtmPinDialog(playerid);
        return 1;
    }
    if(pin == pData[playerid][pPinCode])
    {
        AtmPinAttempt[playerid] = 0;
        pData[playerid][pToggleAtm] = 1;
        AtmDialogOpen[playerid] = 1;

        if(GetNearbyAtm(playerid) >= 0 || IsPlayerNearAtmMachine(playerid))
        {
            ShowAtmMenu(playerid);
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "You moved away from the ATM.");
            pData[playerid][pToggleAtm] = 0;
            AtmDialogOpen[playerid] = 0;
        }
    }
    else
    {
        AtmPinAttempt[playerid]++;

        if(AtmPinAttempt[playerid] >= 3)
        {
            SendClientMessage(playerid, COLOR_RED, "Too many failed attempts. ATM access blocked temporarily.");
            pData[playerid][pToggleAtm] = 0;
            AtmDialogOpen[playerid] = 0;

            new playerName[MAX_PLAYER_NAME];
            GetPlayerName(playerid, playerName, sizeof(playerName));
            printf("[SECURITY] %s (ID: %d) failed ATM PIN 3 times", playerName, playerid);

            pData[playerid][pVisa] = 0;
            pData[playerid][pPinCode] = 0;

            mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
                "UPDATE users SET visa = 0, pincode = 0 WHERE uid = %d",
                pData[playerid][pID]);
            mysql_tquery(connectionID, queryBuffer);

            AtmPinAttempt[playerid] = 0;
            return 1;
        }

        ShowAtmPinDialog(playerid);
        SendClientMessage(playerid, COLOR_SYNTAX, "Invalid PIN code. Please try again.");
    }
    return 1;
}
    if(dialogid == DIALOG_AMOUNT)
    {
        if (response)
        {
            new str[125];

            pData[playerid][pGiveAmount] = strval(inputtext);
            format(str, sizeof(str), "%d", strval(inputtext));
        }
    }
    if(dialogid == DIALOG_GIVE)
    {
        if (response)
        {
            new p2 = GetPlayerListitemValue(playerid, listitem);
            new itemid = pData[playerid][pSelectItem];
            new value = pData[playerid][pGiveAmount];
            //new  otherid
        }
    }

    	// This is a fix to a known exploit where inserting '%' in the dialog box would crash the server.
	for(new i = 0, l = strlen(inputtext); i < l; i ++)
	{
	    if(inputtext[i] == '%') inputtext[i] = '#';
	}
	if(dialogid == DIALOG_AMOUNT)
	{
		if (response)
		{
			new str[125], jumlah;
			if(sscanf(inputtext, "p</>d", jumlah)) {
				ShowPlayerDialog(playerid, DIALOG_AMOUNT, DIALOG_STYLE_INPUT, "FastLife - {ffffff}Ch7al f l-inv", "Ghalat! Ma s7i7ch\nDkhel 3adad l-item mn 1 7ta l 1 million", "Oke", "Khrje");
			}
			else if(jumlah < 1 || jumlah > 100000) {
				ShowPlayerDialog(playerid, DIALOG_AMOUNT, DIALOG_STYLE_INPUT, "FastLife - {ffffff}Ch7al f l-inv", "Ghalat! Ma s7i7ch\nDkhel 3adad l-item mn 1 7ta l 1 million", "Oke", "Khrje");
			}
			pData[playerid][pGiveAmount] = strval(inputtext);
			format(str, sizeof(str), "%s", inputtext);
			PlayerTextDrawSetString(playerid, INVINFO[playerid][6], str);
		}
	}

	if(dialogid == DIALOG_TAKE)
    {
        if(response)
        {
              new id = GetPlayerListitemValue(playerid, listitem);

            CallLocalFunction("TakePlayerItem", "dds[128]", playerid, id, DroppedItems[id][droppedItem]);
        }
    }

 	if(dialogid == DIALOG_GIVE)
	{
		if (response)
		{
  			new p2 = GetPlayerListitemValue(playerid, listitem);
			new itemid = pData[playerid][pSelectItem];
			new value = pData[playerid][pGiveAmount];

				new giveName[32];
				strunpack(giveName, InventoryData[playerid][itemid][invItem]);
				CallLocalFunction("OnPlayerGiveInvItem", "ddds[32]d", playerid, p2, itemid, giveName, value);
		}
	}

    if(dialogid == DIALOG_GARAGEFG)
    {
        if(!response)
        {
            PlayerGarageID[playerid] = -1;
            return 1;
        }

        new gid = PlayerGarageID[playerid];
        if(!(0 <= gid && gid < GarageCount))
            return 1;

        new count, found = -1;

        for(new i; i < MAX_GARAGE_VEH; i++)
        {
            if(GarageVeh[gid][i][gvModel] != 0)
            {
                if(count == listitem)
                {
                    found = i;
                    break;
                }
                count++;
            }
        }

        if(found == -1) return 1;

        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);

        new vehid = CreateVehicle(
            GarageVeh[gid][found][gvModel],
            x+2.0, y, z+1.0,
            0.0,
            GarageVeh[gid][found][gvColor1],
            GarageVeh[gid][found][gvColor2],
            0);

        if(vehid != INVALID_VEHICLE_ID)
        {
            GVehUsed[vehid] = true;
            GVehGarage[vehid] = gid;

            if(Garage[gid][gType] == 1)
            {
                VehGang[vehid] = Garage[gid][gOwnerID];
                VehFaction[vehid] = 0;
            }
            else
            {
                VehFaction[vehid] = Garage[gid][gOwnerID];
                VehGang[vehid] = -1;
            }

            SetTimerEx("DeleteGarageVehicle", Garage[gid][gDeleteDelay]*1000, false, "i", vehid);

            PutPlayerInVehicle(playerid, vehid, 0);
        }

        PlayerGarageID[playerid] = -1;
        return 1;
    }

    if(dialogid == DIALOG_CHARGE_LIST)
    {
        if(!response)
        {
            ChargeData[playerid][pCharging] = false;
            SCM(playerid, COLOR_SYNTAX, "Charging process cancelled.");
            return 1;
        }


        if(listitem == sizeof(Offenses))
        {
            if(ChargeData[playerid][pOffenseCount] == 0)
            {
                SCM(playerid, COLOR_SYNTAX, "You must select at least one offense before continuing.");
                ShowChargeDialog(playerid);
                return 1;
            }


            ShowPlayerDialog(playerid, DIALOG_CHARGE_PLAYERID, DIALOG_STYLE_INPUT,
            "{0080FF}Police Charge System - Enter Player ID",
            "{FFFFFF}Enter the ID of the player you want to charge:",
            "Next", "Back");
            return 1;
        }


        if(listitem < sizeof(Offenses))
        {
            if(ChargeData[playerid][pSelectedOffenses][listitem])
            {

                ChargeData[playerid][pSelectedOffenses][listitem] = 0;
                ChargeData[playerid][pOffenseCount]--;
                ChargeData[playerid][pTotalJailTime] -= Offenses[listitem][offense_jail_time];
                ChargeData[playerid][pTotalFine] -= Offenses[listitem][offense_fine];
            }
            else
            {

                ChargeData[playerid][pSelectedOffenses][listitem] = 1;
                ChargeData[playerid][pOffenseCount]++;
                ChargeData[playerid][pTotalJailTime] += Offenses[listitem][offense_jail_time];
                ChargeData[playerid][pTotalFine] += Offenses[listitem][offense_fine];
            }
        }

        ShowChargeDialog(playerid);
        return 1;
    }

    if(dialogid == DIALOG_CHARGE_PLAYERID)
    {
        if(!response)
        {
            ShowChargeDialog(playerid);
            return 1;
        }

        if(ChargeData[playerid][pOffenseCount] == 0)
        {
            SCM(playerid, COLOR_SYNTAX, "You must select at least one offense.");
            ShowPlayerDialog(playerid, DIALOG_CHARGE_PLAYERID, DIALOG_STYLE_INPUT,
            "{0080FF}Police Charge System - Enter Player ID",
            "{FFFFFF}Enter the ID of the player you want to charge:",
            "Charge", "Back");
            return 1;
        }

        new targetid = strval(inputtext);

        if(!IsPlayerConnected(targetid))
        {
            SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");
            ShowPlayerDialog(playerid, DIALOG_CHARGE_PLAYERID, DIALOG_STYLE_INPUT,
            "{0080FF}Police Charge System - Enter Player ID",
            "{FFFFFF}Enter the ID of the player you want to charge:\n{FF0000}Error: Invalid player ID",
            "Charge", "Back");
            return 1;
        }

        if(pData[targetid][pWantedLevel] >= 6)
        {
            SCM(playerid, COLOR_SYNTAX, "This player is already at the maximum wanted level (6).");
            ShowPlayerDialog(playerid, DIALOG_CHARGE_PLAYERID, DIALOG_STYLE_INPUT,
            "{0080FF}Police Charge System - Enter Player ID",
            "{FFFFFF}Enter the ID of the player you want to charge:\n{FF0000}Error: Player at max wanted level",
            "Charge", "Back");
            return 1;
        }


        ChargeData[playerid][pTargetID] = targetid;


        ShowChargeConfirmation(playerid, targetid);
        return 1;
    }

    if(dialogid == DIALOG_CHARGE_CONFIRM)
    {
        if(!response)
        {
            ShowPlayerDialog(playerid, DIALOG_CHARGE_PLAYERID, DIALOG_STYLE_INPUT,
            "{0080FF}Police Charge System - Enter Player ID",
            "{FFFFFF}Enter the ID of the player you want to charge:",
            "Charge", "Back");
            return 1;
        }


        new targetid = ChargeData[playerid][pTargetID];


        if(!IsPlayerConnected(targetid))
        {
            SCM(playerid, COLOR_SYNTAX, "The player has disconnected.");
            ChargeData[playerid][pCharging] = false;
            return 1;
        }

        new charges[512], temp[128];
        for(new i = 0; i < sizeof(Offenses); i++)
        {
            if(ChargeData[playerid][pSelectedOffenses][i])
            {
                if(strlen(charges) > 0) strcat(charges, ", ");
                strcat(charges, Offenses[i][offense_name]);
            }
        }


        pData[targetid][pWantedLevel]++;
        pData[targetid][pCrimes] += ChargeData[playerid][pOffenseCount];


        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "UPDATE users SET wantedlevel = %i, crimes = %i WHERE uid = %i",
        pData[targetid][pWantedLevel],
        pData[targetid][pCrimes],
        pData[targetid][pID]);
        mysql_tquery(connectionID, queryBuffer);


        for(new i = 0; i < sizeof(Offenses); i++)
        {
            if(ChargeData[playerid][pSelectedOffenses][i])
            {
                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
                "INSERT INTO charges VALUES(null, %i, '%s', NOW(), '%e')",
                pData[targetid][pID],
                GetPlayerNameEx(playerid),
                Offenses[i][offense_name]);
                mysql_tquery(connectionID, queryBuffer);
            }
        }


        new string[256];

        format(string, sizeof(string), "> HQ"WHITE": %s %s has charged %s with {0080FF}%s{9999FF}. **",
        FactionRanks[pData[playerid][pFaction]][pData[playerid][pFactionRank]],
        GetRPName(playerid),
        GetRPName(targetid),
        charges);
        SendFactionMessage(pData[playerid][pFaction], COLOR_ROYALBLUE, string);

        format(string, sizeof(string), "** Officer %s has charged you with %s. (Total: %d min jail, $%d fine)",
        GetRPName(playerid),
        charges,
        ChargeData[playerid][pTotalJailTime],
        ChargeData[playerid][pTotalFine]);
        SendClientMessage(targetid, COLOR_LIGHTRED, string);

        format(string, sizeof(string), "You have successfully charged %s with %s.",
        GetRPName(targetid),
        charges);
        SendClientMessage(playerid, COLOR_LIGHTGREEN, string);

        Log_Write("log_faction", "%s (uid: %i) has charged %s (uid: %i) with %s",
        GetPlayerNameEx(playerid),
        pData[playerid][pID],
        GetPlayerNameEx(targetid),
        pData[targetid][pID],
        charges);


        ChargeData[playerid][pCharging] = false;
        return 1;
    }
    if (dialogid == DIALOG_CALLSIGN)
    {
        printf("[FST] Dialog response: player=%d, response=%d, listitem=%d", playerid, response, listitem);
        if (response)
        {
            new unitIndex = g_DialogItemToUnit[listitem];
            printf("[FST] unitIndex=%d for listitem=%d", unitIndex, listitem);

            if (unitIndex == SPECIAL_LEAVE_UNIT)
            {
                printf("[FST] Leave Unit button clicked");
                new playerName[MAX_PLAYER_NAME];
                GetPlayerName(playerid, playerName, sizeof(playerName));
                new currentUnit = GetPlayerUnit(playerName);

                if (currentUnit == -1)
                {
                    SendClientMessage(playerid, -1, "{FF0000}You are not in any unit.");
                    ShowCallsignDialog(playerid);
                    return 1;
                }

                if (RemovePlayerFromUnit(playerName))
                {
                    SendClientMessage(playerid, -1, "{00FF00}You have left the unit.");
                    printf("[FST] %s left unit %d via dialog", playerName, currentUnit);
                }
                else
                {
                    SendClientMessage(playerid, -1, "{FF0000}Error leaving unit.");
                }

                ShowCallsignDialog(playerid);
                return 1;
            }

            new isPlayerEntry = g_DialogItemIsPlayer[listitem];
            new lineIndex = g_DialogItemLineIndex[listitem];

            if (unitIndex < 0 || unitIndex >= MAX_UNITS)
            {
                SendClientMessage(playerid, -1, "Invalid unit.");
                ShowCallsignDialog(playerid);
                return 1;
            }

            new playerName[MAX_PLAYER_NAME];
            GetPlayerName(playerid, playerName, sizeof(playerName));
            if (strlen(playerName) == 0)
            {
                SendClientMessage(playerid, -1, "Invalid name.");
                return 1;
            }

            if (GetPlayerUnit(playerName) != -1)
            {
                SendClientMessage(playerid, -1, "Already in a unit.");
                ShowCallsignDialog(playerid);
                return 1;
            }

            new assignedCount = 0;
            if (strlen(g_AssignedPlayers[unitIndex]) > 0)
            {
                new temp[MAX_ASSIGNED_STRING];
                strcpy(temp, g_AssignedPlayers[unitIndex], sizeof(temp));
                for (new i = 0; i < strlen(temp); i++)
                {
                    if (temp[i] == ',' || temp[i] == '+') assignedCount++;
                }
                assignedCount++;
            }

            if (assignedCount >= MAX_ASSIGNED_PER_UNIT)
            {
                SendClientMessage(playerid, -1, "Unit full.");
                ShowCallsignDialog(playerid);
                return 1;
            }

            if (isPlayerEntry && lineIndex >= 0)
            {
                if (AddPlayerToLine(unitIndex, playerName, lineIndex))
                {
                    SendClientMessage(playerid, -1, "Assigned on the same line!");
                    printf("[FST] %s assigned to line %d in unit %d", playerName, lineIndex, unitIndex);
                }
                else
                {
                    SendClientMessage(playerid, -1, "Error adding to line.");
                }
            }
            else
            {
                if (strlen(g_AssignedPlayers[unitIndex]) == 0)
                {
                    format(g_AssignedPlayers[unitIndex], sizeof(g_AssignedPlayers[]), "%s", playerName);
                }
                else
                {
                    format(g_AssignedPlayers[unitIndex], sizeof(g_AssignedPlayers[]), "%s, %s", g_AssignedPlayers[unitIndex], playerName);
                }

                SendClientMessage(playerid, -1, "Assigned to unit!");
                printf("[FST] %s assigned to unit %d", playerName, unitIndex);
            }

            ShowCallsignDialog(playerid);
        }
    }
    if(dialogid == DIALOG_JWELERY)
    {
        if(response)
        {
            if(listitem == 0)
            {
                if(pData[playerid][pAluminium] < 1)
                {
                    return SCM(playerid, COLOR_SYNTAX, "You need at least 1 Aluminium to Sell.");
                }

                pData[playerid][pAluminium] -= 1;
                GivePlayerCash(playerid, 12);
                ShowSucces(playerid, "You have Sell Aluminium");
                GameTextForPlayer(playerid, "~g~+12 cash", 1200, 1);

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET aluminium= %i WHERE uid = %i", pData[playerid][pAluminium], pData[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);

                SCM(playerid, COLOR_GREEN, "You get 12$ from the 1 Aluminium");
            }
            if(listitem == 1)
            {
                if(pData[playerid][pIron] < 1)
                {
                    return SCM(playerid, COLOR_SYNTAX, "You need at least 1 Iron To Sell.");
                }

                pData[playerid][pIron] -= 1;
                GivePlayerCash(playerid, 17);
                ShowSucces(playerid, "You have Sell Iron");
                GameTextForPlayer(playerid, "~g~+17 cash", 1200, 1);

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET Iron = %i WHERE uid = %i", pData[playerid][pIron], pData[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);

                SCM(playerid, COLOR_GREEN, "You get 17$ from the 1 Iron");
            }
            if(listitem == 2)
            {
                if(pData[playerid][pSilver] < 1)
                {
                    return SCM(playerid, COLOR_SYNTAX, "You need at least 1 Silver To Sell.");
                }

                pData[playerid][pSilver] -= 1;
                GivePlayerCash(playerid, 23);
                ShowSucces(playerid, "You have Sell Silver");
                GameTextForPlayer(playerid, "~g~+23 cash", 1200, 1);

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET Silver = %i WHERE uid = %i", pData[playerid][pSilver], pData[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);

                SCM(playerid, COLOR_GREEN, "You get 23$ from the 1 Silver");
            }
            if(listitem == 3)
            {
                if(pData[playerid][pGold] < 1)
                {
                    return SCM(playerid, COLOR_SYNTAX, "You need at least 1 Gold To Sell.");
                }

                pData[playerid][pGold] -= 1;
                GivePlayerCash(playerid, 30);
                ShowSucces(playerid, "You have Sell Gold");
                GameTextForPlayer(playerid, "~g~+30 cash", 1200, 1);

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET gold = %i WHERE uid = %i", pData[playerid][pGold], pData[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);

                SCM(playerid, COLOR_GREEN, "You get 30$ from the 1 Gold");
            }
            if(listitem == 4)
            {
                if(pData[playerid][pDiamond] < 1)
                {
                    return SCM(playerid, COLOR_SYNTAX, "You need at least 1 Diamond To Sell.");
                }

                pData[playerid][pDiamond] -= 1;
                GivePlayerCash(playerid, 40);
                ShowSucces(playerid, "You have Sell Diamond");
                GameTextForPlayer(playerid, "~g~+40 cash", 1200, 1);

                mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET Diamond = %i WHERE uid = %i", pData[playerid][pDiamond], pData[playerid][pID]);
                mysql_tquery(connectionID, queryBuffer);

                SCM(playerid, COLOR_GREEN, "You get 40$ from the 1 Diamond");
            }
        }
    }
    // Driver's Test
    if(dialogid == DIALOG_WEP_TEST)
    {
        if(response)
        {
            if(pData[playerid][pCash] >= 15000)
            {
                pData[playerid][pDrivifstime] = 0;
                pData[playerid][pWeaponTest] = 1;
                pData[playerid][pDrivingScore] = 0;
                ShowPlayerDialog(playerid, DIALOG_WEP_QUESTION_1, DIALOG_STYLE_LIST, "{00AAAA}What will you do if you seen a DMer? ", "Report to administrator\nRevenge\nDont mind it\n", "Select", "");
            }
        }
    }
    if(dialogid == ANTICHEAT_SETTINGS)
    {
        if(!response)
        {
            pAntiCheatSettingsPage{playerid} = 0;
            return 1; // Закрываем диалог
        }

        if (!strcmp(inputtext, AC_DIALOG_NEXT_PAGE_TEXT))
        {
            pAntiCheatSettingsPage{playerid}++;
        }
        else if (!strcmp(inputtext, AC_DIALOG_PREVIOUS_PAGE_TEXT))
        {
            pAntiCheatSettingsPage{playerid}--;
        }
        else // Если игрко выбрал какой-либо из кодов анти-чита
        {
            pAntiCheatSettingsEditCodeId[playerid] = pAntiCheatSettingsMenuListData[playerid][listitem];
            return ShowPlayer_AntiCheatEditCode(playerid, pAntiCheatSettingsEditCodeId[playerid]);
        }
        return ShowPlayer_AntiCheatSettings(playerid);
    }
    if(dialogid == ANTICHEAT_EDIT_CODE)
    {
        if (!response) // Если игрок закрыл диалог
        {
            pAntiCheatSettingsEditCodeId[playerid] = -1;
            return ShowPlayer_AntiCheatSettings(playerid);
        }

        new
        item = pAntiCheatSettingsEditCodeId[playerid];

        if (AC_CODE_TRIGGER_TYPE[item] == listitem)
        return ShowPlayer_AntiCheatSettings(playerid);

        if (AC_CODE_TRIGGER_TYPE[item] == AC_CODE_TRIGGER_TYPE_DISABLED && listitem != AC_CODE_TRIGGER_TYPE_DISABLED)
        EnableAntiCheat(item, 1);

        AC_CODE_TRIGGER_TYPE[item] = listitem;

        new
        sql_query[101 - 4 + 1 + 2];

        format(sql_query, sizeof(sql_query), "UPDATE "AC_TABLE_SETTINGS" SET `"AC_TABLE_FIELD_TRIGGER"` = '%d' WHERE `"AC_TABLE_FIELD_CODE"` = '%d'",
        listitem,
        item);

