            PlayerTextDrawBackgroundColor(playerid, ProgressInteractionPTD[playerid][2], 255);
            PlayerTextDrawBoxColor(playerid, ProgressInteractionPTD[playerid][2], 1296911871);
            PlayerTextDrawUseBox(playerid, ProgressInteractionPTD[playerid][2], true);
            PlayerTextDrawSetProportional(playerid, ProgressInteractionPTD[playerid][2], true);
            PlayerTextDrawSetSelectable(playerid, ProgressInteractionPTD[playerid][2], false);
        }

