            SCM(playerid, COLOR_DARKAQUA, "Chriti 2 Lockpick Drab O 9ays /Lockpick");
            ShowItemBox(playerid, "Lockpick", "+2", 18904, 4); // ID 18904 ???? ??? (???? 2)

