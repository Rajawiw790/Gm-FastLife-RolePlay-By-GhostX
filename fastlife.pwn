CMD:refillcars(playerid, params[])
{
    new query[256];
    if(pData[playerid][pAdmin] < 36)
    {
        return ShowError(playerid, "CMD 4ALAT A BRO");
    }

    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(IsValidVehicle(i))
        {
            vehicleFuel[i] = 100;

        }
    }

    SMA(COLOR_LIGHTRED, ""RED"AdmCmd: %s"WHITE" refilled all vehicles to maximum fuel.", GetRPName(playerid));
    format(query, sizeof(query), "```%s refilled all vehicles to maximum fuel.```", GetRPName(playerid));
    DCC_SendChannelMessage(refillcars, query);
    return 1;
}

