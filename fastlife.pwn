CMD:buyvisa(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 5,  1719.510620, -888.988830, 1068.707641))
    {
        return SCM(playerid, COLOR_GREY, "You are not at the bank!");
    }

    if(pData[playerid][pVisa] > 0)
    {
        return SCM(playerid, COLOR_SYNTAX, "You already have a Visa card.");
    }

    if(pData[playerid][pCash] < 50)
    {
        return SCM(playerid, COLOR_SYNTAX, "You don't have $50 to buy a Visa card.");
    }

    new codepin = random(9000) + 1000;

    pData[playerid][pPinCode] = codepin;
    pData[playerid][pVisa] = 1;
    GivePlayerCash(playerid, -50);

    ShowSucces(playerid, "You have purchased a Visa Card!");

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET visa = %d, pincode = %d WHERE uid = %d", pData[playerid][pVisa],  pData[playerid][pPinCode], pData[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    SM(playerid, COLOR_WHITE, "** Your Visa card PIN is: %d. Use /myvisa to see it again.", codepin);

    return 0;
}

