forward AdminFly(playerid);
public AdminFly(playerid)
{
    if(!IsPlayerConnected(playerid))
    return flying[playerid] = false;

    if(flying[playerid])
    {
        if(!IsPlayerInAnyVehicle(playerid))
        {
            new
            keys,
            ud,
            lr,
            Float:x[2],
            Float:y[2],
            Float:z;

            GetPlayerKeys(playerid, keys, ud, lr);
            GetPlayerVelocity(playerid, x[0], y[0], z);
            if(ud == KEY_UP)
            {
                GetPlayerCameraPos(playerid, x[0], y[0], z);
                GetPlayerCameraFrontVector(playerid, x[1], y[1], z);
                ApplyAnimation(playerid, "PARACHUTE", "FALL_SkyDive_Accel", 4.1, 1, 1, 1, 1, 1);
                SetPlayerToFacePos(playerid, x[0] + x[1], y[0] + y[1]);
                SetPlayerVelocity(playerid, x[1], y[1], z);
            }
            else
            SetPlayerVelocity(playerid, 0.0, 0.0, 0.01);
        }

        SetTimerEx("AdminFly", 10, 0, "d", playerid);
    }

    return 0;
}

forward Float:SetPlayerToFacePos(playerid, Float:X, Float:Y);
public Float:SetPlayerToFacePos(playerid, Float:X, Float:Y)
{
    new
    Float:pX1,
    Float:pY1,
    Float:pZ1,
    Float:ang;

    if(!IsPlayerConnected(playerid)) return 0.0;

    GetPlayerPos(playerid, pX1, pY1, pZ1);

    if( Y > pY1 ) ang = (-acos((X - pX1) / floatsqroot((X - pX1)*(X - pX1) + (Y - pY1)*(Y - pY1))) - 90.0);
    else if( Y < pY1 && X < pX1 ) ang = (acos((X - pX1) / floatsqroot((X - pX1)*(X - pX1) + (Y - pY1)*(Y - pY1))) - 450.0);
    else if( Y < pY1 ) ang = (acos((X - pX1) / floatsqroot((X - pX1)*(X - pX1) + (Y - pY1)*(Y - pY1))) - 90.0);

    if(X > pX1) ang = (floatabs(floatabs(ang) + 180.0));
    else ang = (floatabs(ang) - 180.0);

    ang += 180.0;

    SetPlayerFacingAngle(playerid, ang);

    return ang;
}
//callsing
TrimString(output[], input[], maxLen = sizeof(output))
{
    output[0] = '\0';
    if (strlen(input) == 0) return;
    new start = 0, end = strlen(input) - 1;
    while (start <= end && input[start] == ' ') start++;
    while (end >= start && input[end] == ' ') end--;
    if (start > end) return;
    strmid(output, input, start, end + 1, maxLen);
}

UpdateVehicleLabel(vehicleid)
{
    if (g_VehicleLabels[vehicleid] != Text3D:INVALID_3DTEXT_ID)
    {
        DestroyDynamic3DTextLabel(g_VehicleLabels[vehicleid]);
        g_VehicleLabels[vehicleid] = Text3D:INVALID_3DTEXT_ID;
    }

    new driverid = INVALID_PLAYER_ID;
    for (new i = 0; i < MAX_PLAYERS; i++)
    {
        if (!IsPlayerConnected(i)) continue;
        if (GetPlayerVehicleID(i) == vehicleid && GetPlayerVehicleSeat(i) == 0)
        {
            driverid = i;
            break;
        }
    }

    if (driverid == INVALID_PLAYER_ID) return;

    new playerName[MAX_PLAYER_NAME];
    GetPlayerName(driverid, playerName, sizeof(playerName));
    new unitIndex = GetPlayerUnit(playerName);

    if (unitIndex == -1) return;

    new labelText[64];
    format(labelText, sizeof(labelText), "{3DABFF}%s", g_UnitNames[unitIndex]);

    new Float:x, Float:y, Float:z;
    GetVehiclePos(vehicleid, x, y, z);

    g_VehicleLabels[vehicleid] = CreateDynamic3DTextLabel(
    labelText,
    0x3DABFFFF,
    0.0, 0.0, 1.0,
    50.0,
    INVALID_PLAYER_ID,
    vehicleid,
    0
    );
}
GetPlayerUnit(playerName[])
{
    for (new i = 0; i < MAX_UNITS; i++)
    {
        if (strfind(g_AssignedPlayers[i], playerName, true) != -1) return i;
    }
    return -1;
}

RemovePlayerFromUnit(playerName[])
{
    for (new i = 0; i < MAX_UNITS; i++)
    {
        new pos = strfind(g_AssignedPlayers[i], playerName, true);
        if (pos != -1)
        {
            new players[MAX_ASSIGNED_STRING];
            strcpy(players, g_AssignedPlayers[i], sizeof(players));
            new newList[MAX_ASSIGNED_STRING] = "";

            new start = 0, commaPos;
            new firstLine = 1;

            while (start < strlen(players))
            {
                commaPos = strfind(players[start], ",");
                new lineContent[128];

                if (commaPos == -1)
                {

                    strmid(lineContent, players, start, strlen(players), sizeof(lineContent));
                }
                else
                {
                    strmid(lineContent, players, start, start + commaPos, sizeof(lineContent));
                }

                new trimmedLine[128];
                TrimString(trimmedLine, lineContent, sizeof(trimmedLine));

                new newLine[128] = "";
                new lineStart = 0, plusPos;
                new firstPlayer = 1;

                while (lineStart < strlen(trimmedLine))
                {
                    plusPos = strfind(trimmedLine[lineStart], "+");
                    new currentPlayer[32];

                    if (plusPos == -1)
                    {

                        strmid(currentPlayer, trimmedLine, lineStart, strlen(trimmedLine), sizeof(currentPlayer));
                    }
                    else
                    {
                        strmid(currentPlayer, trimmedLine, lineStart, lineStart + plusPos, sizeof(currentPlayer));
                    }

                    new trimmedPlayer[32];
                    TrimString(trimmedPlayer, currentPlayer, sizeof(trimmedPlayer));

                    if (strcmp(trimmedPlayer, playerName, true) != 0)
                    {

                        if (!firstPlayer)
                        {
                            strcat(newLine, "+");
                        }
                        strcat(newLine, trimmedPlayer);
                        firstPlayer = 0;
                    }

                    if (plusPos == -1) break;
                    lineStart += plusPos + 1;
                }

                if (strlen(newLine) > 0)
                {
                    if (!firstLine)
                    {
                        strcat(newList, ", ");
                    }
                    strcat(newList, newLine);
                    firstLine = 0;
                }

                if (commaPos == -1) break;
                start += commaPos + 1;
            }

            strcpy(g_AssignedPlayers[i], newList, sizeof(g_AssignedPlayers[]));
            return 1;
        }
    }
    return 0;
}

AddPlayerToLine(unitIndex, newPlayerName[], lineIndex)
{
    new players[MAX_ASSIGNED_STRING];
    strcpy(players, g_AssignedPlayers[unitIndex], sizeof(players));

    if (strlen(players) == 0)
    {
        format(g_AssignedPlayers[unitIndex], sizeof(g_AssignedPlayers[]), "%s", newPlayerName);
        return 1;
    }

    new currentLine = 0;
    new start = 0, commaPos;
    new beforeLine[MAX_ASSIGNED_STRING] = "";
    new afterLine[MAX_ASSIGNED_STRING] = "";

    while (currentLine <= lineIndex)
    {
        commaPos = strfind(players[start], ",");

        if (commaPos == -1)
        {
            if (currentLine == lineIndex)
            {

                new lineContent[128];
                strmid(lineContent, players, start, strlen(players), sizeof(lineContent));
                new trimmedLine[128];
                TrimString(trimmedLine, lineContent, sizeof(trimmedLine));

                if (strlen(beforeLine) > 0)
                {
                    format(g_AssignedPlayers[unitIndex], sizeof(g_AssignedPlayers[]), "%s, %s+%s", beforeLine, trimmedLine, newPlayerName);
                }
                else
                {
                    format(g_AssignedPlayers[unitIndex], sizeof(g_AssignedPlayers[]), "%s+%s", trimmedLine, newPlayerName);
                }
                return 1;
            }
            break;
        }
        else
        {
            new lineContent[128];
            strmid(lineContent, players, start, start + commaPos, sizeof(lineContent));
            new trimmedLine[128];
            TrimString(trimmedLine, lineContent, sizeof(trimmedLine));

            if (currentLine == lineIndex)
            {
                if (strlen(beforeLine) > 0)
                {
                    format(beforeLine, sizeof(beforeLine), "%s, %s+%s", beforeLine, trimmedLine, newPlayerName);
                }
                else
                {
                    format(beforeLine, sizeof(beforeLine), "%s+%s", trimmedLine, newPlayerName);
                }

                strmid(afterLine, players, start + commaPos + 1, strlen(players), sizeof(afterLine));
                TrimString(afterLine, afterLine, sizeof(afterLine));

                if (strlen(afterLine) > 0)
                {
                    format(g_AssignedPlayers[unitIndex], sizeof(g_AssignedPlayers[]), "%s, %s", beforeLine, afterLine);
                }
                else
                {
                    format(g_AssignedPlayers[unitIndex], sizeof(g_AssignedPlayers[]), "%s", beforeLine);
                }
                return 1;
            }
            else
            {
                if (strlen(beforeLine) > 0)
                {
                    format(beforeLine, sizeof(beforeLine), "%s, %s", beforeLine, trimmedLine);
                }
                else
                {
                    format(beforeLine, sizeof(beforeLine), "%s", trimmedLine);
                }
            }

            start += commaPos + 1;
            currentLine++;
        }
    }

    return 0;
}

ShowCallsignDialog(playerid)
{
    new dialogText[2048] = "";
    new itemIndex = 0;

    new playerName[MAX_PLAYER_NAME];
    GetPlayerName(playerid, playerName, sizeof(playerName));
    new playerInUnit = (GetPlayerUnit(playerName) != -1);


    for (new i = 0; i < MAX_UNITS; i++)
    {
        new line[512] = "";

        if (strlen(g_AssignedPlayers[i]) == 0)
        {
            format(line, sizeof(line), "{FFFFFF}%-15s{AAAAAA}%s", g_UnitNames[i], g_UnitDescriptions[i]);

            g_DialogItemToUnit[itemIndex] = i;
            g_DialogItemIsPlayer[itemIndex] = 0;
            g_DialogItemLineIndex[itemIndex] = -1;
            itemIndex++;

            if (strlen(dialogText) + strlen(line) + 2 < sizeof(dialogText))
            {
                strcat(dialogText, line);
                strcat(dialogText, "\n");
            }
        }
        else
        {
            format(line, sizeof(line), "{FFFFFF}%-15s{AAAAAA}%s", g_UnitNames[i], g_UnitDescriptions[i]);

            g_DialogItemToUnit[itemIndex] = i;
            g_DialogItemIsPlayer[itemIndex] = 0;
            g_DialogItemLineIndex[itemIndex] = -1;
            itemIndex++;

            if (strlen(dialogText) + strlen(line) + 2 < sizeof(dialogText))
            {
                strcat(dialogText, line);
                strcat(dialogText, "\n");
            }

            new players[MAX_ASSIGNED_STRING];
            strcpy(players, g_AssignedPlayers[i], sizeof(players));

            new lineNum = 1;
            new start = 0, commaPos;
            new lineIndex = 0;

            while ((commaPos = strfind(players[start], ",")) != -1 && start < strlen(players))
            {
                new lineContent[128];
                strmid(lineContent, players, start, start + commaPos, sizeof(lineContent));
                new trimmedLine[128];
                TrimString(trimmedLine, lineContent, sizeof(trimmedLine));

                new displayLine[256];
                format(displayLine, sizeof(displayLine), "  {3f7dd4}%d. [", lineNum);

                new lineStart = 0, plusPos;
                new firstPlayer = 1;
                while ((plusPos = strfind(trimmedLine[lineStart], "+")) != -1)
                {
                    strmid(playerName, trimmedLine, lineStart, lineStart + plusPos, sizeof(playerName));
                    new trimmedName[32];
                    TrimString(trimmedName, playerName, sizeof(trimmedName));

                    if (!firstPlayer) strcat(displayLine, " + ");
                    strcat(displayLine, trimmedName);
                    firstPlayer = 0;

                    lineStart += plusPos + 1;
                }


                if (lineStart < strlen(trimmedLine))
                {
                    strmid(playerName, trimmedLine, lineStart, strlen(trimmedLine), sizeof(playerName));
                    new trimmedName[32];
                    TrimString(trimmedName, playerName, sizeof(trimmedName));

                    if (!firstPlayer) strcat(displayLine, " + ");
                    strcat(displayLine, trimmedName);
                }

                strcat(displayLine, "]");

                g_DialogItemToUnit[itemIndex] = i;
                g_DialogItemIsPlayer[itemIndex] = 1;
                g_DialogItemLineIndex[itemIndex] = lineIndex;
                itemIndex++;

                if (strlen(dialogText) + strlen(displayLine) + 2 < sizeof(dialogText))
                {
                    strcat(dialogText, displayLine);
                    strcat(dialogText, "\n");
                }

                lineNum++;
                lineIndex++;
                start += commaPos + 1;
            }

            if (start < strlen(players))
            {
                new lineContent[128];
                strmid(lineContent, players, start, strlen(players), sizeof(lineContent));
                new trimmedLine[128];
                TrimString(trimmedLine, lineContent, sizeof(trimmedLine));

                new displayLine[256];
                format(displayLine, sizeof(displayLine), "  {3f7dd4}%d. [", lineNum);

                new lineStart = 0, plusPos;
                new firstPlayer = 1;
                while ((plusPos = strfind(trimmedLine[lineStart], "+")) != -1)
                {
                    strmid(playerName, trimmedLine, lineStart, lineStart + plusPos, sizeof(playerName));
                    new trimmedName[32];
                    TrimString(trimmedName, playerName, sizeof(trimmedName));

                    if (!firstPlayer) strcat(displayLine, " + ");
                    strcat(displayLine, trimmedName);
                    firstPlayer = 0;

                    lineStart += plusPos + 1;
                }

                if (lineStart < strlen(trimmedLine))
                {
                    strmid(playerName, trimmedLine, lineStart, strlen(trimmedLine), sizeof(playerName));
                    new trimmedName[32];
                    TrimString(trimmedName, playerName, sizeof(trimmedName));

                    if (!firstPlayer) strcat(displayLine, " + ");
                    strcat(displayLine, trimmedName);
                }

                strcat(displayLine, "]");

                g_DialogItemToUnit[itemIndex] = i;
                g_DialogItemIsPlayer[itemIndex] = 1;
                g_DialogItemLineIndex[itemIndex] = lineIndex;
                itemIndex++;

                if (strlen(dialogText) + strlen(displayLine) + 2 < sizeof(dialogText))
                {
                    strcat(dialogText, displayLine);
                    strcat(dialogText, "\n");
                }
            }
        }
    }


    if (playerInUnit)
    {
        strcat(dialogText, "\n{FF0000}>>> Leave My Unit <<<");
        g_DialogItemToUnit[itemIndex] = SPECIAL_LEAVE_UNIT;
        g_DialogItemIsPlayer[itemIndex] = 0;
        g_DialogItemLineIndex[itemIndex] = -1;
        itemIndex++;
    }

    if (ShowPlayerDialog(playerid, DIALOG_CALLSIGN, DIALOG_STYLE_LIST, "Callsign Assignment", dialogText, "Assign", "Cancel") == 0)
    {
        SendClientMessage(playerid, -1, "[ERROR] Dialog failed to show.");
    }
    else
    {
        printf("[FST] Dialog shown to player %d", playerid);
    }
}

forward Float:GetDistanceBetweenPlayers(p1,p2);
public Float:GetDistanceBetweenPlayers(p1,p2)
{
    new Float:x1,Float:y1,Float:z1,Float:x2,Float:y2,Float:z2;
    if(!IsPlayerConnected(p1) || !IsPlayerConnected(p2))
    {
        return -1.00;
    }
    GetPlayerPos(p1,x1,y1,z1);
    GetPlayerPos(p2,x2,y2,z2);
    return floatsqroot(floatpower(floatabs(floatsub(x2,x1)),2)+floatpower(floatabs(floatsub(y2,y1)),2)+floatpower(floatabs(floatsub(z2,z1)),2));
}
forward pollend(playerid);
public pollend(playerid)
{
    new string[128];
    format(string, sizeof(string), "The Poll has ended, "WHITE"%d{FF6347} people voted "WHITE"No{FF6347}, "WHITE"%d{FF6347} people voted "WHITE"Yes{FF6347}.", PollN, PollY);
    SCMA(COLOR_LIGHTRED, string);
    PollOn = 0;
    return 1;
}
