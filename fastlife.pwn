CMD:addbutton(playerid, params[])
{
    if(pData[playerid][pAdmin] < 44)
        return SCM(playerid, COLOR_LIGHTRED, "Error:"WHITE" You are not authorized to use this command.");

    new id = Iter_Free(Buttons), query[2048];
    if(id <= -1)
        return ShowError(playerid, "3adad les boutons dynamiques wslo l maximum!");

    GetPlayerPos(playerid, ButtonData[id][bPosX], ButtonData[id][bPosY], ButtonData[id][bPosZ]);
    ButtonData[id][bDoorModel] = 3089;
    ButtonData[id][bPosX] = ButtonData[id][bPosX] + 2;
    ButtonData[id][bPosY] = ButtonData[id][bPosY] + 2;
    ButtonData[id][bPosRX] = 0;
    ButtonData[id][bPosRY] = 0;
    ButtonData[id][bPosRZ] = 0;
    GetPlayerPos(playerid, ButtonData[id][bDoorPosX], ButtonData[id][bDoorPosY], ButtonData[id][bDoorPosZ]);
    ButtonData[id][bDoorPosX] = ButtonData[id][bDoorPosX] + 2;
    ButtonData[id][bDoorPosY] = ButtonData[id][bDoorPosY] + 2;
    ButtonData[id][bDoorPosRX] = 0;
    ButtonData[id][bDoorPosRY] = 0;
    ButtonData[id][bDoorPosRZ] = 0;

    ButtonData[id][bDoorOpenX] = 0;
    ButtonData[id][bDoorOpenY] = 0;
    ButtonData[id][bDoorOpenZ] = 0;
    ButtonData[id][bDoorOpenRX] = 0;
    ButtonData[id][bDoorOpenRY] = 0;
    ButtonData[id][bDoorOpenRZ] = 0;

    ButtonData[id][bWorld] = GetPlayerVirtualWorld(playerid);
    ButtonData[id][bInterior] = GetPlayerInterior(playerid);

    ButtonData[id][bDoorStatus] = 0;
    ButtonData[id][bFaction] = 0;
    ButtonData[id][bFamily] = -1;
    ButtonData[id][bSpeed] = 2.0;

    ButtonData[id][bObject] = CreateDynamicObject(2886, ButtonData[id][bPosX], ButtonData[id][bPosY], ButtonData[id][bPosZ], ButtonData[id][bPosRX], ButtonData[id][bPosRY], ButtonData[id][bPosRZ], -1, -1, -1, 30.0, 30.0);
    ButtonData[id][bDoorObject] = CreateDynamicObject(ButtonData[id][bDoorModel], ButtonData[id][bDoorPosX], ButtonData[id][bDoorPosY], ButtonData[id][bDoorPosZ], ButtonData[id][bDoorPosRX], ButtonData[id][bDoorPosRY], ButtonData[id][bDoorPosRZ], -1, -1, -1, 100.0, 100.0);
    ButtonData[id][bDoorStatus] = 0;
    Iter_Add(Buttons, id);

    mysql_format(connectionID, query, sizeof(query),
        "INSERT INTO `buttons` SET `ID`='%d', `doormodel`='%d', \
        `bposx`='%f', `bposy`='%f', `bposz`='%f', `bposrx`='%f', `bposry`='%f', `bposrz`='%f', \
        `doorposx`='%f', `doorposy`='%f', `doorposz`='%f', `doorposrx`='%f', `doorposry`='%f', `doorposrz`='%f', \
        `dopenx`='%f', `dopeny`='%f', `dopenz`='%f', `dopenrx`='%f', `dopenry`='%f', `dopenrz`='%f', \
        `world`=%d, `interior`=%d",
        id, ButtonData[id][bDoorModel],
        ButtonData[id][bPosX], ButtonData[id][bPosY], ButtonData[id][bPosZ],
        ButtonData[id][bPosRX], ButtonData[id][bPosRY], ButtonData[id][bPosRZ],
        ButtonData[id][bDoorPosX], ButtonData[id][bDoorPosY], ButtonData[id][bDoorPosZ],
        ButtonData[id][bDoorPosRX], ButtonData[id][bDoorPosRY], ButtonData[id][bDoorPosRZ],
        ButtonData[id][bDoorOpenX], ButtonData[id][bDoorOpenY], ButtonData[id][bDoorOpenZ],
        ButtonData[id][bDoorOpenRX], ButtonData[id][bDoorOpenRY], ButtonData[id][bDoorOpenRZ],
        ButtonData[id][bWorld], ButtonData[id][bInterior]);
    mysql_pquery(connectionID, query, "OnButtonCreated", "ii", playerid, id);
    return 1;
}

CMD:editbutton(playerid, params[])
{
    static id, type[24], string[128];

    if(pData[playerid][pAdmin] < 44)
    {
        return SCM(playerid, COLOR_LIGHTRED, "Error:"WHITE" You are not authorized to use this command.");
    }
    if(sscanf(params, "ds[24]S()[128]", id, type, string))
        return SCM(playerid, COLOR_SYNTAX, "/editbutton [id] [name]~n~doormodel | faction | family | buttonpos | close | open | speed | remove");

    if(!Iter_Contains(Buttons, id)) return ShowError(playerid, "Invalid button ID!");

    if(!strcmp(type, "doormodel", true))
    {
        new object;
        if(sscanf(string, "d", object))
            return SCM(playerid, COLOR_SYNTAX, "/editbutton [id] [doormodel] [object id]");

        ButtonData[id][bDoorModel] = object;
        if(DestroyDynamicObject(ButtonData[id][bDoorObject]))
            ButtonData[id][bDoorObject] = STREAMER_TAG_OBJECT: INVALID_STREAMER_ID;
        ButtonData[id][bDoorObject] = CreateDynamicObject(ButtonData[id][bDoorModel], ButtonData[id][bPosX], ButtonData[id][bPosY], ButtonData[id][bPosZ], ButtonData[id][bPosRX], ButtonData[id][bPosRY], ButtonData[id][bPosRZ], -1, -1, -1, 100.0, 100.0);
        SendStaffMessage(Y_LIGHTRED, "AdmCmd: %s changed the door model for button ID %d to %d.", pData[playerid][pAdminName], id, object);
        Button_Save(id);
    }
    else if(!strcmp(type, "faction", true))
    {
    new fid;
    if(sscanf(string, "d", fid))
        return SCM(playerid, COLOR_SYNTAX, "/editbutton [id] [faction] [faction id]");

    if(fid < 0 || fid > MAX_FACTIONS - 1)
        return ShowError(playerid, "Invalid faction ID!");

    ButtonData[id][bFaction] = fid;
    SendStaffMessage(Y_LIGHTRED, "AdmCmd: %s changed the faction access for button ID %d to faction ID: %d.", pData[playerid][pAdminName], id, fid);
    Button_Save(id);
}
else if(!strcmp(type, "family", true))
{
    new gangstr[32], gangid;
    if(sscanf(string, "s[32]", gangstr))
        return SCM(playerid, COLOR_SYNTAX, "/editbutton [id] [family] [family id/none]");

    if(!strcmp(gangstr, "none", true))
    {
        gangid = -1;
    }
    else
    {
        gangid = strval(gangstr);

        if(gangid < 1 || gangid >= MAX_GANGS || !GangInfo[gangid][gSetup])
            return ShowError(playerid, "Family ID tidak valid!");
    }

    ButtonData[id][bFamily] = gangid;
    SendStaffMessage(Y_LIGHTRED, "AdmCmd: %s changed the family access for button ID %d to family ID: %d.", pData[playerid][pAdminName], id, gangid);
    Button_Save(id);
}
    else if(!strcmp(type, "speed", true))
    {
        new Float:speed;
        if(sscanf(string, "f", speed))
             return SCM(playerid, COLOR_SYNTAX, "/editbutton [id] [Speed] [level]");

        ButtonData[id][bSpeed] = speed;
        SendStaffMessage(Y_LIGHTRED, "AdmCmd: %s changed the speed for button ID %d to %f.", pData[playerid][pAdminName], id, speed);
        Button_Save(id);
    }
    else if(!strcmp(type, "close", true))
    {
        pData[playerid][EditingButton] = 1;
        pData[playerid][EditingButtonID] = id;
        GetDynamicObjectPos(ButtonData[id][bDoorObject], bDoorEditX[playerid], bDoorEditY[playerid], bDoorEditZ[playerid]);
        GetDynamicObjectRot(ButtonData[id][bDoorObject], bDoorEditRX[playerid], bDoorEditRY[playerid], bDoorEditRZ[playerid]);
        EditDynamicObject(playerid, ButtonData[id][bDoorObject]);
        SendStaffMessage(Y_LIGHTRED, "AdmCmd: %s edited the closed position of button ID: %d.", pData[playerid][pAdminName], id);
        Button_Save(id);
    }
    else if(!strcmp(type, "open", true))
    {
        pData[playerid][EditingButton] = 2;
        pData[playerid][EditingButtonID] = id;
        GetDynamicObjectPos(ButtonData[id][bDoorObject], bDoorEditX[playerid], bDoorEditY[playerid], bDoorEditZ[playerid]);
        GetDynamicObjectRot(ButtonData[id][bDoorObject], bDoorEditRX[playerid], bDoorEditRY[playerid], bDoorEditRZ[playerid]);
        EditDynamicObject(playerid, ButtonData[id][bDoorObject]);
        SendStaffMessage(Y_LIGHTRED, "AdmCmd: %s edited the open position of button ID: %d.", pData[playerid][pAdminName], id);
    }
    else if(!strcmp(type, "buttonpos", true))
    {
        pData[playerid][EditingButton] = 3;
        pData[playerid][EditingButtonID] = id;
        GetDynamicObjectPos(ButtonData[id][bObject], bDoorEditX[playerid], bDoorEditY[playerid], bDoorEditZ[playerid]);
        GetDynamicObjectRot(ButtonData[id][bObject], bDoorEditRX[playerid], bDoorEditRY[playerid], bDoorEditRZ[playerid]);
        EditDynamicObject(playerid, ButtonData[id][bObject]);
        SendStaffMessage(Y_LIGHTRED, "AdmCmd: %s edited the button position of button ID: %d.", pData[playerid][pAdminName], id);
        Button_Save(id);
    }
    else if(!strcmp(type, "remove", true))
    {
        ButtonData[id][bDoorModel] = 0;
        ButtonData[id][bPosX] = 0;
        ButtonData[id][bPosY] = 0;
        ButtonData[id][bPosZ] = 0;
        ButtonData[id][bPosRX] = 0;
        ButtonData[id][bPosRY] = 0;
        ButtonData[id][bPosRZ] = 0;
        ButtonData[id][bDoorPosX] = 0;
        ButtonData[id][bDoorPosY] = 0;
        ButtonData[id][bDoorPosZ] = 0;
        ButtonData[id][bDoorPosRX] = 0;
        ButtonData[id][bDoorPosRY] = 0;
        ButtonData[id][bDoorPosRZ] = 0;
        ButtonData[id][bDoorOpenX] = 0;
        ButtonData[id][bDoorOpenY] = 0;
        ButtonData[id][bDoorOpenZ] = 0;
        ButtonData[id][bDoorOpenRX] = 0;
        ButtonData[id][bDoorOpenRY] = 0;
        ButtonData[id][bDoorOpenRZ] = 0;
        ButtonData[id][bWorld] = 0;
        ButtonData[id][bInterior] = 0;
        ButtonData[id][bDoorStatus] = 0;
        ButtonData[id][bFaction] = 0;
        ButtonData[id][bFamily] = -1;
        ButtonData[id][bSpeed] = 0;

        if(DestroyDynamicObject(ButtonData[id][bDoorObject]))
            ButtonData[id][bDoorObject] = STREAMER_TAG_OBJECT: INVALID_STREAMER_ID;
        if(DestroyDynamicObject(ButtonData[id][bObject]))
            ButtonData[id][bObject] = STREAMER_TAG_OBJECT: INVALID_STREAMER_ID;

        Iter_Remove(Buttons, id);
        new query[2048];
        mysql_format(connectionID, query, sizeof(query), "DELETE FROM `buttons` WHERE `ID`=%d", id);
        mysql_pquery(connectionID, query);
        SendStaffMessage(Y_LIGHTRED, "AdmCmd: %s deleted button ID: %d.", pData[playerid][pAdminName], id);
    }
    return 1;
}

CMD:gotobutton(playerid, params[])
{
    new id;
    if(pData[playerid][pAdmin] < 44)
    {
        return SCM(playerid, COLOR_LIGHTRED, "Error:"WHITE" You are not authorized to use this command.");
    }
    if(sscanf(params, "i", id))
	 return SCM(playerid, COLOR_SYNTAX, "/gotobutton [button id]");
    if(!Iter_Contains(Buttons, id))
        return ShowError(playerid, "Invalid Button ID!");

    SetPlayerPos(playerid, ButtonData[id][bPosX], ButtonData[id][bPosY], ButtonData[id][bPosZ]);
    SetPlayerInterior(playerid, ButtonData[id][bInterior]);
    SetPlayerVirtualWorld(playerid, ButtonData[id][bWorld]);
    pData[playerid][pInDoor] = -1;
    pData[playerid][pInHouse] = -1;
    pData[playerid][pInBiz] = -1;
    pData[playerid][pInRusun] = -1;
    pData[playerid][pInGudang] = -1;
    return 1;
}

CMD:grandman(playerid, params[])
{
    new targetid;
    if(sscanf(params, "u", targetid))
    {
        SCM(playerid, COLOR_GREY2, "Usage: /grandman [playerid]");
        return 1;
    }
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 90.824485, -184.215637, 1.484375))
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not In Grandman.");
    }
    if(targetid == playerid)
    {
        return SCM(playerid, COLOR_AQUA, "You Cannot Revive yourself.");
    }
    if(!IsPlayerConnected(targetid) || !IsPlayerInRangeOfPlayer(playerid, targetid, 5.0))
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected or out of range.");
    }
    if(!pData[targetid][pInjured])
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified is not injured.");
    }


    pData[targetid][pInjured] = 0;
    pData[targetid][pHunger] = 25;
    pData[targetid][pHungerTimer] = 0;
    pData[targetid][pThirst] = 25;
    pData[targetid][pThirstTimer] = 0;
    pData[targetid][pStress] = 25;
    pData[targetid][pStresstimer] = 0;
    pData[targetid][pDraggedBy] = INVALID_PLAYER_ID;
    SetPlayerPos(targetid, 90.824485, -184.215637, 1.484375);
    ApplyAnimationEx(targetid, "CRACK", "crckdeth4", 4.1, 0, 0, 0, 1, 0);
    GivePlayerCash(playerid, -50);
    SCM(targetid, COLOR_AQUA, "Type (/stopani).");
    TextDrawHideForPlayer(targetid, Text:DieText);
    TextDrawHideForPlayer(targetid, Text:InjuredText);

    return 1;

}

