FormatNumber(number, money = 1)
{
    new lefsth, value[32];

    format(value, sizeof(value), "%i", (number < 0) ? (-number) : (number));

    lefsth = strlen(value);

    if(lefsth > 3)
    {
        for(new l = 0, i = lefsth; --i >= 0; l ++)
        {
            if((l % 3 == 0) && l > 0)
            {
                strins(value, ",", i + 1);
            }
        }
    }

    if(money)
    strins(value, "$", 0);
    if(number < 0)
    strins(value, "-", 0);

    return value;
}
