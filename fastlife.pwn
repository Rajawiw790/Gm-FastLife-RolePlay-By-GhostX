CMD:findfactory(playerid, params[])
{
    if(!PlayerHasJob(playerid, JOB_MINERVIP))
    {
        return SCM(playerid, COLOR_GREY, "You can't use this command as you're not a Miner Vip.");
    }

    if(pData[playerid][pStone] < 1)
    {
        return SCM(playerid, COLOR_SYNTAX, "You don't have any stone to wash! Mine some first.");
    }

    SetPlayerCheckpoint(playerid, 1336.116912, 907.722595, 20.406250, 3.0);

    SCM(playerid, COLOR_YELLOW, "Factory location marked on your map! Follow the checkpoint.");
    GameTextForPlayer(playerid, "~g~Go to the Factory~n~~w~to wash your stone", 4000, 3);

    return 1;
}

