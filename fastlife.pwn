stock PlayerVehicleUpdate(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    new lights = GetVehicleParams(vehicleid, 1);
    new lightColor = (lights == 1) ? 0x00FF00FF : 0xFF0000FF;
    if(IsValidVehicle(vehicleid))
    {
        if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            new Float:fHealth;
            GetVehicleHealth(vehicleid, fHealth);
            if(IsValidVehicle(vehicleid) && fHealth <= 1000.0)
            {
                SetVehicleHealth(vehicleid, 1000.0);
            }
        }
        if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            if(pData[playerid][pHBEMode] == 1)
            {
                new Float:fFuel;
                new Float:bensinbar;

                fFuel = float(vehicleFuel[vehicleid]);

                if(fFuel < 0) fFuel = 0;
                else if(fFuel > 100) fFuel = 100;

                new str[128];
                static Float:kecepatan;
                kecepatan = GetVehicleSpeed(vehicleid);

                format(str, sizeof(str), "%.0f", GetVehicleSpeed(vehicleid));
                PlayerTextDrawSetString(playerid, speedoBaru[playerid][20], str);

                bensinbar = fFuel * -38.000 / 100;
                PlayerTextDrawTextSize(playerid, speedoBaru[playerid][64], 3.000, bensinbar);
                PlayerTextDrawShow(playerid, speedoBaru[playerid][64]);

                if(kecepatan < 0.0)
                {
                    PlayerTextDrawSetString(playerid, speedoBaru[playerid][32], "R");
                }
                else
                {
                    PlayerTextDrawSetString(playerid, speedoBaru[playerid][32], "N");
                }

                if(kecepatan > 1.0)
                {
                    PlayerTextDrawSetString(playerid, speedoBaru[playerid][32], "1");
