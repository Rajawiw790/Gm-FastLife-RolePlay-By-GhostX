    forward defrostiron(playerid);
    public defrostiron(playerid)
    {
        ClearAnimations(playerid, 1);
        GameTextForPlayer(playerid, "~y~Done", 3000, 3);
        pData[playerid][pBarIron] += 1;
        pData[playerid][pIron] -= 50;
        TogglePlayerControllable(playerid, 1);
        SCM(playerid, SERVER_COLOR1, "You have Now a bar of Iron Frisk Yourself.");

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET iron = %i WHERE uid = %i", pData[playerid][pIron], pData[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET bariron = %i WHERE uid = %i", pData[playerid][pBarIron], pData[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
        return 1;
    }

