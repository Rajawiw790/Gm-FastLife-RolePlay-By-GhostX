}
CMD:kick7(playerid, params[])
{
	new targetid, reason[128], id;

	if(pData[playerid][pAdmin] < 37)
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}
	if(gettime() - pData[playerid][pkick_LastUse] < 60)
	{
	    return SM(playerid, COLOR_SYNTAX, "You can only use this command every 1 minutes. Please wait %i more seconds.", 60 - (gettime() - pData[playerid][pkick_LastUse]));
	}
	if((id = GetNearbyTurf(playerid)) >= 0 && TurfInfo[id][tCapturer] != INVALID_PLAYER_ID)
	{
		return SCM(playerid, COLOR_GREY2, " You can'tuse this commandin turf.");
	}
	if(sscanf(params, "us[128]", targetid, reason))
	{
	    return SCM(playerid, COLOR_SYNTAX, "Usage: /kick7 [playerid] [reason]");
	}
	if(!WC_IsPlayerSpawned(targetid))
	{
	    return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");
	}
	if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
    {
        return SCM(playerid, COLOR_SYNTAX, "Sorry Bro Mt9drx Tdir had cmd m3a Rank kbar mnk.");
    }

    Log_Write("log_punishments", "%s (uid: %i) silently kicked %s (uid: %i), reason: %s", GetPlayerNameEx(playerid), pData[playerid][pID], GetPlayerNameEx(targetid), pData[targetid][pID], reason);
	SAM(COLOR_RED, "AdmCmd: %s has silently kicked %s, reason: %s", GetRPName(playerid), GetRPName(targetid), reason);
	KickPlayer(targetid);
	pData[playerid][pkick_LastUse] = gettime();
	return 1;
}

CMD:BUYGUN(playerid, params[])
{
