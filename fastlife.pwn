CMD:goto(playerid, params[])
{
	new targetid;
	new id;
    new query[256];

    if(pData[playerid][pAdmin] < 1)
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}
	if(!pData[playerid][pAdminDuty] && pData[playerid][pAdmin] < 12)
	{
	    return SCM(playerid, COLOR_SYNTAX, "This command requires you to be on admin duty. /aduty to go on duty.");
	}
    if(pData[playerid][pComserv] > 0)
    {
       return SCM(playerid, COLOR_SYNTAX, "You cannot use this command while serving Community Service.");
    }
	if(pData[playerid][pJailType])
	{
	    return SCM(playerid, COLOR_SYNTAX, "This player is in jail so you can't teleport them.");
	}
	if((id = GetNearbyTurf(playerid)) >= 0 && TurfInfo[id][tCapturer] != INVALID_PLAYER_ID)
	{
		return SCM(playerid, COLOR_GREY2, " You are in Turf You can't call EMS");
	}
	if(pData[targetid][pPaintball] > 0 && pData[playerid][pPaintball] == 0)
    {
        return SendClientMessage(playerid, COLOR_GREY, "That player is currently in the paintball arena.");
    }
	if(sscanf(params, "u", targetid))
	{
	    SCM(playerid, COLOR_SYNTAX, "Usage: /goto [playerid/location]");
 		SCM(playerid, COLOR_WHITE, "Locations: LS, SF, LV, Grove, Idlewood, Unity, Jefferson, Market, Airport, Bank");
 		SCM(playerid, COLOR_WHITE, "Locations: dmv, Arena, Allsaints, Mall, hospital");
		return 1;
	}

	if(!strcmp(params, "ls", true))
    {
		TeleportToCoords(playerid, 1523.362426, -1661.277465, 13.539175, 275.512847, 0, 0);
        SCM(playerid, COLOR_GREY2, "Teleported to Los Santos.");
        SAM(COLOR_RED, "%s has teleported to Los Santos.", GetRPName(playerid));
        format(query, sizeof(query), "```%s has teleported to Los Santos.```", GetRPName(playerid));
   	    DCC_SendChannelMessage(gotoo, query);
    }
    else if(!strcmp(params, "sf", true))
