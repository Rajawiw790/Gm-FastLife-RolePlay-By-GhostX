forward Tpeebool(playerid);
public Tpeebool(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	ClearAnimations(playerid);

	StopAudioStreamForPlayer(playerid);
	SendProximityMessage(playerid, 20.0, COLOR_PURPLE, "** %s Hhhh Wra7a Hadi.", GetRPName(playerid));
	return 1;
}

forward BotRevive(playerid);
public BotRevive(playerid)
{
	if(IsValidActor(pData[playerid][pMedicActor]))
		DestroyActor(pData[playerid][pMedicActor]);

	pData[playerid][pInjured] = 0;
	pData[playerid][pTpee] = 0;
	pData[playerid][pTpeeTimer] = 0;
	pData[playerid][pHunger] = 25;
	pData[playerid][pHungerTimer] = 0;
    pData[playerid][pThirst] = 25;
	pData[playerid][pThirstTimer] = 0;

	SetPlayerInterior(playerid, 0);
	SetCameraBehindPlayer(playerid);

    TogglePlayerControllable(playerid, 1);
	SetPlayerHealth(playerid, 50.0);
	GivePlayerCash(playerid, -100);
	ClearAnimations(playerid, 1);
	UpdateDynamic3DTextLabelText(InjuredLabel[playerid], COLOR_DOCTOR, "");

	SCM(playerid, COLOR_YELLOW, "You have been revived by an Doctor");
	SendProximityMessage(playerid, 20.0, SERVER_COLOR, "**{C2A2DA} Medic successfully healed %s wound.", GetRPName(playerid));

    return 1;
}

forward DEATHACTOR(playerid);
public DEATHACTOR(playerid)
{
	if(IsValidActor(pData[playerid][pDeathActor]))
		DestroyActor(pData[playerid][pDeathActor]);
	if(IsValidDynamic3DTextLabel(pData[playerid][pDeathInfo]))
		DestroyDynamic3DTextLabel(pData[playerid][pDeathInfo]);
    return 1;
}

forward StartGiveMoneyAnimation(playerid, actorIndex);
public StartGiveMoneyAnimation(playerid, actorIndex)
{
    if (!IsPlayerConnected(playerid)) return 0;
    if (actorIndex < 0 || actorIndex >= sizeof(RobActor)) return 0; // فحص صلاحية الممثل

    ApplyActorAnimation(RobActor[actorIndex], "DEALER", "dealer_deal", 4.0, 0, 0, 0, 0, 0);

    GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~r~ROBBING...", 3000, 4);
    ShowProgressbar(playerid, "ROBBING", 3);

    new Float:x, Float:y, Float:z;
    GetActorPos(RobActor[actorIndex], x, y, z);

    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name)); // إعادة تعريف الاسم بدون حماية

    foreach(new i : Player)
    {
        if(IsPlayerConnected(i) && IsLawEnforcement(i))
        {
            new msg[128];
            format(msg, sizeof(msg), "** HQ: %s HOWA LI ROBA 9LBO MDC", name);
            SM(i, COLOR_ROYALBLUE, msg);
            PlayAudioStreamForPlayer(i, "http://a.top4top.io/m_3502e8rlz0.mp3");
            SetTimerEx("StopRobberyAudio", 30000, false, "i", i);
            SetPlayerCheckpoint(i, x, y, z, 1.0);
        }
    }

    SetTimerEx("GiveRobMoney", 3000, false, "ii", playerid, actorIndex);
    return 1;
}

forward GiveRobMoney(playerid, actorIndex);
public GiveRobMoney(playerid, actorIndex)
{
    if (!IsPlayerConnected(playerid)) return 0;

    GameTextForPlayer(playerid, "~w~Passed", 3000, 0);
    PlayAudioStreamForPlayer(playerid, "http://j.top4top.io/m_3563xkh4v0.mp3");

    SendClientMessage(playerid, COLOR_RED, "Yalh Tchfr M3ndo Walo.");
    SetTimerEx("Stopsoundstream", 10000, false, "i", playerid);

    new robCash = 5000 + random(50001);
    GivePlayerCash(playerid, robCash);

    new str[64];
    format(str, sizeof(str), "~g~+$%d", robCash);
    GameTextForPlayer(playerid, str, 3000, 3);
    SM(playerid, COLOR_GREEN, "You got $%d from the robbery!", robCash);

    pData[playerid][pWantedLevel] = 3;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET DirtyCash = %i, wantedlevel = %i WHERE uid = %i", pData[playerid][pDirtyCash], pData[playerid][pWantedLevel], pData[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    new Float:ax, Float:ay, Float:az;
    GetActorPos(RobActor[actorIndex], ax, ay, az);

    for (new i = 0; i < MAX_PLAYERS; i++)
    {
        if (IsPlayerConnected(i) && IsPlayerInRangeOfPoint(i, 30.0, ax, ay, az))
        {
            PlayerPlaySound(i, 3401, ax, ay, az);
        }
    }

    ApplyActorAnimation(RobActor[actorIndex], "PED", "cower", 4.0, 0, 0, 0, 0, 0);

    SetTimerEx("ResetRobStatus", ROB_RESET_TIME, false, "ii", playerid, actorIndex);
    return 1;
}
forward ResetRobStatus(playerid, actorIndex);
public ResetRobStatus(playerid, actorIndex)
{
    if (actorIndex < 0 || actorIndex >= sizeof(RobActor)) return 0;

    ClearActorAnimations(RobActor[actorIndex]);
    ApplyActorAnimation(RobActor[actorIndex], "PED", "null", 4.0, 0, 0, 0, 0, 0);

    ActorRobbed[playerid] = false;
    SendClientMessage(playerid, COLOR_GREEN, "DABA T9DR TROBI.");
    return 1;
}

