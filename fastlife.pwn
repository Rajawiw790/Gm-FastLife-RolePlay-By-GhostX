    return 1;
}

CMD:voicemute(playerid, params[])
{
    new targetid;

    if(pData[playerid][pAdmin] < 35)
        return ShowError(playerid, "You don't have permission to use this command!");

    if(sscanf(params, "u", targetid))
        return SCM(playerid, COLOR_SYNTAX, "Usage: /voicemute [playerid]");

    if(targetid == playerid)
        return ShowError(playerid, "You cannot mute yourself!");

    if(!IsPlayerConnected(targetid))
        return ShowError(playerid, "Player is not connected!");

    if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
        return SCM(playerid, COLOR_SYNTAX, "You cannot mute a player with a higher rank than you!");

    if(pData[targetid][pVoiceChat] == 1)
        return ShowError(playerid, "This player is already voice muted!");

    pData[targetid][pVoiceChat] = 1;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "UPDATE users SET voicechat = 1 WHERE uid = %i",
        pData[targetid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    SvMutePlayerEnable(targetid);

    new string[128];
    format(string, sizeof(string), "%s has muted %s on voice chat.", GetRPName(playerid), GetRPName(targetid));
    SAM(COLOR_LIGHTRED, string);

    format(string, sizeof(string), "You have been muted on voice chat by %s.", GetRPName(playerid));
    SM(targetid, COLOR_RED, string);

    return 1;
}

CMD:voiceunmute(playerid, params[])
{
    new targetid;

    if(pData[playerid][pAdmin] < 35)
        return ShowError(playerid, "You don't have permission to use this command!");

    if(sscanf(params, "u", targetid))
        return SCM(playerid, COLOR_SYNTAX, "Usage: /voiceunmute [playerid]");

    if(!IsPlayerConnected(targetid))
        return ShowError(playerid, "Player is not connected!");

    if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
        return SCM(playerid, COLOR_SYNTAX, "You cannot unmute a player with a higher rank than you!");

    if(pData[targetid][pVoiceChat] == 0)
        return ShowError(playerid, "This player is not voice muted!");

    pData[targetid][pVoiceChat] = 0;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "UPDATE users SET voicechat = 0 WHERE uid = %i",
        pData[targetid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    SvMutePlayerDisable(targetid);

    new string[128];
    format(string, sizeof(string), "%s has unmuted %s on voice chat.", GetRPName(playerid), GetRPName(targetid));
    SAM(COLOR_LIGHTRED, string);

    format(string, sizeof(string), "You have been unmuted on voice chat by %s.", GetRPName(playerid));
    SM(targetid, COLOR_GREEN, string);

    return 1;
}

CMD:voicestatus(playerid, params[])
{
    new targetid;

    if(pData[playerid][pAdmin] < 35)
        return ShowError(playerid, "You don't have permission to use this command!");

    if(sscanf(params, "u", targetid))
        return SCM(playerid, COLOR_SYNTAX, "Usage: /voicestatus [playerid]");

    if(!IsPlayerConnected(targetid))
        return ShowError(playerid, "Player is not connected!");

    if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
        return SCM(playerid, COLOR_SYNTAX, "You cannot check status of a player with a higher rank than you!");

    new status = SvMutePlayerStatus(targetid);

    if(status == 0)
        SM(playerid, COLOR_GREEN, "Voice Chat Status of %s: {00FF00}NOT MUTED", GetRPName(targetid));
    else
        SM(playerid, COLOR_RED, "Voice Chat Status of %s: {FF0000}MUTED", GetRPName(targetid));

    return 1;
}

CMD:rmute(playerid, params[])
{
    new targetid;

    if(pData[playerid][pAdmin] < 22)
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
    {
        return SCM(playerid, COLOR_SYNTAX, "Sorry Bro Mt9drx Tdir had cmd m3a Rank kbar mnk.");
    }
    if(sscanf(params, "u", targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /rmute [playerid]");
    }
    if(!IsPlayerConnected(targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");
    }

    if(!pData[targetid][pReportMuted])
    {
        pData[targetid][pReportMuted] = 99999;

        SendStaffMessage(COLOR_LIGHTRED, ""RED"AdmCmd: %s"WHITE" was muted from submitting reports by %s.", GetRPName(targetid), GetRPName(playerid));
        SM(targetid, COLOR_LIGHTRED, "** You have been muted from submitting reports by %s.", GetRPName(playerid));
    }
    else
    {
        pData[targetid][pReportMuted] = 0;

        SendStaffMessage(COLOR_LIGHTRED, ""RED"AdmCmd: %s"WHITE" was unmuted from submitting reports by %s.", GetRPName(targetid), GetRPName(playerid));
        SM(targetid, COLOR_YELLOW, "** You have been unmuted from submitting reports by %s.", GetRPName(playerid));
    }

    return 1;
}
CMD:sweep(playerid, params[])
{
    if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 574)
    {
        if(pData[playerid][pCP] != CHECKPOINT_NONE)
        {
            return SCM(playerid, COLOR_SYNTAX, "You must cancel your active checkpoint first. /cancelcp to cancel it.");
        }
        pData[playerid][pCP] = CHECKPOINT_SWEEP1;
        SetPlayerCheckpoint(playerid, 1499.494995, 2392.264648, 10.671875, 3.0);
        GameTextForPlayer(playerid, "~y~Clean The Street", 6000, 3);
        SCM(playerid, COLOR_AQUA, "** Sy9 droba mzyan.");
        return 1;
    }

    SendClientMessage(playerid, COLOR_RED,"[ERROR]: You are not in range of Sweeping car");
    return 1;
}
CMD:freezenear(playerid, params[])
{
    new Float:radius;
    new targetid;
    if(pData[playerid][pAdmin] < 46)
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
    {
        return SCM(playerid, COLOR_SYNTAX, "Sorry Bro Mt9drx Tdir had cmd m3a Rank kbar mnk.");
    }
    if(sscanf(params, "f", radius))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /freezenear [radius]");
    }
    if(!(1.0 <= radius <= 100.0))
    {
        return SCM(playerid, COLOR_WHITE, "The radius can't be below 1.0 or above 100.0.");
    }

    foreach(new i : Player)
    {
        if(IsPlayerInRangeOfPlayer(i, playerid, radius))
        {
            if(!pData[i][pAdminDuty])
            {
                if(GetArmor(i) < 100.0)
                {
                    TogglePlayerControllable(i, 0);
                }
            }

            SCM(i, COLOR_WHITE, "** An admin has frozen everyone nearby.");
        }
    }

    return 1;
}

