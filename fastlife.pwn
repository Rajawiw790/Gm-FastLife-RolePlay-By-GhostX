            SetPlayerCheckpoint(playerid, 1918.3048,225.9165,28.9157, 5);
        }
        if(IsPlayerInRangeOfPoint(playerid, 5, 1918.3048,225.9165,28.9157))
        {
            DisablePlayerCheckpoint(playerid);
            SetPlayerCheckpoint(playerid, 1912.5255,195.8915,34.3317, 5);
        }
        if(IsPlayerInRangeOfPoint(playerid, 5, 1912.5255,195.8915,34.3317))
        {
            DisablePlayerCheckpoint(playerid);
            SetPlayerCheckpoint(playerid, 1931.7278,211.1347,30.6640, 5);
        }
        if(IsPlayerInRangeOfPoint(playerid, 5, 1931.7278,211.1347,30.6640))
        {
            DisablePlayerCheckpoint(playerid);
            SetPlayerCheckpoint(playerid, 1938.5186,189.6142,34.5158, 5);
        }
