        stock GetGenderString(gender) {
            new sex[7];
            switch(gender) {
                case 2: sex = "Female";
                default: sex = "Male";
            }

            return sex;
        }
stock id_ShowCitizen(playerid, name[], skin, age, sex)
{
	new value[20];
	// Skin
	//PlayerTextDrawSetPreviewModel(playerid, showid[playerid][19], skin);
	//PlayerTextDrawShow(playerid, showid[playerid][19]);

	// Name
	PlayerTextDrawSetString(playerid, showid[playerid][16], name);
	PlayerTextDrawShow(playerid, showid[playerid][16]);

	// Age
	format(value, sizeof(value), "%i", age);
	PlayerTextDrawSetString(playerid, showid[playerid][17], value);
	PlayerTextDrawShow(playerid, showid[playerid][17]);

	// Job
	new jobname[32];
	 new jobid;
    format(jobname, sizeof(jobname), "%s", GetJobName(jobid));
    PlayerTextDrawSetString(playerid, showid[playerid][19], jobname);
    PlayerTextDrawShow(playerid, showid[playerid][19]);

	// Gender
	PlayerTextDrawSetString(playerid, showid[playerid][18], GetGenderString(sex));
	PlayerTextDrawShow(playerid, showid[playerid][18]);
	for(new i = 0; i < 26; i ++)
	{
		PlayerTextDrawShow(playerid, showid[playerid][i]);
	}
}

stock Scythe(playerid, time = 10000)
{
	if(pData[playerid][pScythe])
	{
   	   for(new i = 0; i < 26; i ++)
     	{
	   	     PlayerTextDrawHide(playerid, showid[playerid][i]);
	    }
	    KillTimer(pData[playerid][pScytheTimer]);
	}
	for(new i = 0; i < 26; i ++)
	{
		PlayerTextDrawShow(playerid, showid[playerid][i]);
	}

	pData[playerid][pScythe] = true;
	pData[playerid][pScytheTimer] = SetTimerEx("HidetheScythe", time, false, "d", playerid);
}

forward HidetheScythe(playerid);
public HidetheScythe(playerid)
{
	if (!pData[playerid][pScythe])
	    return 0;

	pData[playerid][pScythe] = false;
	for(new i = 0; i < 26; i ++)
	{
		PlayerTextDrawHide(playerid, showid[playerid][i]);
	}
	return 1;
}
        stock id_ShowPassport(playerid, name[], skin, age, sex) {
            new value[250];
            // Skin
            PlayerTextDrawSetPreviewModel(playerid, passporttd[playerid][0], skin);
            PlayerTextDrawShow(playerid, passporttd[playerid][0]);

            // Name
            PlayerTextDrawSetString(playerid, passporttd[playerid][1], name);
            PlayerTextDrawShow(playerid, passporttd[playerid][1]);

            // Age
            format(value, sizeof(value), "%i", age);
            PlayerTextDrawSetString(playerid, passporttd[playerid][2], value);
            PlayerTextDrawShow(playerid, passporttd[playerid][2]);

            // Gender
            PlayerTextDrawSetString(playerid, passporttd[playerid][3], GetGenderString(sex));
            PlayerTextDrawShow(playerid, passporttd[playerid][3]);

            TextDrawShowForPlayer(playerid, publicpassport[0]);
            TextDrawShowForPlayer(playerid, publicpassport[1]);
            TextDrawShowForPlayer(playerid, publicpassport[2]);
            TextDrawShowForPlayer(playerid, publicpassport[3]);
            TextDrawShowForPlayer(playerid, publicpassport[4]);
            TextDrawShowForPlayer(playerid, publicpassport[5]);
            TextDrawShowForPlayer(playerid, publicpassport[6]);
            TextDrawShowForPlayer(playerid, publicpassport[7]);
            TextDrawShowForPlayer(playerid, publicpassport[8]);
            TextDrawShowForPlayer(playerid, publicpassport[9]);
            TextDrawShowForPlayer(playerid, publicpassport[10]);
