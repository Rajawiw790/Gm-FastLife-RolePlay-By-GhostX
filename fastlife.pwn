    CMD:inv1(playerid, params[])
    {
    new str[2048];
    new weapon_count = 0;
    new total_items = 0;  // ????? ???? ????? ?? ???????

    format(str, sizeof(str), "{7DAEFF}%s's Inventory:"WHITE"\n\n", GetRPName(playerid));

    // ???? ???????
    if(pData[playerid][pCash] > 0) { total_items++; format(str, sizeof(str), "%sCash: $%s\n\n", str, FormatCash(pData[playerid][pCash])); }
    if(pData[playerid][pBank] > 0) { total_items++; format(str, sizeof(str), "%sBank: $%s\n\n", str, FormatCash(pData[playerid][pBank])); }
    if(pData[playerid][pDirtyCash] > 0) { total_items++; format(str, sizeof(str), "%sDirty Money: $%s\n\n", str, FormatCash(pData[playerid][pDirtyCash])); }
    if(pData[playerid][pEth] > 0) { total_items++; format(str, sizeof(str), "%sEthereum: %d\n\n", str, pData[playerid][pEth]); }
    if(pData[playerid][pDarkcoin] > 0) { total_items++; format(str, sizeof(str), "%sDarkcoin: %d\n\n", str, pData[playerid][pDarkcoin]); }
    if(pData[playerid][pBitcoin] > 0) { total_items++; format(str, sizeof(str), "%sEcoin: %d\n\n", str, pData[playerid][pBitcoin]); }
    if(pData[playerid][pSpinCard] > 0) { total_items++; format(str, sizeof(str), "%sSpin Card: x%d\n\n", str, pData[playerid][pSpinCard]); }
    if(pData[playerid][pCarSpinCard] > 0) { total_items++; format(str, sizeof(str), "%sCar Spin Card: x%d\n\n", str, pData[playerid][pCarSpinCard]); }
    if(pData[playerid][pFood] > 0) { total_items++; format(str, sizeof(str), "%sFood: x%d\n\n", str, pData[playerid][pFood]); }
    if(pData[playerid][pDrink] > 0) { total_items++; format(str, sizeof(str), "%sDrink: x%d\n\n", str, pData[playerid][pDrink]); }
    if(pData[playerid][pPot] > 0) { total_items++; format(str, sizeof(str), "%sPot: %dg\n\n", str, pData[playerid][pPot]); }
    if(pData[playerid][pCrack] > 0) { total_items++; format(str, sizeof(str), "%sCrack: %dg\n\n", str, pData[playerid][pCrack]); }
    if(pData[playerid][pMeth] > 0) { total_items++; format(str, sizeof(str), "%sMeth: %dg\n\n", str, pData[playerid][pMeth]); }
    if(pData[playerid][pPainkillers] > 0) { total_items++; format(str, sizeof(str), "%sPainkillers: x%d\n\n", str, pData[playerid][pPainkillers]); }
    if(pData[playerid][pMaterials] > 0) { total_items++; format(str, sizeof(str), "%sMaterials: %d\n\n", str, pData[playerid][pMaterials]); }
    if(pData[playerid][pSeeds] > 0) { total_items++; format(str, sizeof(str), "%sSeeds: x%d\n\n", str, pData[playerid][pSeeds]); }
    if(pData[playerid][pCigars] > 0) { total_items++; format(str, sizeof(str), "%sCigars: x%d\n\n", str, pData[playerid][pCigars]); }
    if(pData[playerid][pMask] > 0) { total_items++; format(str, sizeof(str), "%sMask: x%d\n\n", str, pData[playerid][pMask]); }
    if(pData[playerid][pKey] > 0) { total_items++; format(str, sizeof(str), "%sKey: x%d\n\n", str, pData[playerid][pKey]); }
    if(pData[playerid][pusb] > 0) { total_items++; format(str, sizeof(str), "%sUSB: x%d\n\n", str, pData[playerid][pusb]); }
    if(pData[playerid][pBlindfold] > 0) { total_items++; format(str, sizeof(str), "%sBlindfold: x%d\n\n", str, pData[playerid][pBlindfold]); }
    if(pData[playerid][pStone] > 0) { total_items++; format(str, sizeof(str), "%sStone: x%d\n\n", str, pData[playerid][pStone]); }
    if(pData[playerid][pGold] > 0) { total_items++; format(str, sizeof(str), "%sGold: x%dG\n\n", str, pData[playerid][pGold]); }
    if(pData[playerid][pIron] > 0) { total_items++; format(str, sizeof(str), "%sIron: x%dG\n\n", str, pData[playerid][pIron]); }
    if(pData[playerid][pBarGold] > 0) { total_items++; format(str, sizeof(str), "%sBarGold: x%d\n\n", str, pData[playerid][pBarGold]); }
    if(pData[playerid][pBarMetal] > 0) { total_items++; format(str, sizeof(str), "%sBarMetal: x%d\n\n", str, pData[playerid][pBarMetal]); }
    if(pData[playerid][pBarIron] > 0) { total_items++; format(str, sizeof(str), "%sBarIron: x%d\n\n", str, pData[playerid][pBarIron]); }
    if(pData[playerid][pBarPlatinum] > 0) { total_items++; format(str, sizeof(str), "%sBarPlatinum: x%d\n\n", str, pData[playerid][pBarPlatinum]); }
    if(pData[playerid][pMetal] > 0) { total_items++; format(str, sizeof(str), "%sMetal: x%d\n\n", str, pData[playerid][pMetal]); }
    if(pData[playerid][pPlatinum] > 0) { total_items++; format(str, sizeof(str), "%sPlatinum: x%d\n\n", str, pData[playerid][pPlatinum]); }
    if(pData[playerid][pLockpick] > 0) { total_items++; format(str, sizeof(str), "%sLockpick: x%d\n\n", str, pData[playerid][pLockpick]); }
    if(pData[playerid][pPhone] > 0) { total_items++; format(str, sizeof(str), "%sPhone: x%d\n\n", str, pData[playerid][pPhone]); }
    if(pData[playerid][pWalkieTalkie] > 0) { total_items++; format(str, sizeof(str), "%sWalkie Talkie: x%d\n\n", str, pData[playerid][pWalkieTalkie]); }
    if(pData[playerid][pGPS] > 0) { total_items++; format(str, sizeof(str), "%sGPS: x%d\n\n", str, pData[playerid][pGPS]); }
    if(pData[playerid][pBandage] > 0) { total_items++; format(str, sizeof(str), "%sBandage: x%d\n\n", str, pData[playerid][pBandage]); }
    if(pData[playerid][pMedkit] > 0) { total_items++; format(str, sizeof(str), "%sMedkit: x%d\n\n", str, pData[playerid][pMedkit]); }
    if(pData[playerid][pRepairKit] > 0) { total_items++; format(str, sizeof(str), "%sRepair Kit: x%d\n\n", str, pData[playerid][pRepairKit]); }

    format(str, sizeof(str), "%s{FFD700}Weapons:\n", str);
    for(new i = 0; i < 13; i++)
    {
        if(pData[playerid][pWeapons][i] > 0)
        {
            weapon_count++;
            total_items++;
            format(str, sizeof(str), "%s{FF0000}* %s\n", str, GetWeaponNameEx(pData[playerid][pWeapons][i]));
        }
    }
    if(weapon_count < 1)
        format(str, sizeof(str), "%s{FF0000}* No weapons\n", str);

    format(str, sizeof(str), "%s\n{FFD700}Total Items: {FFFFFF}%d", str, total_items);

    if(total_items < 1)
    {
        format(str, sizeof(str), "{7DAEFF}%s's Inventory:"WHITE"\n\n{FF0000}* Empty", GetRPName(playerid));
    }

    ShowPlayerDialog(playerid, 0, DIALOG_STYLE_MSGBOX, "Inventory FastLife", str, "Close", "");
    return 1;
}
    CMD:help(playerid, params[])
    {
        SM(playerid, COLOR_WHITE, "Welcome to fst Club%s", GetRPName(playerid));
        SCM(playerid, COLOR_GREEN, "----------------------------------------------------------------------------------------------------------------------------" );
        SCM(playerid, COLOR_WHITE, "If you have any problem or question you may ask our staff using "RED"(/n)");
        SCM(playerid, COLOR_WHITE, "For Personal Assistance from our HELPERS you can type "RED"(/requesthelp) "WHITE" or "RED"(/report) "WHITE" for admin help");
        SCM(playerid, COLOR_WHITE, "Type "RED"(/fixvw) "WHITE" to reset your virtural world or ask the Staff about that");
        SCM(playerid, COLOR_WHITE, "Type "RED" (/stuck) "WHITE" if you are stuck in the door");
        SCM(playerid, COLOR_GREEN, "----------------------------------------------------------------------------------------------------------------------------" );
        return 1;
    }
