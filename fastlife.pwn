forward DeleteRentedVehicle(playerid);
public DeleteRentedVehicle(playerid)
{
    if(pData[playerid][pInsideRental] == 1)
    {
        new vehicleid = pData[playerid][pRentedVehicle];

        if(IsValidVehicle(vehicleid))
        {
            DestroyVehicle(vehicleid);
        }

        pData[playerid][pInsideRental] = 0;
        pData[playerid][pRentedVehicle] = 0;
        pData[playerid][pRentTimer] = -1;

        SendClientMessage(playerid, COLOR_RED, "Your rented motor has been removed because you left it unattended!");
    }
    return 1;
}

