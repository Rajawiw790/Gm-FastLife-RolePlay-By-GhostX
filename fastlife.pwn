        pData[playerid][pBarPlatinum] -= amount;
        pData[targetid][pBarPlatinum] += amount;
        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET barplatinum = %i WHERE uid = %i", pData[playerid][pBarPlatinum], pData[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET barplatinum = %i WHERE uid = %i", pData[targetid][pBarPlatinum], pData[targetid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        SM(targetid, COLOR_AQUA, "%s has given you %i BarPlatinum.", GetRPName(playerid), amount);
        SM(playerid, COLOR_AQUA, "You have given %i BarPlatinum to %s.", amount, GetRPName(targetid));

        SendProximityMessage(playerid, 20.0, SERVER_COLOR1, "**{C2A2DA} %s gives some BarPlatinum's to %s.", GetRPName(playerid), GetRPName(targetid));
    }
    else if(!strcmp(option, "ironbar", true))
    {
        if(sscanf(param, "i", amount))
        {
            return SCM(playerid, COLOR_SYNTAX, "Usage: /give [playerid] [BarIron] [amount]");
        }
        if(amount < 1 || amount > pData[playerid][pBarIron])
        {
            return SCM(playerid, COLOR_WHITE, "Insufficient amount.");
        }


        pData[playerid][pBarIron] -= amount;
