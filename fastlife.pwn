new g_prof_name[64];
new DCC_Channel:g_prof_channel_id;

DCMD:profile(user, channel, params[])
{
    new playername[64];

    if(sscanf(params, "s[64]", playername))
    {
        return DCC_SendChannelMessage(channel,
            "**Usage:** `!profile [username]`");
    }

    format(g_prof_name, 64, "%s", playername);
    g_prof_channel_id = channel;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "SELECT username, level, age, gender, cash, bank, job, secondjob, \
        faction, factionrank, division, gang, gangrank, \
        vippackage, hours, phone, adminlevel, helperlevel, \
        health, armor, skin, warnings, marriedto, regdate, lastlogin \
        FROM users WHERE username = '%e' LIMIT 1",
        playername);
    mysql_tquery(connectionID, queryBuffer, "OnProfileCheck", "");

    return 1;
}

stock bool:FL_FindOnlinePlayer(const username[], &ping)
{
    new name[MAX_PLAYER_NAME];
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i)) continue;
        GetPlayerName(i, name, sizeof(name));
        if(strcmp(name, username, true) == 0)
        {
            ping = GetPlayerPing(i);
            return true;
        }
    }
    ping = 0;
    return false;
}

forward OnProfileCheck();
public OnProfileCheck()
{
    new DCC_Channel:channel = g_prof_channel_id;

    if(!cache_get_row_count(connectionID))
    {
        new DCC_Embed:embed = DCC_CreateEmbed("Fastlife-Bot");
        new string[300];
        format(string, sizeof(string),
            "**Error:** Player `%s` not found!", g_prof_name);
        DCC_SetEmbedDescription(embed, string);
        DCC_SetEmbedColor(embed, 0xFF0000);
        DCC_SendChannelEmbedMessage(channel, embed);
        return 1;
    }

    new username[MAX_PLAYER_NAME];
    new level, age, gender;
    new cash, bank;
    new job, secondjob;
    new faction, factionrank, division;
    new gang, gangrank;
    new vippackage, hours, phone;
    new adminlevel, helperlevel;
    new Float:health, Float:armor;
    new skin;

    new warnings;
    new marriedto[24];
    new regdate[32];
    new lastlogin[32];

    cache_get_field_content(0, "username", username, connectionID, sizeof(username));
    level         = cache_get_field_content_int(0, "level", connectionID);
    age           = cache_get_field_content_int(0, "age", connectionID);
    gender        = cache_get_field_content_int(0, "gender", connectionID);
    cash          = cache_get_field_content_int(0, "cash", connectionID);
    bank          = cache_get_field_content_int(0, "bank", connectionID);
    job           = cache_get_field_content_int(0, "job", connectionID);
    secondjob     = cache_get_field_content_int(0, "secondjob", connectionID);
    faction       = cache_get_field_content_int(0, "faction", connectionID);
    factionrank   = cache_get_field_content_int(0, "factionrank", connectionID);
    division      = cache_get_field_content_int(0, "division", connectionID);
    gang          = cache_get_field_content_int(0, "gang", connectionID);
    gangrank      = cache_get_field_content_int(0, "gangrank", connectionID);
    vippackage    = cache_get_field_content_int(0, "vippackage", connectionID);
    hours         = cache_get_field_content_int(0, "hours", connectionID);
    phone         = cache_get_field_content_int(0, "phone", connectionID);
    adminlevel    = cache_get_field_content_int(0, "adminlevel", connectionID);
    helperlevel   = cache_get_field_content_int(0, "helperlevel", connectionID);
    health        = cache_get_field_content_float(0, "health", connectionID);
    armor         = cache_get_field_content_float(0, "armor", connectionID);
    skin          = cache_get_field_content_int(0, "skin", connectionID);

    warnings      = cache_get_field_content_int(0, "warnings", connectionID);
    cache_get_field_content(0, "marriedto", marriedto, connectionID, sizeof(marriedto));
    cache_get_field_content(0, "regdate", regdate, connectionID, sizeof(regdate));
    cache_get_field_content(0, "lastlogin", lastlogin, connectionID, sizeof(lastlogin));

    new faction_name[48] = "None";
    new faction_rank_name[32] = "N/A";
    new division_name[32] = "None";
    new gang_name[32] = "None";
    new gang_rank_name[32] = "N/A";

    if(faction >= 0 && faction < 20)
    {
        format(faction_name, sizeof(faction_name), "%s", FactionInfo[faction][fName]);
        if(factionrank >= 0 && factionrank < 10)
            format(faction_rank_name, sizeof(faction_rank_name), "%s", FactionRanks[faction][factionrank]);
        if(division >= 0)
            format(division_name, sizeof(division_name), "%s", FactionDivisions[faction][division]);
    }

    if(gang >= 0 && gang < 20)
    {
        format(gang_name, sizeof(gang_name), "%s", GangInfo[gang][gName]);
        if(gangrank >= 0 && gangrank < 10)
            format(gang_rank_name, sizeof(gang_rank_name), "%s", GangRanks[gang][gangrank]);
    }

    new job_name[32], secondjob_name[32];
    format(job_name, sizeof(job_name), "%s", GetJobName(job));
    format(secondjob_name, sizeof(secondjob_name), "%s", GetJobName(secondjob));

    new gender_str[16];
    switch(gender)
    {
        case 1: gender_str = "Male";
        case 2: gender_str = "Female";
        case 3: gender_str = "Shemale";
        default: gender_str = "Unknown";
    }

    new vip_str[32];
    switch(vippackage)
    {
        case 0: vip_str = "None";
        case 1: vip_str = "Bronze";
        case 2: vip_str = "Silver";
        case 3: vip_str = "Gold";
        default: vip_str = "Unknown";
    }

    new ping;
    new bool:isOnline = FL_FindOnlinePlayer(username, ping);

    new DCC_Embed:embed = DCC_CreateEmbed();
    new title[128];
    new desc[1024];
    new field_value[256];

    format(title, sizeof(title), "PROFILE - %s", username);
    DCC_SetEmbedColor(embed, isOnline ? (0x2ECC71) : (0x00CCFF));
    DCC_SetEmbedTitle(embed, title);

    format(desc, sizeof(desc),
        "**Level:** `%d` | **Age:** `%d` | **Gender:** `%s`\n\
        **Cash:** `$%s` | **Bank:** `$%s`\n\
        **Total Wealth:** `$%s`\n\
        **Playtime:** `%d Hours`",
        level, age, gender_str,
        AddCommas(cash), AddCommas(bank),
        AddCommas(cash + bank),
        hours);

    DCC_SetEmbedDescription(embed, desc);

    if(isOnline)
        format(field_value, sizeof(field_value), "```Online | Ping: %d```", ping);
    else
        format(field_value, sizeof(field_value), "```Offline | Last seen: %s```",
            strlen(lastlogin) ? lastlogin : "Unknown");
    DCC_AddEmbedField(embed, "Status", field_value, false);

    format(field_value, sizeof(field_value), "```%s```", job_name);
    DCC_AddEmbedField(embed, "Job", field_value, true);

    if(secondjob >= 0)
    {
        format(field_value, sizeof(field_value), "```%s```", secondjob_name);
        DCC_AddEmbedField(embed, "Second Job", field_value, true);
    }

    format(field_value, sizeof(field_value), "```%s [%s]```", faction_name, faction_rank_name);
    DCC_AddEmbedField(embed, "Faction", field_value, true);

    format(field_value, sizeof(field_value), "```%s```", division_name);
    DCC_AddEmbedField(embed, "Division", field_value, true);

    format(field_value, sizeof(field_value), "```%s [%s]```", gang_name, gang_rank_name);
    DCC_AddEmbedField(embed, "Gang", field_value, true);

    format(field_value, sizeof(field_value), "```%s```", vip_str);
    DCC_AddEmbedField(embed, "VIP", field_value, true);

    format(field_value, sizeof(field_value), "```%d```", phone);
    DCC_AddEmbedField(embed, "Phone", field_value, true);

    format(field_value, sizeof(field_value), "```ID: %d```", skin);
    DCC_AddEmbedField(embed, "Skin", field_value, true);

    format(field_value, sizeof(field_value), "```HP: %.1f | AR: %.1f```", health, armor);
    DCC_AddEmbedField(embed, "Health & Armor", field_value, false);

    if(adminlevel > 0 || helperlevel > 0)
    {
        format(field_value, sizeof(field_value), "```Admin Level: %d | Helper Level: %d```", adminlevel, helperlevel);
        DCC_AddEmbedField(embed, "Staff", field_value, false);
    }

    if(warnings > 0)
    {
        format(field_value, sizeof(field_value), "```?? %d warning(s)```", warnings);
        DCC_AddEmbedField(embed, "Warns", field_value, true);
    }

    format(field_value, sizeof(field_value), "```%s```", strlen(marriedto) ? marriedto : "Single");
    DCC_AddEmbedField(embed, "Married To", field_value, true);

    format(field_value, sizeof(field_value), "```%s```", strlen(regdate) ? regdate : "Unknown");
    DCC_AddEmbedField(embed, "Account Created", field_value, true);

    DCC_SetEmbedFooter(embed, "Fastlife Roleplay | Profile System", "");

    DCC_SetEmbedImage(embed, "https://cdn.discordapp.com/attachments/1546461219462971423/1554951711792177202/474027b240cfd782.jpg");

    DCC_SendChannelEmbedMessage(channel, embed);

    return 1;
}

