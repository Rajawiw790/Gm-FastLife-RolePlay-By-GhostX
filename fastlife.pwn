CMD:jail(playerid, params[])
{
	new targetid, minutes, reason[128], id;

	if(pData[playerid][pAdmin] < 15)
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}
	if(gettime() - pData[playerid][pjail_LastUse] < 30)
	{
	    return SM(playerid, COLOR_SYNTAX, "You can only use this command every 30 second. Please wait %i more seconds.", 30 - (gettime() - pData[playerid][pjail_LastUse]));
	}
	if((id = GetNearbyTurf(playerid)) >= 0 && TurfInfo[id][tCapturer] != INVALID_PLAYER_ID)
	{
		return SCM(playerid, COLOR_GREY2, " You can't use this command in turf.");
	}
	if(sscanf(params, "uis[128]", targetid, minutes, reason))
	{
	    return SCM(playerid, COLOR_SYNTAX, "Usage: /jail [playerid] [minutes] [reason]");
	}
	if(!WC_IsPlayerSpawned(targetid))
	{
	    return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");
	}
	if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
    {
        return SCM(playerid, COLOR_SYNTAX, "Sorry Bro Mt9drx Tdir had cmd m3a Rank kbar mnk.");
    }
	if(!pData[targetid][pLogged])
	{
	    return SCM(playerid, COLOR_SYNTAX, "That player hasn't logged in yet. You can wait until they login or use /oprison.");
	}
	if(minutes < 1)
	{
	    return SCM(playerid, COLOR_SYNTAX, "The amount of minutes cannot be below one. Use /release instead.");
	}
	if(minutes > 20)
	{
	    return SCM(playerid, COLOR_SYNTAX, "The amount of minutes cannot be above 20. Use /oprison instead.");
	}

	PlayerTextDrawShow(targetid, customHUD[targetid][1]);

    pData[targetid][pJailType] = 2;
    pData[targetid][pJailTime] = minutes * 60;

	SetPlayerInJail(targetid);
	Dyuze(targetid, "Notice", "~w~Welcome to~n~~r~admin jail");

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET prisonedby = '%e', prisonreason = '%e' WHERE uid = %i", GetPlayerNameEx(playerid), reason, pData[targetid][pID]);
	mysql_tquery(connectionID, queryBuffer);

	GetPlayerName(playerid, pData[targetid][pPrisonedBy], MAX_PLAYER_NAME);
	strcpy(pData[targetid][pPrisonReason], reason, 128);

	Log_Write("log_punishments", "%s (uid: %i) prisoned %s (uid: %i) for %i minutes, reason: %s", GetPlayerNameEx(playerid), pData[playerid][pID], GetPlayerNameEx(targetid), pData[targetid][pID], minutes, reason);
    SMA(COLOR_RED, "AdmCmd: %s was prisoned for %i minutes by %s, reason: %s", GetRPName(targetid), minutes, GetRPName(playerid), reason);
    SM(targetid, COLOR_AQUA, "** You have been admin prisoned for %i minutes by %s.", minutes, GetRPName(playerid));
    pData[playerid][pjail_LastUse] = gettime();

    new target_name[MAX_PLAYER_NAME];
    GetPlayerName(targetid, target_name, sizeof(target_name));

    new hour, minute, second, day, month, year;
    gettime(hour, minute, second);
    getdate(year, month, day);

    format(g_jail_admin, 64, "%s", GetRPName(playerid));
    format(g_jail_target, 64, "%s", target_name);
    format(g_jail_reason, 128, "%s", reason);
    g_jail_minutes = minutes;
    g_jail_day     = day;
    g_jail_month   = month;
    g_jail_year    = year;
    g_jail_hour    = hour;
    g_jail_min     = minute;
    g_jail_sec     = second;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "SELECT discord_id FROM users WHERE username = '%e' LIMIT 1",
        target_name);
    mysql_tquery(connectionID, queryBuffer, "OnGetJailDiscordID", "");

    return 1;
}

forward OnGetJailDiscordID();
public OnGetJailDiscordID()
{
    new discord_id[32];

    if(cache_get_row_count(connectionID))
    {
        cache_get_field_content(0, "discord_id", discord_id, connectionID, sizeof(discord_id));
    }
    else
    {
        discord_id = "";
    }

    SendJailDiscordMessage(g_jail_admin, g_jail_target, g_jail_reason, g_jail_minutes,
        g_jail_day, g_jail_month, g_jail_year, g_jail_hour, g_jail_min, g_jail_sec,
        discord_id);

    return 1;
}

stock SendJailDiscordMessage(admin_name[], player_name[], reason[], minutes,
    day, month, year, hour, minute, second, discord_id[])
{
    if(jail_channel == DCC_INVALID_CHANNEL)
    {
        print("[DCC] ERROR: jail_channel is invalid!");
        return;
    }

    new title[128];
    new field_value[256];
    new full_msg[256];

    format(title, sizeof(title), "PLAYER JAILED - ADMIN JAIL");

    new DCC_Embed:embed = DCC_CreateEmbed();
    if(embed == DCC_Embed:0)
    {
        print("[DCC] ERROR: Failed to create embed!");
        return;
    }

    DCC_SetEmbedColor(embed, 0xFF6600);
    DCC_SetEmbedTitle(embed, title);
    DCC_SetEmbedDescription(embed, "A player has been jailed by an administrator.");
    DCC_SetEmbedImage(embed, "https://cdn.discordapp.com/attachments/1546461219462971423/1559509577610035250/2ba15301adf0f1f1.jpg?ex=6acf55f9&is=6ace0479&hm=eedf522aa6e73deb7e420f132cb0fb86079b373bed1a7a41d7bd483a416e362c");
    DCC_SetEmbedFooter(embed, "Fastlife Anti-Cheat System", "");

    format(field_value, sizeof(field_value), "```%s```", admin_name);
    DCC_AddEmbedField(embed, "Admin Name", field_value, true);

    format(field_value, sizeof(field_value), "```%s```", player_name);
    DCC_AddEmbedField(embed, "Jailed Player", field_value, true);

    format(field_value, sizeof(field_value), "```%d Minutes```", minutes);
    DCC_AddEmbedField(embed, "Jail Duration", field_value, true);

    format(field_value, sizeof(field_value), "```%s```", reason);
    DCC_AddEmbedField(embed, "Jail Reason", field_value, false);

    format(field_value, sizeof(field_value), "```%02d:%02d:%02d```", hour, minute, second);
    DCC_AddEmbedField(embed, "Time", field_value, true);

    format(field_value, sizeof(field_value), "```%02d/%02d/%d```", day, month, year);
    DCC_AddEmbedField(embed, "Date", field_value, true);

    if(strlen(discord_id) >= 17)
    {
        format(full_msg, sizeof(full_msg), "<@%s> - NEW JAIL ALERT", discord_id);
    }
    else
    {
        format(full_msg, sizeof(full_msg), "NEW JAIL ALERT");
    }

    DCC_SendChannelEmbedMessage(jail_channel, embed, full_msg);
}

CMD:ojail(playerid, params[])
{
	new username[MAX_PLAYERS], minutes, reason[128], id;
    new targetid;

	if(pData[playerid][pAdmin] < 15)
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}
	if(gettime() - pData[playerid][pjail_LastUse] < 60)
	{
	    return SM(playerid, COLOR_SYNTAX, "You can only use this command every 1 minutes. Please wait %i more seconds.", 60 - (gettime() - pData[playerid][pjail_LastUse]));
	}
	if((id = GetNearbyTurf(playerid)) >= 0 && TurfInfo[id][tCapturer] != INVALID_PLAYER_ID)
	{
		return SCM(playerid, COLOR_GREY2, " You can'tuse this commandin turf.");
	}
	if(sscanf(params, "s[24]is[128]", username, minutes, reason))
	{
	    return SCM(playerid, COLOR_SYNTAX, "Usage: /ojail [username] [minutes] [reason]");
	}
	if(minutes < 1)
	{
	    return SCM(playerid, COLOR_SYNTAX, "The amount of minutes cannot be below one. Use /release instead.");
	}
	if(minutes > 20)
	{
	    return SCM(playerid, COLOR_SYNTAX, "The amount of minutes cannot be below one. Use /release instead.");
	}
	if(IsPlayerOnline(username))
	{
	    return SCM(playerid, COLOR_SYNTAX, "That player is already online and logged in. Use /prison instead.");
	}
	if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
    {
        return SCM(playerid, COLOR_SYNTAX, "Sorry Bro Mt9drx Tdir had cmd m3a Rank kbar mnk.");
    }

	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT adminlevel, uid FROM users WHERE username = '%e'", username);
	mysql_tquery(connectionID, queryBuffer, "OnAdminOfflinePrison", "isis", playerid, username, minutes, reason);
	pData[playerid][pjail_LastUse] = gettime();
	return 1;
}

CMD:release(playerid, params[])
{
    new targetid, reason[128];

    if(pData[playerid][pAdmin] < 15)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
    }

    if(targetid == playerid && pData[playerid][pAdmin] < 12)
    {
        return SCM(playerid, COLOR_SYNTAX, "You can't use this command on yourself.");
    }

    if(sscanf(params, "us[128]", targetid, reason))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /release [playerid] [reason]");
    }

    if(!WC_IsPlayerSpawned(targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");
    }

    if(!pData[targetid][pJailType])
    {
        return SCM(playerid, COLOR_SYNTAX, "That player is not jailed.");
    }

    pData[targetid][pJailTime] = 1;
    PlayerTextDrawHide(targetid, customHUD[targetid][1]);
    SMA(COLOR_RED, "AdmCmd: %s was released from jail/prison by %s, reason: %s", GetRPName(targetid), GetRPName(playerid), reason);
    return 1;
}

CMD:pinfo(playerid, params[])
{
    new targetid;

    if(pData[playerid][pAdmin] < 46)
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
    {
        return SCM(playerid, COLOR_SYNTAX, "Sorry Bro Mt9drx Tdir had cmd m3a Rank kbar mnk.");
    }
    if(sscanf(params, "u", targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /pinfo [playerid]");
    }
    if(!IsPlayerConnected(targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");
    }

    SM(playerid, COLOR_GREY1, "(ID: %i) - (Name: %s) - (Ping: %i) - (Packet Loss: %.1f%c)", targetid, GetRPName(targetid), GetPlayerPing(targetid), NetStats_PacketLossPercent(targetid), '%');
    return 1;
}

CMD:admins(playerid, params[])
{
	if(pData[playerid][pAdmin] < 1)
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}

	SCM(playerid, SERVER_COLOR, "Admins Online");

	foreach(new i : Player)
	{
	    if(pData[i][pAdmin] > 0)
		{
			new division[5];
			strcpy(division, GetAdminDivision(i));
            if(strlen(division) < 1) division = "None";
			if(!strcmp(pData[i][pAdminName], "None", true))
            	SM(playerid, COLOR_GREY2, "(ID: %i) %s %s - Division: %s - Status: %s - "SVRCLR"Reports Handled: %i{C8C8C8} - Tabbed: %s", i, GetAdminRank(i), pData[i][pUsername], division, (pData[i][pAdminDuty]) ? (""SVRCLR"On Duty") : ("Off Duty"), pData[i][pReports], (pData[i][pAFK]) ? ("Yes") : ("No"));
        	else
				SM(playerid, COLOR_GREY2, "(ID: %i) %s %s (%s) - Division: %s - Status: %s - "SVRCLR"Reports Handled: %i{C8C8C8} - Tabbed: %s", i, GetAdminRank(i), pData[i][pUsername], pData[i][pAdminName], division, (pData[i][pAdminDuty]) ? (""SVRCLR"On Duty") : ("Off Duty"), pData[i][pReports], (pData[i][pAFK]) ? ("Yes") : ("No"));
		}
	}
	return 1;
}

CMD:checknewbies(playerid, params[])
{
    new targetid;
    if(!pData[playerid][pAdmin] && pData[playerid][pHelper] < 3)
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    if(sscanf(params, "u", targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "Usage: /checknewbies [playerid]");
    }
    if(pData[playerid][pAdmin] < pData[targetid][pAdmin])
    {
        return SCM(playerid, COLOR_SYNTAX, "Sorry Bro Mt9drx Tdir had cmd m3a Rank kbar mnk.");
    }
    SM(playerid, COLOR_SYNTAX, "Level %i Player %s has used newbie {00FF00}%s times.", pData[targetid][pLevel], GetRPName(targetid), FormatNumber(pData[targetid][pNewbies], 0));
    return 1;
}

CMD:helpers(playerid, params[])
{
    if(pData[playerid][pHelper] < 3)
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    SCM(playerid, SERVER_COLOR1, "Helpers Online:");

    foreach(new i : Player)
    {
        if(pData[i][pHelper] > 0 && !pData[i][pPassport])
        {
            if(pData[playerid][pAdmin] > 0 || pData[playerid][pHelper] > 0)
            SM(playerid, COLOR_WHITE, "(ID: %i) %s %s - Help Requests: %s - Newbies: %s", i, GetHelperRank(i), GetRPName(i), FormatNumber(pData[i][pHelpRequests], 0), FormatNumber(pData[i][pNewbies], 0));
            else
            SM(playerid, COLOR_WHITE, "(ID: %i) %s %s", i, GetHelperRank(i), GetRPName(i));
        }
    }

    return 1;
}

