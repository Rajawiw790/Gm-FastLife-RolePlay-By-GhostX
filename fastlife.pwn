{
	new string[203];
	format(string, sizeof(string), "%s", AutoMessages[random(sizeof(AutoMessages))]);
	foreach(Player, i)
	{
	    if(pData[i][pLevel] < 100)
	    {
			SendClientMessage(i, COLOR_RED, string);
		}
	}
	return 1;
}

stock n_ChangeVehicleColor(vehicleID, color1, color2)
{
    VehicleInfo[vehicleID - 1][vColor1] = color1;
    VehicleInfo[vehicleID - 1][vColor2] = color2;
    return ChangeVehicleColor(vehicleID, color1, color2);
}

