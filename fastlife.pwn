	case DIALOG_TWEET:
	{
        {
            if (response)
            {
                new currentTime = gettime();

                if (currentTime - TweetTimer[playerid] < TWEET_COOLDOWN)
                {
                    new remaining = TWEET_COOLDOWN - (currentTime - TweetTimer[playerid]);
                    new msg[64];
                    format(msg, sizeof(msg), "Please wait %d seconds before sending another Facebook.", remaining);
                    SCM(playerid, COLOR_RED, msg);
                    return 1;
                }

                strcpy(tweet, inputtext);
                SMA(COLOR_WHITE, ""BLUE"[TWITTER-FST]"SVRCLR"%s: %s", GetRPName(playerid), tweet);
                PlayAudioStreamForPlayer(playerid,"http://d.top4top.io/m_3285gapxu1.mp3");

                TweetTimer[playerid] = currentTime;
            }
        }
    }
