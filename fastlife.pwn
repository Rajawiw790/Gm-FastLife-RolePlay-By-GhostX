    CMD:vc(playerid)
    {
        new string[2048], status0[128], status1[128], status2[128], status3[128];
        strcat(string, "Channel\tToggle\tDescription");
        if(GetPVarInt(playerid, "VoiceChat") == 1)
        {
            status0 = "{009900}ON{FFFFFF}";
        }
        else
        {
            status0 = "{FF0000}OFF{FFFFFF}";
        }
        if(GetPVarInt(playerid, "VoiceChat") == 2)
        {
            status1 = "{009900}ON{FFFFFF}";
        }
        else
        {
            status1 = "{FF0000}OFF{FFFFFF}";
        }
        if(pData[playerid][pFactionRadio] == 0)
        {
            status2 = "{ff0000}OFF{FFFFFF}";
        }
        else
        {
            status2 = "{009900}ON{FFFFFF}";
        }
        if(pData[playerid][pGangRadio] == 0)
        {
            status3 = "{ff0000}OFF{FFFFFF}";
        }
        else
        {
            status3 = "{009900}ON{FFFFFF}";
        }
        format(string, sizeof(string), "%s\nLocal\t%s\tToggle For Local Voice\
        \nGlobal\t%s\tToggle For Global Voice\
        \nFaction\t%s\tRadio Channel for your faction\
        \nGang\t%s\tRadio Channel for your Gang.", string, status0, status1, status2, status3);
        ShowPlayerDialog(playerid, DIALOG_VOICECHAT, DIALOG_STYLE_TABLIST_HEADERS, "Voice Menu", string, "Proceed", "Close");
        return 1;
    }
    forward DestroyRentalTimer(timer_playerid, timer_vehicleid);
    public DestroyRentalTimer(timer_playerid, timer_vehicleid)
    {
        if (GetVehicleModel(timer_vehicleid) == -1) return 1;


        new i;
        for (i = 0; i < MAX_PLAYERS; i++)
        {
            if (IsPlayerConnected(i) && GetPlayerVehicleID(i) == timer_vehicleid)
            {
                return 1;
            }
        }

        DestroyVehicle(timer_vehicleid);


        return 1;
    }
