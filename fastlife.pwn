        cache_get_field_content(0, "bannedby", bannedby);
        cache_get_field_content(0, "date", date);
        cache_get_field_content(0, "reason", reason);
        hours = cache_get_field_content_int(0, "hours");

        new dialog_string[1024];

        if(cache_get_field_content_int(0, "permanent"))
        {
            format(dialog_string, sizeof(dialog_string),
                "{FF0000}------------------------------------------\n\
                {FFFFFF}You are {FF0000}Permanently Banned{FFFFFF} from this server!\n\
                {FF0000}------------------------------------------\n\n\
                {FFD700}Banned By:{FFFFFF} %s\n\
                {FFD700}Date:{FFFFFF} %s\n\
                {FFD700}Reason:{FFFFFF} %s\n\n\
                {FF0000}------------------------------------------\n\
                {FFFFFF}You can appeal your ban at:{FFD700} "SERVER_URL"\n\
                {FF0000}------------------------------------------",
                bannedby, date, reason);
        }
        else
        {
            format(dialog_string, sizeof(dialog_string),
                "{FF0000}------------------------------------------\n\
                {FFFFFF}You are {FF0000}Banned{FFFFFF} from this server!\n\
                {FF0000}------------------------------------------\n\n\
                {FFD700}Banned By:{FFFFFF} %s\n\
                {FFD700}Date:{FFFFFF} %s\n\
                {FFD700}Duration:{FFFFFF} %d hours\n\
                {FFD700}Reason:{FFFFFF} %s\n\n\
                {FF0000}------------------------------------------\n\
                {FFFFFF}You can appeal your ban at:{FFD700} "SERVER_URL"\n\
                {FF0000}------------------------------------------",
                bannedby, date, hours, reason);
        }

        ShowPlayerDialog(extraid, 0, DIALOG_STYLE_MSGBOX, "{FF0000}BANNED", dialog_string, "", "");

        SAM(COLOR_YELLOW, "AdmWarning: %s has attempted to log in while banned.", playername);

        SetTimerEx("KickPlayerDelayed", 3000, false, "i", extraid);
    }
    else
    {
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "SELECT uid FROM users WHERE username = '%s'", GetPlayerNameEx(extraid));
        mysql_tquery(connectionID, queryBuffer, "OnQueryFinished", "ii", THREAD_LOOKUP_ACCOUNT, extraid);
    }
}
        case THREAD_LOOKUP_ACCOUNT:
        {
            if(rows)
            {
                ShowDialogToPlayer(extraid, DIALOG_LOGIN);
                PlayAudioStreamForPlayer(extraid,"http://j.top4top.io/m_3734eo50c1.mp3");
            }
            else
            {
                if(strfind(GetPlayerNameEx(extraid), "_") == -1)
