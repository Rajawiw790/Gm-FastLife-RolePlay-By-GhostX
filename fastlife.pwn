        PlayerTextDrawShow(playerid, ProgressInteractionPTD[playerid][3]);

        ProgresPlayerTimer[playerid] = SetTimerEx("ProgressUpdate", 50, true, "i", playerid);
        return 1;
    }
stock CheckPlayerRewards(playerid)
{
    new Float:x, Float:y, Float:z, Float:a;
    //new queryBuffer[256];

    if(pData[playerid][pHours] >= 9 && !pData[playerid][pGotBaggie])
    {
        GetPlayerPos(playerid, x, y, z);
        GetPlayerFacingAngle(playerid, a);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
        "INSERT INTO vehicles (ownerid, owner, modelid, pos_x, pos_y, pos_z, pos_a, color1, color2) \
        VALUES(%i, '%s', %i, '%f', '%f', '%f', '%f', %i, %i)",
        pData[playerid][pID],
        GetPlayerNameEx(playerid),
        478,
        x + 2.0 * floatsin(-a, degrees),
        y + 2.0 * floatcos(-a, degrees),
        z,
        a,
        0, 0);

        mysql_tquery(connectionID, queryBuffer);

        pData[playerid][pGotBaggie] = 1;
          mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET gotbaggie = %i WHERE uid = %i", pData[playerid][pGotBaggie], pData[playerid][pID]);
           mysql_tquery(connectionID, queryBuffer);
        ShowSucces(playerid, "Mabrok! 3tak roxo w ghost Walton hit wselti 9 hours l3b ");
        SCM(playerid, COLOR_SYNTAX, "Mabrouk! 3tak roxo w ghost Baggie hit wselti 7 hours l3b ");
    }

    return 1;
}
stock StartRob(playerid)
{
    IsRobbing[playerid] = true;
    InputCount[playerid] = 0;
    ShowDots[playerid] = true;

    for(new i=0;i<MAX_DIGITS;i++)
    {
        RobCode[playerid][i] = random(10);
        PlayerInput[playerid][i] = -1;

        TextDrawSetString(ROBSTPRO[2+i], ".");
        TextDrawColor(ROBSTPRO[2+i], COLOR_WHITE);
        TextDrawShowForPlayer(playerid, ROBSTPRO[2+i]);
    }

    for(new i=0;i<32;i++)
        TextDrawShowForPlayer(playerid, ROBSTPRO[i]);

    SelectTextDraw(playerid, COLOR_WHITE);
}
stock AddDigit(playerid, digit)
{
    if(InputCount[playerid] >= MAX_DIGITS) return;

    if(InputCount[playerid] == 0 && ShowDots[playerid])
    {
        for(new i=0;i<MAX_DIGITS;i++)
        {
            TextDrawSetString(ROBSTPRO[2+i], "_");
            TextDrawShowForPlayer(playerid, ROBSTPRO[2+i]);
        }
        ShowDots[playerid] = false;
    }

    new slot = InputCount[playerid];
    PlayerInput[playerid][slot] = digit;

    new str[4];
    format(str, sizeof(str), "%d", digit);

    TextDrawSetString(ROBSTPRO[2+slot], str);
    TextDrawColor(ROBSTPRO[2+slot], COLOR_WHITE);
    TextDrawShowForPlayer(playerid, ROBSTPRO[2+slot]);

    InputCount[playerid]++;
}
stock RemoveDigit(playerid)
{
    if(InputCount[playerid] <= 0) return;

    InputCount[playerid]--;
    new slot = InputCount[playerid];

    PlayerInput[playerid][slot] = -1;

    TextDrawSetString(ROBSTPRO[2+slot], "_");
    TextDrawColor(ROBSTPRO[2+slot], COLOR_WHITE);
    TextDrawShowForPlayer(playerid, ROBSTPRO[2+slot]);
}
