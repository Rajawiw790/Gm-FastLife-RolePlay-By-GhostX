SetPlayerInHospital(playerid, time = 15, type = -1)
{

	pData[playerid][pHospitalType] = (type == -1) ? (random(2) + 1) : (type);
    pData[playerid][pHospitalTime] = time;
    pData[playerid][pHospital] = 1;

    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
    TogglePlayerControllable(playerid, 0);
 	GameTextForPlayer(playerid, "~w~Reviving...", 1500, 3);
    new rand = random(sizeof(hospitalspawns));
	SetPlayerPos(playerid, hospitalspawns[rand][0], hospitalspawns[rand][1], hospitalspawns[rand][2]);
	SetPlayerFacingAngle(playerid, hospitalspawns[rand][2]);
	ApplyAnimation(playerid, "SWAT", "gnstwall_injurd", 4.1, 1, 0, 0, 0, 0);
    //SetPlayerCameraPos(playerid, 1312.500366, 1562.677124, 3011.752197);
    //SetPlayerCameraLookAt(playerid, 1312.741088, 1558.956542, 3011.752197);
}

forward Checkin(playerid);
public Checkin(playerid)
{
	new rand = random(sizeof(blackhospitalspawns));
	SetFreezePos(playerid, blackhospitalspawns[rand][0], blackhospitalspawns[rand][1], blackhospitalspawns[rand][2]);
	SetPlayerFacingAngle(playerid, 92.13);
	SetPlayerInterior(playerid, 0);
	SetCameraBehindPlayer(playerid);

	pData[playerid][pInjured] = 0;
    pData[playerid][pHunger] = 25;
    pData[playerid][pHungerTimer] = 0;
    pData[playerid][pThirst] = 25;
    pData[playerid][pThirstTimer] = 0;
    pData[playerid][pTpee] = 25;
    pData[playerid][pTpeeTimer] = 0;

    TogglePlayerControllable(playerid, 1);
    SetPlayerHealth(playerid, 100.0);
    ClearAnimations(playerid, 1);
    GivePlayerCash(playerid, -150);
    UpdateDynamic3DTextLabelText(InjuredLabel[playerid], COLOR_DOCTOR, "");
	return 1;
}



