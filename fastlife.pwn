CMD:robfleeca(playerid, params[])
{
    new index = -1;

    for(new i = 0; i < sizeof(fleecaPoints); i++)
    {
        if(IsPlayerInRangeOfPoint(playerid, 5.0, fleecaPoints[i][0], fleecaPoints[i][1], fleecaPoints[i][2]))
        {
            index = i;
            break;
        }
    }

    if(index == -1)
        return SCM(playerid, COLOR_GREY2, "You are not at a Fleeca bank location!");

    if(grobfleecaon == 0)
        return SCM(playerid, COLOR_GREY, "Rob fleeca is off.");

    if(pData[playerid][pLevel] < 2)
        return SCM(playerid, COLOR_RED, "You need level 2 to rob!");

    new iSuccess;
    foreach(Player, j)
    {
        if(IsLawEnforcement(j) && pData[j][pDuty] == 1)
        {
            iSuccess++;
        }
    }

    if(iSuccess < 2)
        return SCM(playerid, COLOR_GREY, "There need to be 2+ LEO online in order to rob the fleeca bank!");

    foreach(new x : Player)
    {
        if(IsLawEnforcement(x))
        {
            SM(x, COLOR_ROYALBLUE, "** HQ: A robbery is occurring at the Fleeca Bank. All units respond immediately.");
            SetPlayerCheckpoint(x, fleecaPoints[index][0], fleecaPoints[index][1], fleecaPoints[index][2], 3.0);
        }
    }

    SCM(playerid, COLOR_GREY2, "** Wait until cops arrive for roleplay purposes. (( You can door shout by inputting '/ds' ))");
    ShowProgressbar(playerid, "Robing...", 10);
    SetTimerEx("showfleec", 10500, false, "i", playerid);
    SetTimerEx("showfleeca", 11000, false, "i", playerid);
    SetTimerEx("showfleeca1", 11500, false, "i", playerid);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.1, 1, 0, 0, 0, 0, 1);
    SetTimerEx("showfleeca2", 12000, false, "i", playerid);
    SetTimerEx("showfleeca3", 12500, false, "i", playerid);
    SetTimerEx("showfleeca4", 13000, false, "i", playerid);

    return 1;
}
