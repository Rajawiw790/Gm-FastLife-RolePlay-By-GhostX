    if(response)
    {
        new giveplayerid, string[128];

        if(sscanf(inputtext, "u", giveplayerid))
        {
            SCM(playerid, COLOR_SYNTAX, "Invalid player ID/Name!");
            ShowDialogToPlayer(playerid, DIALOG_BTRANSFER1);
            return 1;
        }

        if(giveplayerid == playerid)
        {
            SCM(playerid, COLOR_SYNTAX, "You cannot transfer money to yourself!");
            ShowDialogToPlayer(playerid, DIALOG_BTRANSFER1);
            return 1;
        }

        if(!IsPlayerConnected(giveplayerid))
        {
            SCM(playerid, COLOR_RED, "This player is offline or disconnected!");
            ShowDialogToPlayer(playerid, DIALOG_BTRANSFER1);
            return 1;
        }

        SetPVarInt(playerid, "banktransfer", giveplayerid);

        format(string, sizeof(string), "Enter the amount you want to transfer to %s:", GetRPName(giveplayerid));
        ShowPlayerDialog(playerid, DIALOG_BTRANSFER, DIALOG_STYLE_INPUT,
            "{FFD700}Bank Transfer",
            string,
            "Transfer", "Cancel");
    }
    else
    {
        SCM(playerid, COLOR_GREY, "Transfer cancelled.");
    }
    return 1;
    }
    case DIALOG_CUFF:
    {
        if(response)
        {
            new id;

            if(sscanf(inputtext, "i", id))
            {
                return ShowDialogToPlayer(playerid, DIALOG_CUFF);
            }

            if(!IsPlayerConnected(id) || !IsPlayerInRangeOfPlayer(playerid, id, 5.0))
            {
                SendClientMessage(playerid, COLOR_GREY, "That player is not connected or not in range");
                ShowDialogToPlayer(playerid, DIALOG_CUFF);
                return 1;
            }

            pData[id][pCuffed] = 1;
            SetPlayerSpecialAction(id, SPECIAL_ACTION_CUFFED);
            TogglePlayerControllable(id, 0);
            PlayAudioStreamForPlayer(playerid, "http://c.top4top.io/m_2576egwh10.mp3");
            PlayAudioStreamForPlayer(id, "http://c.top4top.io/m_2576egwh10.mp3");


            SendProximityMessage(playerid, 20.0, SERVER_COLOR1, "**{C2A2DA} %s tightens a pair of handcuffs around %s's wrists.", GetRPName(playerid), GetRPName(id));
            GameTextForPlayer(id, "~r~Cuffed", 3000, 3);
        }
