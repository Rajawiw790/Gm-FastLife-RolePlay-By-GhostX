stock bool:IsPlayerAtFuelStation(playerid)
{
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);

    for (new i = 0; i < MAX_FUEL_STATIONS; i++)
    {
        if (IsPlayerInRangeOfPoint(playerid, FUEL_RANGE, FuelStation[i][FuelX], FuelStation[i][FuelY], FuelStation[i][FuelZ]))
        {
            return true;
        }
    }
    return false;
}

