            TextDrawShowForPlayer(playerid, publicpassport[13]);
            TextDrawShowForPlayer(playerid, publicpassport[14]);
            TextDrawShowForPlayer(playerid, publicpassport[15]);
            TextDrawShowForPlayer(playerid, publicpassport[16]);
            TextDrawShowForPlayer(playerid, publicpassport[17]);
            TextDrawShowForPlayer(playerid, publicpassport[18]);
            TextDrawShowForPlayer(playerid, publicpassport[19]);
            TextDrawShowForPlayer(playerid, publicpassport[20]);
