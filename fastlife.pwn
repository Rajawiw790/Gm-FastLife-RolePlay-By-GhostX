CMD:useuse(playerid, params[])
{
    new string[512];
    new list[512];
    new pot_amount = pData[playerid][pPot];
    new crack_amount = pData[playerid][pCrack];
    new meth_amount = pData[playerid][pMeth];
    new pain_amount = pData[playerid][pPainkillers];
    new carspin_amount = pData[playerid][pCarSpinCard];
    new spin_amount = pData[playerid][pSpinCard];
    new food_amount = pData[playerid][pFood];
    new drink_amount = pData[playerid][pDrink];

    // ????? ???????
    format(list, sizeof(list),
        "Pot (%d gram)\nCrack (%d gram)\nMeth (%d gram)\nPainkillers (%d pill)\nnos ton (%d nsas)\n9ar3a lma (%d 9ar3)\nCar Spin Card (x%d)\nSpin Card (x%d)",
        pot_amount, crack_amount, meth_amount, pain_amount,food_amount, drink_amount, carspin_amount, spin_amount);

    format(string, sizeof(string),
        "{FF0000}====================================\n\
        {FFFFFF}              USE MENU\n\
        {FF0000}====================================\n\n\
        {00FF00}* Pot{FFFFFF} ........... {FFD700}%d gram(s)\n\
        {FF0000}* Crack{FFFFFF} ......... {FFD700}%d gram(s)\n\
        {FFA500}* Meth{FFFFFF} .......... {FFD700}%d gram(s)\n\
        {FF69B4}* Painkillers{FFFFFF} ... {FFD700}%d pill(s)\n\n\
        {FF69B4}* 9ar3a lma{FFFFFF} ... {FFD700}%d 9ar3a(s)\n\n\
        {FF69B4}* nos ton{FFFFFF} ... {FFD700}%d nsas(s)\n\n\
        {FFD700}====================================\n\n\
        {00FF00}* Car Spin Card{FFFFFF} . {FFD700}x%d\n\
        {00FF00}* Spin Card{FFFFFF} .... {FFD700}x%d\n\n\
        {FF0000}====================================",
        pot_amount, crack_amount, meth_amount, pain_amount, food_amount, drink_amount, carspin_amount, spin_amount);

    ShowPlayerDialog(playerid, DIALOG_USE_DRUG, DIALOG_STYLE_LIST,
        "{FF0000}USE MENU",
        list,
        "Use", "Cancel");
    return 1;
}

CMD:spin(playerid, params[])
{
    if(pData[playerid][pLevel] < 5)
        return SCM(playerid, COLOR_RED, "You need Level 5 to spin!");

    if(pData[playerid][pSpinCard] < 1)
        return SCM(playerid, COLOR_RED, "You don't have a Spin Card!");

    pData[playerid][pSpinCard]--;

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET spincard = %d WHERE uid = %d", pData[playerid][pSpinCard], pData[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    new prizeIndex = random(sizeof(SpinPrizes));

    TogglePlayerControllable(playerid, 0);

    SetTimerEx("SpinFinish", 10000, false, "ii", playerid, prizeIndex);
    ShowProgressbar(playerid, "Spinning", 10);
    GameTextForPlayer(playerid, "~w~Spinning...", 10000, 3);
    SCM(playerid, COLOR_YELLOW, "Spin started! Good luck!");

    return 1;
}

CMD:mycards(playerid, params[])
{
    new msg[128];
    format(msg, sizeof(msg), "You have %d Spin Card(s) | Level: %d",
        pData[playerid][pSpinCard], pData[playerid][pLevel]);
    SendClientMessage(playerid, 0xFFA500FF, msg);
    return 1;
}

CMD:givecard(playerid, params[])
{
    if(pData[playerid][pAdmin] < 46)
        return SendClientMessage(playerid, 0xFF0000FF, "Admin level 46+ only!");

    new targetid, amount;
    if(sscanf(params, "ui", targetid, amount))
        return SendClientMessage(playerid, 0xFF0000FF, "Usage: /givecard [playerid] [amount]");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, 0xFF0000FF, "Player not connected!");

    pData[targetid][pSpinCard] += amount;

    new msg[128];
    format(msg, sizeof(msg), "You received %d Spin Card(s) from admin!", amount);
    SendClientMessage(targetid, 0x00FF00FF, msg);

    format(msg, sizeof(msg), "You gave %d Spin Card(s) to player %d", amount, targetid);
    SendClientMessage(playerid, 0x00FF00FF, msg);

    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET spincard = %i WHERE uid = %i", pData[playerid][pSpinCard], pData[playerid][pID]);
    mysql_tquery(connectionID, queryBuffer);

    return 1;
}

CMD:givebackpack(playerid, params[])
{
    new targetid, size[10];
    if(strcmp(pData[playerid][pUsername], "Eric_Estrada", true) != 0)
   if(strcmp(pData[playerid][pUsername], "GHOST_X", true) != 0)
   if(strcmp(pData[playerid][pUsername], "ghost_", true) != 0)
   if(strcmp(pData[playerid][pUsername], "DEV_ROXO", true) != 0)
	{
	    return SCM(playerid, COLOR_SYNTAX, "TIR B ZKEK");
	}
    if(pData[playerid][pAdmin] < 46)
    {
        return ShowError(playerid, "M3ANDKX L7A9 DIR HAD CMD A BRO");
    }
    if(sscanf(params, "us[14]S()[32]", targetid, size))
    {
        SCM(playerid, COLOR_SYNTAX, "Usage: /givebackpack [playerid] [size]");
        SCM(playerid, COLOR_WHITE, "Sizes:   Small, Medium, Large");
        return 1;
    }
    if(!IsPlayerConnected(targetid))
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected.");
    }
    if(!strcmp(size, "small", true))
    {
        pData[targetid][pBackpack] = 1;
        SM(targetid, COLOR_WHITE, "** %s has given you a small backpack.", GetRPName(playerid));
        SAM(COLOR_RED, "AdmCmd:"WHITE" %s has given %s a small backpack.", GetRPName(playerid), GetRPName(targetid));
    }
    if(!strcmp(size, "medium", true))
    {
        pData[targetid][pBackpack] = 2;
        SM(targetid, COLOR_WHITE, "** %s has given you a medium backpack.", GetRPName(playerid));
        SAM(COLOR_RED, "AdmCmd:"WHITE" %s has given %s a medium backpack.", GetRPName(playerid), GetRPName(targetid));
    }
    if(!strcmp(size, "large", true))
    {
        pData[targetid][pBackpack] = 3;
        SM(targetid, COLOR_WHITE, "** %s has given you a large backpack.", GetRPName(playerid));
        SAM(COLOR_RED, "AdmCmd:"WHITE" %s has given %s a large backpack.", GetRPName(playerid), GetRPName(targetid));
    }
    return 1;
}
CMD:give(playerid, params[])
{
    new targetid, option[14], param[32], amount;

    if(sscanf(params, "us[14]S()[32]", targetid, option, param))
    {
        SCM(playerid, COLOR_SYNTAX, "Usage: /give [playerid] [option]");
        SCM(playerid, COLOR_WHITE, "Available options: Weapon, Sosis, Materials, Pot, crack, Meth, Painkillers, Cigars, Spraycans");
        SCM(playerid, COLOR_WHITE, "Available options: GasCan, Seeds, Ephedrine, DirtyCash, Diamonds");
        SCM(playerid, COLOR_WHITE, "Available options: Bandage, Medkit, Repairkit, Food, Drink, Parts");
        SCM(playerid, COLOR_AQUA, "Available options: Plactic, Laptop, Lockpick, Metalscrap, Handcuff, Vest, Copper, Glass, Steel, Rubber");
        SCM(playerid, SERVER_COLOR1, "Available options: bitcoin, PlatinumBar, IronBar, MetalBar");
        return 1;
    }
    if(!IsPlayerConnected(targetid) || !IsPlayerInRangeOfPlayer(playerid, targetid, 5.0))
    {
        return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected or out of range.");
    }
    if(targetid == playerid)
    {
        return SCM(playerid, COLOR_SYNTAX, "You can't use this command on yourself.");
    }
    if(pData[playerid][pTazedTime] > 0 || pData[playerid][pInjured] > 0 || pData[playerid][pHospital] > 0 || pData[playerid][pTied] > 0 || pData[playerid][pTied] > 0 || pData[playerid][pCuffed] > 0 || pData[playerid][pJailTime] > 0 || pData[playerid][pJoinedEvent] > 0 || pData[playerid][pPaintball])
    {
        return SCM(playerid, COLOR_SYNTAX, "You can't use this command at the moment.");
    }
    if(!strcmp(option, "weapon", true))
    {
        new weaponid = GetScriptWeapon(playerid);

        if(!weaponid)
        {
            return SCM(playerid, COLOR_SYNTAX, "You must be holding the weapon you're willing to give away.");
        }
        if(pData[targetid][pWeapons][weaponSlotIDs[weaponid]] > 0)
        {
            return SCM(playerid, COLOR_SYNTAX, "That player already has a weapon in that slot.");
        }
        if(pData[targetid][pWeaponRestricted] > 0)
        {
            return SCM(playerid, COLOR_SYNTAX, "That player is either weapon restricted or played less than two playing hours.");
        }
        if(pData[playerid][pFaction] >= 0 && pData[targetid][pFaction] != pData[playerid][pFaction])
        {
            return SCM(playerid, COLOR_SYNTAX, "You can only give away weapons to your own faction members.");
        }

        GiveWeapon(targetid, weaponid);
        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
        RemovePlayerWeapon(playerid, weaponid);

        SM(targetid, COLOR_AQUA, "%s has given you their %s.", GetRPName(playerid), GetWeaponNameEx(weaponid));
        SM(playerid, COLOR_AQUA, "You have given %s your %s.", GetRPName(targetid), GetWeaponNameEx(weaponid));

        SendProximityMessage(playerid, 20.0, SERVER_COLOR1, "**{C2A2DA} %s passes over their %s to %s.", GetRPName(playerid), GetWeaponNameEx(weaponid), GetRPName(targetid));
        Log_Write("log_give", "%s (uid: %i) gives their %s to %s (uid: %i)", GetPlayerNameEx(playerid), pData[playerid][pID], GetWeaponNameEx(weaponid), GetPlayerNameEx(targetid), pData[targetid][pID]);
    }
    else if(!strcmp(option, "plactic", true))
    {
        if(sscanf(param, "i", amount))
        {
            return SCM(playerid, COLOR_SYNTAX, "Usage: /give [playerid] [plactic] [amount]");
        }
        if(amount < 1 || amount > pData[playerid][pPlactic])
        {
            return SCM(playerid, COLOR_WHITE, "Insufficient amount.");
        }


        pData[playerid][pPlactic] -= amount;
        pData[targetid][pPlactic] += amount;
        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET plactic = %i WHERE uid = %i", pData[playerid][pPlactic], pData[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET plactic = %i WHERE uid = %i", pData[targetid][pPlactic], pData[targetid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        SM(targetid, COLOR_AQUA, "%s has given you %i plactic.", GetRPName(playerid), amount);
        SM(playerid, COLOR_AQUA, "You have given %i plactic to %s.", amount, GetRPName(targetid));

        SendProximityMessage(playerid, 20.0, SERVER_COLOR1, "**{C2A2DA} %s gives some plactic to %s.", GetRPName(playerid), GetRPName(targetid));
        new szString[128];
        format(szString, sizeof(szString), "%s (uid: %i) gives %i plactic to %s (uid: %i)", GetPlayerNameEx(playerid), pData[playerid][pID], amount, GetPlayerNameEx(targetid), pData[targetid][pID]);
        Log_Write("log_give", "%s (uid: %i) gives %i plactic to %s (uid: %i)", GetPlayerNameEx(playerid), pData[playerid][pID], amount, GetPlayerNameEx(targetid), pData[targetid][pID]);
    }
    else if(!strcmp(option, "goldbar", true))
    {
        if(sscanf(param, "i", amount))
        {
            return SCM(playerid, COLOR_SYNTAX, "Usage: /give [playerid] [goldbar] [amount]");
        }
        if(amount < 1 || amount > pData[playerid][pBarGold])
        {
            return SCM(playerid, COLOR_WHITE, "Insufficient amount.");
        }


        pData[playerid][pBarGold] -= amount;
