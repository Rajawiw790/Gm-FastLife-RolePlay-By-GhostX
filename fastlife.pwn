forward PlayerSpawn(playerid);
public PlayerSpawn(playerid)
{
    if(pData[playerid][pLogged] && pData[playerid][pTutorial])
    {
        pData[playerid][pTutorial] = 0;
        pData[playerid][pSetup] = 0;
        pData[playerid][pHours] = 0;
        pData[playerid][pAdmin] = 0;

        pData[playerid][pSkin] = 26;
        SetPlayerSkin(playerid, 26);

        SetPlayerPos(playerid, 1686.862915, -2238.969482, 13.546875);
        SetPlayerFacingAngle(playerid, 180.555679);
        SetPlayerVirtualWorld(playerid, 0);
        SetPlayerInterior(playerid, 0);
        PlayAudioStreamForPlayer(playerid, "http://l.top4top.io/m_3802qjt4w1.mp3");
        SetPlayerCheckpoint(playerid, 1481.696777, -1769.906127, 18.795755, 3.0);

        SetCameraBehindPlayer(playerid);
        StopAudioStreamForPlayer(playerid);
        TogglePlayerControllable(playerid, 1);
        CancelSelectTextDraw(playerid);
        ClearChat(playerid);

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer),
            "UPDATE users SET setup = 0, gender = %d, age = %d, skin = %d, hours = %d, cash = 800, bank = 100 WHERE uid = %d",
            pData[playerid][pGender], pData[playerid][pAge], pData[playerid][pSkin],
            pData[playerid][pHours], pData[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);

        pData[playerid][pCash] = 800;
        pData[playerid][pBank] = 100;

        SetTimerEx("UnfreezePlayerEx", 3000, false, "i", playerid);

        SMA(SERVER_COLOR1, "[Fastlife Spawn]: Merhba Bek M3ana F Mdinat Fastlife RolePlay %s(%d) !", GetRPName(playerid), playerid);
        SCM(playerid, SERVER_COLOR1, "Sir l City Hall bach tkhrej la Carte.");
        }
    return 1;
}

SampVoice(playerid)
{
    new msg[256];
    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));
    if (SvGetVersion(playerid) == SV_NULL)
    {
        SendClientMessage(playerid, -1, "Could not find plugin sampvoice.");
        format(msg, sizeof(msg), "Welcome to FastLife City RolePlay, "WHITE"%s", name);
        SendClientMessage(playerid, SERVER_COLOR1, msg);

        SendClientMessage(playerid, 0xff0000AA, "[VOICE]{FFFFFF} Press B to use voice chat");
        SendClientMessage(playerid, 0xff0000AA, "[DB]{FFFFFF} Connecting to database...");
    }
    else if (SvHasMicro(playerid) == SV_FALSE)
    {
        SendClientMessage(playerid, -1, "The microphone could not be found.");
        format(msg, sizeof(msg), "Welcome to FastLife City RolePlay, "WHITE"%s", name);
        SendClientMessage(playerid, SERVER_COLOR1, msg);

        SendClientMessage(playerid, 0xff0000AA, "[VOICE]{FFFFFF} Press B to use voice chat");
        SendClientMessage(playerid, 0xff0000AA, "[DB]{FFFFFF} Connecting to database...");
    }
    else if((lstream[playerid] = SvCreateDLStreamAtPlayer(12.0, SV_INFINITY, playerid, 0xff0000ff, "L")))
    {
        format(msg, sizeof(msg), "Welcome to FastLife City RolePlay, "WHITE"%s", name);
        SendClientMessage(playerid, SERVER_COLOR1, msg);

        SendClientMessage(playerid, 0xff0000AA, "[VOICE]{FFFFFF} Press B to use voice chat");
        SendClientMessage(playerid, 0xff0000AA, "[DB]{FFFFFF} Connecting to database...");
        SvAddKey(playerid, 0x42);
    }
}
