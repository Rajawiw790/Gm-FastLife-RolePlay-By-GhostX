        format(query, sizeof(query), "```%s has set %s Spin Card to %s.```", GetRPName(playerid), value, GetRPName(targetid));
        DCC_SendChannelMessage(setstat, query);

	    mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET spincard = %i WHERE uid = %i", value, pData[targetid][pID]);
