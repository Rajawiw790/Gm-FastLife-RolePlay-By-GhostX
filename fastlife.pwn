			return SCM(playerid, COLOR_GREY, "Usage: /setstat [playerid] [carspincard] [value]");
        }

		pData[targetid][pCarSpinCard] += value;
	    SM(playerid, COLOR_WHITE, "** You have set %s's Car Spin Card to %i.", GetRPName(targetid), value);
        format(query, sizeof(query), "```%s has set %s Car Spin Card to %s.```", GetRPName(playerid), value, GetRPName(targetid));
