stock UpdateTopPlayers()
{
    mysql_tquery(connectionID, "SELECT username, level FROM users ORDER BY hours DESC LIMIT 3", "OnTopPlayersLoaded");
    return 1;
}

forward OnTopPlayersLoaded();
public OnTopPlayersLoaded()
{
    new rows = cache_num_rows();

    for(new i = 0; i < rows && i < MAX_TOP_PLAYERS; i++)
    {
        cache_get_field_content(i, "username", TopPlayerName[i], MAX_PLAYER_NAME);
        TopPlayerHours[i] = cache_get_field_content_int(i, "level");

        if(IsValidDynamicActor(TopActors[i]))
            DestroyDynamicActor(TopActors[i]);

        if(IsValidDynamic3DTextLabel(TopActorText[i]))
            DestroyDynamic3DTextLabel(TopActorText[i]);

        TopActors[i] = CreateDynamicActor(GetPlayerSkinFromName(TopPlayerName[i]),
            TopActorPos[i][0], TopActorPos[i][1], TopActorPos[i][2], TopActorPos[i][3],
            .worldid = 0,
            .interiorid = 0,
            .streamdistance = 200.0);


        ApplyDynamicActorAnimation(TopActors[i], "PED", "IDLE_CHAT", 4.1, 1, 1, 1, 1, 1);
        SetDynamicActorInvulnerable(TopActors[i], true);


        new text[256];
        new medal[12];

        switch(i)
        {
            case 0: medal = "{FFD700}";
            case 1: medal = "{C0C0C0}";
            case 2: medal = "{CD7F32}";
        }

        format(text, sizeof(text),
            "%s TOP %d\n{FFFFFF}Name: {00FF00}%s\n{FFFFFF}level: {FF0000}%d",
            medal, i + 1, TopPlayerName[i], TopPlayerHours[i]);


        TopActorText[i] = CreateDynamic3DTextLabel(text, 0xFFFFFFFF,
            TopActorPos[i][0], TopActorPos[i][1], TopActorPos[i][2] + 0.8, 15.0,
            .worldid = 0, .interiorid = 0);
    }
    return 1;
}

stock GetPlayerSkinFromName(const name[])
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
        {
            new pname[MAX_PLAYER_NAME];
            GetPlayerName(i, pname, MAX_PLAYER_NAME);
            if(strcmp(pname, name, true) == 0)
                return GetPlayerSkin(i);
        }
    }
    return 79;
}

CMD:updatetop(playerid, params[])
{
    if(pData[playerid][pAdmin] < 1)
        return SCM(playerid, COLOR_RED, "Admin only!");

    UpdateTopPlayers();
    SCM(playerid, COLOR_GREEN, "Top 3 players (by level) updated!");
    return 1;
}

CMD:top1(playerid, params[])
{
    mysql_tquery(connectionID, "SELECT username, hours FROM users ORDER BY level DESC LIMIT 10", "OnShowTopPlayers", "i", playerid);
    return 1;
}

forward OnShowTopPlayers(playerid);
public OnShowTopPlayers(playerid)
{
    new rows = cache_num_rows();
    if(!rows) return SCM(playerid, COLOR_RED, "No players found!");

    SCM(playerid, COLOR_YELLOW, "========== Top Players (by level) ==========");
    for(new i = 0; i < rows; i++)
    {
        new name[MAX_PLAYER_NAME], hours;
        cache_get_field_content(i, "username", name, MAX_PLAYER_NAME);
        hours = cache_get_field_content_int(i, "level");

        new msg[128];
        format(msg, sizeof(msg), "%d. %s - level: %d", i + 1, name, hours);
        SCM(playerid, COLOR_WHITE, msg);
    }
    SCM(playerid, COLOR_YELLOW, "=============================================");
    return 1;
}

//INV BY GHOST
stock InventorySwapSlots(playerid, a, b)
{
	new tmpExists = InventoryData[playerid][a][invExists];
	new tmpModel = InventoryData[playerid][a][invModel];
	new tmpAmount = InventoryData[playerid][a][invAmount];
	new tmpTotal = InventoryData[playerid][a][invTotalQuantity];
	new tmpName[32 char];
	for(new j = 0; j < 32; j++) tmpName[j] = InventoryData[playerid][a][invItem][j];

	InventoryData[playerid][a][invExists] = InventoryData[playerid][b][invExists];
	InventoryData[playerid][a][invModel] = InventoryData[playerid][b][invModel];
	InventoryData[playerid][a][invAmount] = InventoryData[playerid][b][invAmount];
	InventoryData[playerid][a][invTotalQuantity] = InventoryData[playerid][b][invTotalQuantity];
	for(new j = 0; j < 32; j++) InventoryData[playerid][a][invItem][j] = InventoryData[playerid][b][invItem][j];

	InventoryData[playerid][b][invExists] = tmpExists;
	InventoryData[playerid][b][invModel] = tmpModel;
	InventoryData[playerid][b][invAmount] = tmpAmount;
	InventoryData[playerid][b][invTotalQuantity] = tmpTotal;
	for(new j = 0; j < 32; j++) InventoryData[playerid][b][invItem][j] = tmpName[j];
	return 1;
}

stock Inventory_TakeSlot(playerid, slot, value)
{
	if (slot < 0 || slot >= MAX_INVENTORY || !InventoryData[playerid][slot][invExists]) return 0;

	new name[32], unit = -1;
	strunpack(name, InventoryData[playerid][slot][invItem]);
	for (new i = 0; i < sizeof(g_aInventoryItems); i++) if (!strcmp(g_aInventoryItems[i][e_InventoryItem], name, true))
	{
		unit = g_aInventoryItems[i][e_InventoryTotal];
		break;
	}

	InventoryData[playerid][slot][invAmount] -= value;
	if (unit != -1) InventoryData[playerid][slot][invTotalQuantity] -= unit * value;

	if (InventoryData[playerid][slot][invAmount] <= 0)
	{
		InventoryData[playerid][slot][invExists] = false;
		InventoryData[playerid][slot][invModel] = 0;
		InventoryData[playerid][slot][invAmount] = 0;
		InventoryData[playerid][slot][invTotalQuantity] = 0;
	}
	return 1;
}

stock Inventory_Clear(playerid)
{
	static
	    string[64];

	for(new i = 0; i < MAX_INVENTORY; i++)
	{
	    if (InventoryData[playerid][i][invExists])
	    {
	        InventoryData[playerid][i][invExists] = 0;
	        InventoryData[playerid][i][invModel] = 0;
			InventoryData[playerid][i][invAmount] = 0;
		}
	}
	return 1;
}

stock Inventory_GetItemID(playerid, item[])
{
	for(new i = 0; i < MAX_INVENTORY; i++)
	{
	    if (!InventoryData[playerid][i][invExists])
	        continue;

		new slotName[32];
		strunpack(slotName, InventoryData[playerid][i][invItem]);
		if (!strcmp(slotName, item)) return i;
	}
	return -1;
}

stock Inventory_GetFreeID(playerid)
{
	if (Inventory_Items(playerid) >= 20)
		return -1;

	for(new i = 0; i < MAX_INVENTORY; i++)
	{
	    if (!InventoryData[playerid][i][invExists])
	        return i;
	}
	return -1;
}

stock Inventory_Items(playerid)
{
    new count;

    for(new i = 0; i < MAX_INVENTORY; i++) if (InventoryData[playerid][i][invExists]) {
        count++;
	}
	return count;
}
stock Inventory_Count(playerid, item[])
{
	new itemid = Inventory_GetItemID(playerid, item);

	if (itemid != -1)
	    return InventoryData[playerid][itemid][invAmount];

	return 0;
}

stock PlayerHasItem(playerid, item[])
{
	return (Inventory_GetItemID(playerid, item) != -1);
}

stock Inventory_Set(playerid, item[], model, amount, totalquantity)
{
	new itemid = Inventory_GetItemID(playerid, item);

	if (itemid == -1 && amount > 0)
		Inventory_Addset(playerid, item, model, amount, totalquantity);

	else if (amount > 0 && itemid != -1)
	    Inventory_SetQuantity(playerid, item, amount, totalquantity);

	else if (amount < 1 && itemid != -1)
	    Inventory_Remove(playerid, item, -1);

	return 1;
}

stock Inventory_SetQuantity(playerid, item[], quantity, totalquantity)
{
	new
	    itemid = Inventory_GetItemID(playerid, item);

	if (itemid != -1)
	{
	    InventoryData[playerid][itemid][invAmount] = quantity;
	    InventoryData[playerid][itemid][invTotalQuantity] = totalquantity;
	}
	return 1;
}

stock Inventory_Remove(playerid, item[], quantity = 1)
{
	new
		itemid = Inventory_GetItemID(playerid, item);

	if (itemid != -1)
	{
	    for (new i = 0; i < sizeof(g_aInventoryItems); i ++) if (!strcmp(g_aInventoryItems[i][e_InventoryItem], item, true))
		{
		    new totalquantity = g_aInventoryItems[i][e_InventoryTotal];
		    if (InventoryData[playerid][itemid][invAmount] > 0 && InventoryData[playerid][itemid][invTotalQuantity] > 0)
		    {
		        InventoryData[playerid][itemid][invAmount] -= quantity;
		        InventoryData[playerid][itemid][invTotalQuantity] -= totalquantity;
			}
			if (quantity == -1 || InventoryData[playerid][itemid][invTotalQuantity] < 1 || totalquantity == -1 || InventoryData[playerid][itemid][invAmount] < 1)
			{
			    InventoryData[playerid][itemid][invExists] = false;
			    InventoryData[playerid][itemid][invModel] = 0;
			    InventoryData[playerid][itemid][invAmount] = 0;
			    InventoryData[playerid][itemid][invTotalQuantity] = 0;
			}
			else if (quantity != -1 && InventoryData[playerid][itemid][invAmount] > 0 && totalquantity != -1 && InventoryData[playerid][itemid][invTotalQuantity] > 0)
			{
			    InventoryData[playerid][itemid][invAmount] = quantity;
			    InventoryData[playerid][itemid][invTotalQuantity] = totalquantity;
			}
		}
		return 1;
	}
	return 0;
}
stock Inventory_Addset(playerid, item[], model, amount = 1, totalquantity)
{
	new itemid = Inventory_GetItemID(playerid, item);
	if (itemid == -1)
	{
	    itemid = Inventory_GetFreeID(playerid);
	    if (itemid != -1)
	    {
	   		InventoryData[playerid][itemid][invExists] = true;
		    InventoryData[playerid][itemid][invModel] = model;
			InventoryData[playerid][itemid][invAmount] = amount;
			InventoryData[playerid][itemid][invTotalQuantity] = totalquantity;

		    strpack(InventoryData[playerid][itemid][invItem], item, 32 char);
		    return itemid;
		}
		return -1;
	}
	else
	{
		InventoryData[playerid][itemid][invAmount] += amount;
		InventoryData[playerid][itemid][invTotalQuantity] += totalquantity;
	}
	return itemid;
}

stock Inventory_Add(playerid, item[], model, quantity = 1)
{
	new
		itemid = Inventory_GetItemID(playerid, item);

	if (itemid != -1)
	{
	    InventoryData[playerid][itemid][invAmount] += quantity;
	    return itemid;
	}
	if (itemid == -1)
	{
	    itemid = Inventory_GetFreeID(playerid);

	    if (itemid != -1)
	    {
         	for (new i = 0; i < sizeof(g_aInventoryItems); i ++) if (!strcmp(g_aInventoryItems[i][e_InventoryItem], item, true))
			{
			    new totalquantity = g_aInventoryItems[i][e_InventoryTotal];
     	 	  	InventoryData[playerid][itemid][invExists] = true;
		        InventoryData[playerid][itemid][invModel] = model;
				InventoryData[playerid][itemid][invAmount] = quantity;
				InventoryData[playerid][itemid][invTotalQuantity] = totalquantity;
		        return itemid;
			}
		}
		return -1;
	}
	return itemid;
}

stock Inventory_Close(playerid)
{
	if(BukaInven[playerid] == 0)
		return SCM(playerid, -1, "Kamu Belum Membuka Inventory.");

	CancelSelectTextDraw(playerid);
	pData[playerid][pSelectItem] = -1;
	pData[playerid][pGiveAmount] = 0;
	gInvSwapFirst[playerid] = 0;
	BukaInven[playerid] = 0;
	for(new a = 0; a < 18; a++)
	{
		PlayerTextDrawHide(playerid, INVINFO[playerid][a]);
	}
	for(new a = 0; a < 9; a++)
	{
		PlayerTextDrawHide(playerid, INV_LOGO[playerid][a]);
	}
	for(new a = 0; a < 4; a++)
	{
		PlayerTextDrawHide(playerid, INVNAME[playerid][a]);
	}
	for(new i = 0; i < MAX_INVENTORY; i++)
	{
		PlayerTextDrawHide(playerid, NAMETD[playerid][i]);
		PlayerTextDrawHide(playerid, INDEXTD[playerid][i]);
		PlayerTextDrawColor(playerid, INDEXTD[playerid][i], 960053503);
		PlayerTextDrawHide(playerid, MODELTD[playerid][i]);
		PlayerTextDrawHide(playerid, AMOUNTTD[playerid][i]);
		PlayerTextDrawHide(playerid, GARISBAWAH[playerid][i]);
	}
	return 1;
}

stock Inventory_Show(playerid)
{
	if(!IsPlayerConnected(playerid))
		return 0;

	new str[256], string[256];
	format(str,1000,"%s", GetRPName(playerid));
	PlayerTextDrawSetString(playerid, INVNAME[playerid][2], str);
	BarangMasuk(playerid);
	BukaInven[playerid] = 1;
	PlayerPlaySound(playerid, 1039, 0,0,0);
	SelectTextDraw(playerid, COLOR_BLUE);
	for(new a = 0; a < 18; a++)
	{
		PlayerTextDrawShow(playerid, INVINFO[playerid][a]);
	}
	for(new a = 0; a < 9; a++)
	{
		PlayerTextDrawShow(playerid, INV_LOGO[playerid][a]);
	}
	for(new a = 0; a < 4; a++)
	{
		PlayerTextDrawShow(playerid, INVNAME[playerid][a]);
	}
	for(new i = 0; i < MAX_INVENTORY; i++)
	{
		PlayerTextDrawShow(playerid, INDEXTD[playerid][i]);
		PlayerTextDrawShow(playerid, AMOUNTTD[playerid][i]);
		if(InventoryData[playerid][i][invExists])
		{
			PlayerTextDrawShow(playerid, NAMETD[playerid][i]);
			PlayerTextDrawShow(playerid, GARISBAWAH[playerid][i]);
			PlayerTextDrawSetPreviewModel(playerid, MODELTD[playerid][i], InventoryData[playerid][i][invModel]);

			//sesuakian dengan object item kalian
			if(InventoryData[playerid][i][invModel] == 18867)
			{
				PlayerTextDrawSetPreviewRot(playerid, MODELTD[playerid][i], -254.000000, 0.000000, 0.000000, 2.779998);
			}
			else if(InventoryData[playerid][i][invModel] == 2958)
			{
                //PlayerTextDrawSetPreviewRot(playerid, NOTIFBOX[playerid][0], 0.000000, 0.000000, -85.000000, 2.029999);
			}
			else if(InventoryData[playerid][i][invModel] == 2703)
			{
				PlayerTextDrawSetPreviewRot(playerid, MODELTD[playerid][i], -80.000000, 0.000000, -12.000000, 2.779998);
			}
			PlayerTextDrawShow(playerid, MODELTD[playerid][i]);
			strunpack(string, InventoryData[playerid][i][invItem]);
			format(str, sizeof(str), "%s", string);
			PlayerTextDrawSetString(playerid, NAMETD[playerid][i], str);
			format(str, sizeof(str), "%d", InventoryData[playerid][i][invAmount]);
			PlayerTextDrawSetString(playerid, AMOUNTTD[playerid][i], str);
		}
		else
		{
			PlayerTextDrawHide(playerid, AMOUNTTD[playerid][i]);
		}
	}
	return 1;
}

forward OnPlayerUseItem(playerid, itemid, name[], value);
public OnPlayerUseItem(playerid, itemid, name[], value)
{
	if(!strcmp(name, "Money"))
	{
	    SCMf(playerid, -1, "MONEY  %i", pData[playerid][pCash]);
	    Inventory_Update(playerid);
	    Inventory_Close(playerid);
	}
	else if(!strcmp(name, "Red Money"))
	{
	    SCM(playerid, COLOR_SYNTAX, "MAT9EDCH TESTA3MEL HAD ITEM");
	}
	else if(!strcmp(name, "Phone"))
	{
    	Inventory_Close(playerid);
    	callcmd::phone(playerid, "\1");
	}
	else if(!strcmp(name, "GPS"))
	{
	    ShowDialogToPlayer(playerid, DIALOG_LOCATE);
	    //ShowItemBox(playerid, "GPS", "USE", 18874, 3);
	    Inventory_Update(playerid);
	    Inventory_Close(playerid);
	}
	else if(!strcmp(name, "GASCAN"))
	{
        new vehicleid = GetPlayerVehicleID(playerid);

        if(!vehicleid || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        {
		    return SCM(playerid, COLOR_SYNTAX, "You are not driving any vehicle of yours.");
		}
		if(!IsVehicleOwner(playerid, vehicleid) && pData[playerid][pVehicleKeys] != vehicleid)
		{
		    return SCM(playerid, COLOR_SYNTAX, "You can't refuel this vehicle as it doesn't belong to you.");
		}

        PlayerPlaySound(playerid, 36401, 0.0, 0.0, 0.0);
        ApplyAnimationEx(playerid, "BD_FIRE", "wash_up", 4.1, 0, 0, 0, 0, 0);

        pData[playerid][pGasCan] -= 1;
        vehicleFuel[vehicleid] += 20;

        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET gascan = %i WHERE uid = %i", pData[playerid][pGasCan], pData[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);

	    //ShowItemBox(playerid, "GASCAN", "USE", 1650, 3);
	    Inventory_Update(playerid);
	    Inventory_Close(playerid);
	}
	else if(!strcmp(name, "Radio"))
	{
		Inventory_Close(playerid);
		callcmd::setfreq(playerid, "\1");
	}
	else if(!strcmp(name, "Food"))
	{
		callcmd::eat(playerid, "\1");
		Inventory_Close(playerid);
	}
	else if(!strcmp(name, "Drink"))
	{
	    callcmd::drink(playerid, "\1");
		Inventory_Close(playerid);
	}
	else if(!strcmp(name, "Bandage"))
	{
	    callcmd::use(playerid, "medkit");
		Inventory_Close(playerid);
	}
	else if(!strcmp(name, "RepairKit"))
	{
	    callcmd::use(playerid, "repairkit");
		Inventory_Close(playerid);
	}
	else if(!strcmp(name, "Mask"))
	{
	    callcmd::mask(playerid, "\1");
		Inventory_Close(playerid);
	}
    return 1;
}

stock BarangMasuk(playerid)
{
	    Inventory_Set(playerid, "Money", 1212, pData[playerid][pCash], pData[playerid][pCash]);
	    Inventory_Set(playerid, "LOCKPICK", 11746, pData[playerid][pLockpick], pData[playerid][pLockpick]);
	    Inventory_Set(playerid, "Red Money", 1580, pData[playerid][pDirtyCash], pData[playerid][pDirtyCash]);
	    Inventory_Set(playerid, "Phone", 18870, pData[playerid][pPhone], pData[playerid][pPhone]);
	    Inventory_Set(playerid, "Radio", 330, pData[playerid][pWalkieTalkie], pData[playerid][pWalkieTalkie]);
    	Inventory_Set(playerid, "Mask", 18914, pData[playerid][pMask], pData[playerid][pMask]);
	    Inventory_Set(playerid, "Food", 11740, pData[playerid][pFood], pData[playerid][pFood]);
	    Inventory_Set(playerid, "GPS", 18874, pData[playerid][pGPS], pData[playerid][pGPS]);
	    Inventory_Set(playerid, "Drink", 2647, pData[playerid][pDrink], pData[playerid][pDrink]);
	    Inventory_Set(playerid, "Crack", 1575, pData[playerid][pCrack], pData[playerid][pCrack]);
	    Inventory_Update(playerid);
}

stock Inventory_Update(playerid)
{
	new str[256], string[256];
	for(new i = 0; i < MAX_INVENTORY; i++)
	{
		if(InventoryData[playerid][i][invExists])
		{
			//sesuakian dengan object item kalian
			strunpack(string, InventoryData[playerid][i][invItem]);
			format(str, sizeof(str), "%s", string);
			PlayerTextDrawSetString(playerid, NAMETD[playerid][i], str);
			format(str, sizeof(str), "%d", InventoryData[playerid][i][invAmount]);
			PlayerTextDrawSetString(playerid, AMOUNTTD[playerid][i], str);
		}
		else
		{
			PlayerTextDrawHide(playerid, AMOUNTTD[playerid][i]);
			PlayerTextDrawHide(playerid, MODELTD[playerid][i]);
			PlayerTextDrawHide(playerid, NAMETD[playerid][i]);
		}
	}
}

stock MenuStore_SelectRow(playerid, row)
{
	pData[playerid][pSelectItem] = row;
    PlayerTextDrawHide(playerid,INDEXTD[playerid][row]);
	PlayerTextDrawColor(playerid, INDEXTD[playerid][row], COLOR_BLUE);
	PlayerTextDrawShow(playerid,INDEXTD[playerid][row]);
}

stock MenuStore_UnselectRow(playerid)
{
	if(pData[playerid][pSelectItem] != -1)
	{
		new row = pData[playerid][pSelectItem];
		PlayerTextDrawHide(playerid,INDEXTD[playerid][row]);
		PlayerTextDrawColor(playerid, INDEXTD[playerid][row], 960053503);
		PlayerTextDrawShow(playerid,INDEXTD[playerid][row]);
	}

	pData[playerid][pSelectItem] = -1;
}

forward OnPlayerGiveInvItem(playerid, userid, itemid, name[], value);
public OnPlayerGiveInvItem(playerid, userid, itemid, name[], value)
{
    new string[64];
    new str[64];

	if(value < 1 || Inventory_Count(playerid, name) < value)
		return SCM(playerid, COLOR_SYNTAX, "Error: ma3andekch ged hadchi li baghi t givih !");

	if(!strcmp(name, "Money", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Money", str, 1212, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(userid, "Money", str, 1212, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pCash] -= value;
		pData[userid][pCash] += value;
	}
	else if(!strcmp(name, "Red Money", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Red Money", str, 1580, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(userid, "Red Money", str, 1580, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pDirtyCash] -= value;
		pData[userid][pDirtyCash] += value;
	}
	else if(!strcmp(name, "lockpick", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "lockpick", str, 2703, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "lockpick", str, 2703, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pLockpick] -= value;
		pData[userid][pLockpick] += value;
	}
    else if(!strcmp(name, "GPS", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "GPS", str, 18874, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "GPS", str, 18874, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pGPS] -= value;
		pData[userid][pGPS] += value;
	}
	else if(!strcmp(name, "GASCAN", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "GASCAN", str, 1650, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "GASCAN", str, 1650, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pGasCan] -= value;
		pData[userid][pGasCan] += value;
	}
	else if(!strcmp(name, "Food", true))
    {
        format(str, sizeof(str), "Removed_%dx", value);
        ShowItemBox(playerid, "Food", str, 11740, 2);

        format(str, sizeof(str), "Received_%dx", value);
        ShowItemBox(userid, "Food", str, 11740, 2);

        ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
        ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pFood] -= value;
        pData[userid][pFood] += value;
    }
    else if(!strcmp(name, "Drink", true))
    {
        format(str, sizeof(str), "Removed_%dx", value);
        ShowItemBox(playerid, "Drink", str, 2647, 2);

        format(str, sizeof(str), "Received_%dx", value);
        ShowItemBox(userid, "Drink", str, 2647, 2);

        ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
        ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pDrink] -= value;
        pData[userid][pDrink] += value;
    }
    else if(!strcmp(name, "Phone", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Phone", str, 18870, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Phone", str, 18870, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pPhone] -= value;
		pData[userid][pPhone] += value;
	}
	else if(!strcmp(name, "Mask", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Mask", str, 18914, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Mask", str, 18914, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pMask] -= value;
		pData[userid][pMask] += value;
	}
	else if(!strcmp(name, "Medkit", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Medkit", str, 11748, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Medkit", str, 11748, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pMedkit] -= value;
		pData[userid][pMedkit] += value;
	}
	else if(!strcmp(name, "Crack", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Crack", str, 11748, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Crack", str, 11748, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pCrack] -= value;
		pData[userid][pCrack] += value;
	}
	else if(!strcmp(name, "Diamond", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Diamond", str, 11748, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Diamond", str, 11748, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pDiamonds] -= value;
		pData[userid][pDiamonds] += value;
	}
	else if(!strcmp(name, "Repair Kit", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Repair Kit", str, 920, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Repair Kit", str, 920, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pRepairKit] -= value;
		pData[userid][pRepairKit] += value;
	}
	else if(!strcmp(name, "Radio Mst", true))
	{
		format(str, sizeof(str), "Removed_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Radio Mst", str, 18874, 2);

		format(str, sizeof(str), "Received_%dx", pData[playerid][pGiveAmount]);
		ShowItemBox(playerid, "Radio Mst", str, 18874, 2);

		ApplyAnimation(playerid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);
		ApplyAnimation(userid, "DEALER", "shop_pay", 4, 0, 0, 0, 0, 0, 1);

        pData[playerid][pWalkieTalkie] -= value;
		pData[userid][pWalkieTalkie] += value;
	}
	// Inventory transfer (generic, for every item)
	{
		new giverSlot = Inventory_GetItemID(playerid, name);
		if(giverSlot == -1) return Inventory_Close(playerid);
		new model = InventoryData[playerid][giverSlot][invModel];
		new unit = 1;
		for(new i = 0; i < sizeof(g_aInventoryItems); i++) if(!strcmp(g_aInventoryItems[i][e_InventoryItem], name, true))
		{
			unit = g_aInventoryItems[i][e_InventoryTotal];
			break;
		}
		if(Inventory_GetItemID(userid, name) == -1 && Inventory_GetFreeID(userid) == -1)
			return SCM(playerid, COLOR_SYNTAX, "[Inventory] Had lplayer ma3andouch blasa khawiya!");

		InventoryData[playerid][giverSlot][invAmount] -= value;
		if(unit != -1) InventoryData[playerid][giverSlot][invTotalQuantity] -= unit * value;
		if(InventoryData[playerid][giverSlot][invAmount] <= 0)
		{
			InventoryData[playerid][giverSlot][invExists] = false;
			InventoryData[playerid][giverSlot][invModel] = 0;
			InventoryData[playerid][giverSlot][invAmount] = 0;
			InventoryData[playerid][giverSlot][invTotalQuantity] = 0;
		}
		Inventory_Addset(userid, name, model, value, (unit == -1) ? -1 : unit * value);
	}
	BarangMasuk(playerid);
	BarangMasuk(userid);
	return Inventory_Close(playerid);
}

forward Animmtion(playerid);
public Animmtion(playerid)
{
    new item = random(5);
    new str[128];

    if(item == 0)
    {
        SCM(playerid, COLOR_RED, "Not Found Items");
    }
    else if(item == 1)
    {
        format(str, sizeof(str), "Rob The end {e8f2ff}'Sd Pistol' {00ffe5}Added In Inventory.");
        GiveWeapon(playerid, 5);
        ShowItemBox(playerid, "SD PSTOLE", "+1", 347, 4);
        SendClientMessage(playerid, 0x00eeffAA, str);
    }
    else if(item == 2)
    {
        format(str, sizeof(str), "Rob The end {e8f2ff}'Deagle' {00ffe5}Added In Inventory.");
        GiveWeapon(playerid, 8);
        ShowItemBox(playerid, "DEAGLE", "+1", 348, 4);
        SendClientMessage(playerid, 0x00eeffAA, str);
    }
    else if(item == 3)
    {
        format(str, sizeof(str), "Rob The end {e8f2ff}lhdide {00ffe5}Removed In Inventory.");
        SendClientMessage(playerid, 0x00eeffAA, str);
    }
    else if(item == 4)
    {
        format(str, sizeof(str), "Rob The end {e8f2ff}Medkit {00ffe5}Added In Inventory.");
        pData[playerid][pMedkit] += 1;
        ShowItemBox(playerid, "Medkit", "+1", 11736, 4);
        SendClientMessage(playerid, 0x00eeffAA, str);
        mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET medkit = %i WHERE uid = %i", pData[playerid][pMedkit], pData[playerid][pID]);
        mysql_tquery(connectionID, queryBuffer);
    }

    TogglePlayerControllable(playerid, 1);
    return 1;
}

Button_Nearest(playerid)
{
    foreach(new i : Buttons)
    {
        if(IsPlayerInRangeOfPoint(playerid, 3.0, ButtonData[i][bPosX], ButtonData[i][bPosY], ButtonData[i][bPosZ]))
        {
            if(GetPlayerInterior(playerid) == ButtonData[i][bInterior] && GetPlayerVirtualWorld(playerid) == ButtonData[i][bWorld])
                return i;
        }
    }
    return -1;
}

Button_Save(id)
{
    new dquery[2048];
    mysql_format(connectionID, dquery, sizeof(dquery),
        "UPDATE `buttons` SET `doormodel`=%d, `faction`=%d, `family`=%d, `speed`='%f', \
        `bposx`='%f', `bposy`='%f', `bposz`='%f', `bposrx`='%f', `bposry`='%f', `bposrz`='%f', \
        `doorposx`='%f', `doorposy`='%f', `doorposz`='%f', `doorposrx`='%f', `doorposry`='%f', `doorposrz`='%f', \
        `dopenx`='%f', `dopeny`='%f', `dopenz`='%f', `dopenrx`='%f', `dopenry`='%f', `dopenrz`='%f', \
        `world`=%d, `interior`=%d WHERE `ID`=%d",
        ButtonData[id][bDoorModel], ButtonData[id][bFaction], ButtonData[id][bFamily], ButtonData[id][bSpeed],
        ButtonData[id][bPosX], ButtonData[id][bPosY], ButtonData[id][bPosZ],
        ButtonData[id][bPosRX], ButtonData[id][bPosRY], ButtonData[id][bPosRZ],
        ButtonData[id][bDoorPosX], ButtonData[id][bDoorPosY], ButtonData[id][bDoorPosZ],
        ButtonData[id][bDoorPosRX], ButtonData[id][bDoorPosRY], ButtonData[id][bDoorPosRZ],
        ButtonData[id][bDoorOpenX], ButtonData[id][bDoorOpenY], ButtonData[id][bDoorOpenZ],
        ButtonData[id][bDoorOpenRX], ButtonData[id][bDoorOpenRY], ButtonData[id][bDoorOpenRZ],
        ButtonData[id][bWorld], ButtonData[id][bInterior], id);
    mysql_pquery(connectionID, dquery);
    return 1;
}

// ============================================
// LOAD_BUTTONS � R39-6 Compatible
// ============================================
forward LoadButtons();
public LoadButtons()
{
    new rows = cache_num_rows();
    if(rows)
    {
        new id;
        for(new i; i < rows; i++)
        {
            id                              = cache_get_row_int(i, 0, connectionID);   // ID
            ButtonData[id][bDoorModel]      = cache_get_row_int(i, 1, connectionID);   // doormodel
            ButtonData[id][bFaction]        = cache_get_row_int(i, 2, connectionID);   // faction
            ButtonData[id][bFamily]         = cache_get_row_int(i, 3, connectionID);   // family
            ButtonData[id][bSpeed]          = cache_get_row_float(i, 4, connectionID); // speed
            ButtonData[id][bPosX]           = cache_get_row_float(i, 5, connectionID); // bposx
            ButtonData[id][bPosY]           = cache_get_row_float(i, 6, connectionID); // bposy
            ButtonData[id][bPosZ]           = cache_get_row_float(i, 7, connectionID); // bposz
            ButtonData[id][bPosRX]          = cache_get_row_float(i, 8, connectionID); // bposrx
            ButtonData[id][bPosRY]          = cache_get_row_float(i, 9, connectionID); // bposry
            ButtonData[id][bPosRZ]          = cache_get_row_float(i, 10, connectionID);// bposrz
            ButtonData[id][bDoorPosX]       = cache_get_row_float(i, 11, connectionID);// doorposx
            ButtonData[id][bDoorPosY]       = cache_get_row_float(i, 12, connectionID);// doorposy
            ButtonData[id][bDoorPosZ]       = cache_get_row_float(i, 13, connectionID);// doorposz
            ButtonData[id][bDoorPosRX]      = cache_get_row_float(i, 14, connectionID);// doorposrx
            ButtonData[id][bDoorPosRY]      = cache_get_row_float(i, 15, connectionID);// doorposry
            ButtonData[id][bDoorPosRZ]      = cache_get_row_float(i, 16, connectionID);// doorposrz
            ButtonData[id][bDoorOpenX]      = cache_get_row_float(i, 17, connectionID);// dopenx
            ButtonData[id][bDoorOpenY]      = cache_get_row_float(i, 18, connectionID);// dopeny
            ButtonData[id][bDoorOpenZ]      = cache_get_row_float(i, 19, connectionID);// dopenz
            ButtonData[id][bDoorOpenRX]     = cache_get_row_float(i, 20, connectionID);// dopenrx
            ButtonData[id][bDoorOpenRY]     = cache_get_row_float(i, 21, connectionID);// dopenry
            ButtonData[id][bDoorOpenRZ]     = cache_get_row_float(i, 22, connectionID);// dopenrz
            ButtonData[id][bWorld]          = cache_get_row_int(i, 23, connectionID);  // world
            ButtonData[id][bInterior]       = cache_get_row_int(i, 24, connectionID);  // interior

            if(DestroyDynamicObject(ButtonData[id][bDoorObject]))
                ButtonData[id][bDoorObject] = STREAMER_TAG_OBJECT: INVALID_STREAMER_ID;

            if(DestroyDynamicObject(ButtonData[id][bObject]))
                ButtonData[id][bObject] = STREAMER_TAG_OBJECT: INVALID_STREAMER_ID;

            ButtonData[id][bObject] = CreateDynamicObject(2886, ButtonData[id][bPosX], ButtonData[id][bPosY], ButtonData[id][bPosZ], ButtonData[id][bPosRX], ButtonData[id][bPosRY], ButtonData[id][bPosRZ], ButtonData[id][bWorld], ButtonData[id][bInterior], -1, 30.0, 30.0);
            ButtonData[id][bDoorObject] = CreateDynamicObject(ButtonData[id][bDoorModel], ButtonData[id][bDoorPosX], ButtonData[id][bDoorPosY], ButtonData[id][bDoorPosZ], ButtonData[id][bDoorPosRX], ButtonData[id][bDoorPosRY], ButtonData[id][bDoorPosRZ], ButtonData[id][bWorld], ButtonData[id][bInterior], -1, 100.0, 100.0);
            ButtonData[id][bDoorStatus] = 0;

            Iter_Add(Buttons, id);
        }
        printf("[Dynamic Buttons] Loaded: %d buttons.", rows);
    }
    return 1;
}

forward OnButtonCreated(playerid, id);
public OnButtonCreated(playerid, id)
{
    Button_Save(id);
    SendStaffMessage(0xFF0000FF, "AdmCmd: %s made button ID: %d.", pData[playerid][pAdminName], id);
    return 1;
}

