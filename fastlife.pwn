stock Dyuze(playerid, title[], string[], time = 5000)
{
    if(pData[playerid][pDyuze])
    {
        KillTimer(pData[playerid][pDyuzeTimer]);
    }
    pData[playerid][pDyuze] = true;
    pData[playerid][pDyuzeTimer] = SetTimerEx("HidetheDyuze", time, false, "d", playerid);
}

stock Notify(playerid, title[], string[], time = 5000)
{
    if(pData[playerid][pNotif])
    {
        PlayerTextDrawHide(playerid, NotifTD[playerid][0]);
        PlayerTextDrawHide(playerid, NotifTD[playerid][1]);
        KillTimer(pData[playerid][pNotifTimer]);
    }
    new string2[128];
    format(string2, sizeof(string2), "%s~n~_", title);
    PlayerTextDrawSetString(playerid, NotifTD[playerid][0], string2);
    PlayerTextDrawShow(playerid, NotifTD[playerid][0]);

    PlayerTextDrawSetString(playerid, NotifTD[playerid][1], string);
    PlayerTextDrawShow(playerid, NotifTD[playerid][1]);

    pData[playerid][pNotif] = true;
    pData[playerid][pNotifTimer] = SetTimerEx("HideNotify", time, false, "d", playerid);
}

stock Carl(playerid, time = 10000)
{
    if(pData[playerid][pCarl])
    {
        for(new i = 0; i < 21; i ++)
        {
            PlayerTextDrawHide(playerid, DLIC[playerid][i]);
        }
        KillTimer(pData[playerid][pCarlTimer]);
    }
    for(new i = 0; i < 21; i ++)
    {
        PlayerTextDrawShow(playerid, DLIC[playerid][i]);
    }

    pData[playerid][pCarl] = true;
    pData[playerid][pCarlTimer] = SetTimerEx("HideCarl", time, false, "d", playerid);
}

stock Weplic(playerid, time = 10000)
