forward BotStatus(playerid);
public BotStatus(playerid)
{
    new hours = 0, mins = 0, secs = 0;
    hours = floatround(uptime / 3600);
    mins = floatround((uptime / 60) - (hours * 60));
    secs = floatround(uptime - ((hours * 3600) + (mins * 60)));
    uptime++;
    new statuz[256];
    format(statuz,sizeof(statuz),"%d/1000 | GOLD  CITY %02dh %02dm %02ds",online,hours,mins, secs);
}

Float:GetDistanceBetweenCoords(Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2)
{
    return floatsqroot(floatpower(x1 - x2, 2.0) + floatpower(y1 - y2, 2.0) + floatpower(z1 - z2, 2.0));
}

AntiDeAMX()
{
