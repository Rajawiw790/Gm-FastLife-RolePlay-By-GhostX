    CMD:out(playerid, params[])
    {
        new vehicleid = GetPlayerVehicleID(playerid);

        if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
        {
            return SCM(playerid, COLOR_SYNTAX, "You are not driving any vehicle.");
        }
        if(!VehicleHasEngine(vehicleid))
        {
            return SCM(playerid, COLOR_SYNTAX, "This vehicle has no place to hide.");
        }

        GameTextForPlayer(playerid, "~g~outting...", 3000, 3);
        SetTimerEx("outcar", 5000, false, "i", playerid);
        return 1;
    }

